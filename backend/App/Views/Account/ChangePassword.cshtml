@using Core.DTOs
@model ChangePasswordDTO
@{
    ViewData["Title"] = "Зміна пароля";
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        :root {
            --bg-color: #141B25;
            --accent-color: #F0FFFF;
            --btn-color: #6B8789;
            --text-color: #DEE4C7;
        }

        body {
            background: linear-gradient(#141B25, #2C1335);
            margin: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: system-ui, sans-serif;
            color: var(--text-color);
            overflow: hidden;
        }

        .auth-card {
            background-color: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(240, 255, 255, 0.1);
            border-radius: 25px;
            padding: 40px;
            max-width: 400px;
            width: 90%;
            text-align: center;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            animation: fadeIn 0.6s ease-out;
        }

        h2 {
            color: var(--accent-color);
            margin-top: 0;
            margin-bottom: 25px;
            font-size: 1.8rem;
        }

        .form-group {
            text-align: left;
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.85rem;
            opacity: 0.7;
        }

        .input-azure {
            width: 100%;
            background: #141B25;
            border: 1px solid #818375;
            color: white;
            padding: 12px;
            border-radius: 10px;
            outline: none;
            box-sizing: border-box;
            transition: 0.3s;
            font-family: inherit;
        }

            .input-azure:focus {
                border-color: var(--accent-color);
            }

            .input-azure[readonly] {
                opacity: 0.5;
                cursor: not-allowed;
                border-style: dashed;
            }

        .btn-azure {
            width: 100%;
            background: var(--btn-color);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
            transition: 0.3s;
            font-size: 1rem;
        }

            .btn-azure:hover {
                background: var(--accent-color);
                color: #141B25;
                transform: translateY(-2px);
            }

        .text-danger {
            color: #ff8080;
            font-size: 0.8rem;
            margin-top: 5px;
            display: block;
        }

        .back-link {
            display: block;
            margin-top: 25px;
            color: var(--accent-color);
            text-decoration: none;
            font-size: 0.85rem;
            opacity: 0.6;
        }

            .back-link:hover {
                opacity: 1;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>

    <div class="auth-card">
        <h2>Новий пароль</h2>

        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Email">Електронна пошта</label>
                <input asp-for="Email" class="input-azure" readonly />
            </div>

            <div class="form-group">
                <label asp-for="NewPassword">Новий пароль</label>
                <input asp-for="NewPassword" type="password" class="input-azure" placeholder="••••••••" required />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Підтвердження пароля</label>
                <input asp-for="ConfirmPassword" type="password" class="input-azure" placeholder="••••••••" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-azure">Оновити пароль</button>
        </form>
        <a asp-controller="Account" asp-action="Login" class="back-link" style="display: block; margin-top: 25px; cursor: pointer;">
            ← Скасувати та повернутися
        </a>

</body>
</html>