@{
    Layout = "_Layout";
    ViewData["Title"] = "404 - Сторінку не знайдено";
}

<style>
    .error-outer {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        color: white;
        font-family: 'Arial Black', sans-serif;
    }

    .cards-container {
        display: flex;
        gap: 20px;
        margin-bottom: 40px;
    }

    .card-stripe {
        background-color: #f5f5f5; 
        width: 120px;
        height: 300px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 4px;
        box-shadow: 0 20px 0px -5px rgba(255,255,255,0.3);
        transition: transform 0.3s ease;
        cursor: default;
    }

        .card-stripe:hover {
            transform: translateY(-10px);
        }

    .card-number {
        font-size: 100px;
        color: #000;
        margin: 0;
        line-height: 1;
    }

    .error-msg {
        text-align: center;
        max-width: 500px;
    }

        .error-msg h2 {
            font-size: 1.5rem;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

    .btn-back {
        display: inline-block;
        margin-top: 20px;
        padding: 10px 30px;
        border: 2px solid white;
        color: white;
        text-decoration: none;
        font-weight: bold;
        transition: 0.3s;
    }

        .btn-back:hover {
            background: white;
            color: black;
        }

    @@media (max-width: 500px) {
        .card-stripe {
            width: 80px;
            height: 200px;
        }

        .card-number {
            font-size: 60px;
        }
    }
</style>

<div class="error-outer">
    <div class="cards-container">
        <div class="card-stripe">
            <h1 class="card-number">4</h1>
        </div>
        <div class="card-stripe">
            <h1 class="card-number">0</h1>
        </div>
        <div class="card-stripe">
            <h1 class="card-number">4</h1>
        </div>
    </div>

    <div class="error-msg">
        <h2>Сторінку не знайдено</h2>
        <p>Ця картка випала з колоди. Можливо, посилання застаріло або сторінку було видалено.</p>
        <a href="/" class="btn-back">НА ГОЛОВНУ</a>
    </div>
</div>