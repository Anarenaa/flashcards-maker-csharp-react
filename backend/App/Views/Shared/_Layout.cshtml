@using System.Security.Claims
@inject Services.UserService UserService

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Flashcards Maker</title>

    <script>
        const currentUserId = "@User.FindFirstValue(ClaimTypes.NameIdentifier)";

        function getCookie(name) {
            let value = "; " + document.cookie;
            let parts = value.split("; " + name + "=");
            if (parts.length === 2) return parts.pop().split(";").shift();
        }

        function applyTheme(bg, accent, btn) {
            if (!bg || !accent || !btn) return;
            const root = document.documentElement;

            root.style.setProperty('--bg-color', bg);
            root.style.setProperty('--accent-color', accent);
            root.style.setProperty('--btn-border', accent + '4D');
            root.style.setProperty('--btn-hover', btn);

            const lightBackgrounds = ["#FFFFFF", "#F8FAFC", "#F0F2F5", "#F5E8B7", "#EDE6D4"];
            const isLight = lightBackgrounds.includes(bg.toUpperCase());

            if (isLight) {
                root.style.setProperty('--text-color', '#1E293B');
                root.style.setProperty('--btn-text', '#1E293B');
            } else {
                root.style.setProperty('--text-color', '#DEE4C7');
                root.style.setProperty('--btn-text', '#DEE4C7');
            }

            if (currentUserId) {
                localStorage.setItem('UserTheme_' + currentUserId, `${bg}|${accent}|${btn}`);
            }
        }

        let themeData = null;
        if (currentUserId) {
            themeData = localStorage.getItem('UserTheme_' + currentUserId);
            if (!themeData) {
                const themeCookie = getCookie("UserTheme_" + currentUserId);
                if (themeCookie) themeData = decodeURIComponent(themeCookie);
            }
        }
        if (themeData) {
            const colors = themeData.split('|');
            if (colors.length === 3) {
                applyTheme(colors[0], colors[1], colors[2]);
            }
        }
    </script>

    <style>
        :root {
            --bg-color: #141B25;
            --text-color: #DEE4C7;
            --accent-color: #F0FFFF;
            --btn-bg: rgba(129, 131, 117, 0.1);
            --btn-border: rgba(129, 131, 117, 0.3);
            --btn-hover: rgba(107, 135, 137, 0.3);
            --btn-text: #DEE4C7;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background: var(--bg-color);
            margin: 0;
            color: var(--text-color);
            font-family: system-ui, sans-serif;
            display: flex;
            height: 100vh;
            overflow: hidden;
            transition: background 0.3s ease, color 0.3s ease;
        }

        /* --- SIDEBAR (Desktop) --- */
        aside {
            width: 280px;
            padding: 30px;
            display: flex;
            flex-direction: column;
            border-right: 2px solid rgba(240, 255, 255, 0.1);
            flex-shrink: 0;
            z-index: 20;
            background: var(--bg-color);
        }

        h1 {
            font-size: 1.5rem;
            margin: 0;
            text-shadow: 0 2px 10px rgba(0,0,0,0.5);
            color: var(--accent-color);
            text-align: center;
        }

        .line {
            width: 100%;
            height: 2px;
            background-color: var(--accent-color);
            margin-top: 15px;
            opacity: 0.5;
        }

        nav {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 30px;
            flex-grow: 1;
        }

        .nav-btn {
            background-color: var(--btn-bg);
            border: 1px solid var(--btn-border);
            color: var(--btn-text) !important;
            padding: 12px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 14px;
            transition: 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
        }

            .nav-btn:hover {
                background-color: var(--btn-hover);
                border-color: var(--accent-color);
                transform: translateX(5px);
            }

            .nav-btn.active {
                background-color: rgba(240, 255, 255, 0.15);
                border-color: var(--accent-color);
                color: var(--accent-color) !important;
                font-weight: 600;
            }

        .nav-avatar-mini {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border: 1.5px solid var(--accent-color);
            flex-shrink: 0;
        }

            .nav-avatar-mini img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .logout-form {
            margin-top: auto;
            width: 100%;
        }

        .btn-exit {
            border-color: rgba(255, 100, 100, 0.3);
            color: #ff8080 !important;
        }

            .btn-exit:hover {
                background-color: rgba(255, 100, 100, 0.1);
                border-color: #ff8080;
            }

        .content-area {
            flex-grow: 1;
            padding: 40px;
            overflow-y: auto;
        }

        /* --- ADAPTIVE (Tablet & Mobile) --- */
        @@media (max-width: 950px) {
            body {
                flex-direction: column;
                overflow-y: auto;
                height: auto;
            }

            aside {
                width: 100%;
                padding: 20px;
                border-right: none;
                border-bottom: 1px solid rgba(240, 255, 255, 0.1);
            }

            nav {
                display: grid;
                /* Робимо сітку: по 3 кнопки в ряд на планшетах, по 2 на малих телефонах */
                grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
                gap: 8px;
                margin-top: 20px;
            }

            .logout-form {
                margin-top: 0; /* Прибираємо відступ зверху, щоб стала в сітку */
                grid-column: span 1; /* Займає одну ячейку як і всі */
            }

            .nav-btn {
                height: 45px; /* Фіксована висота для гармонії */
            }

                .nav-btn:hover {
                    transform: translateY(-2px); /* На мобілках краще вгору, а не вбік */
                }

            .content-area {
                padding: 20px;
            }
        }

        @@media (max-width: 500px) {
            nav {
                grid-template-columns: 1fr 1fr; /* На зовсім малих екранах тільки по 2 в ряд */
            }
        }
    </style>
</head>
<body>
    <aside>
        <h1>Flashcards Maker</h1>
        <div class="line"></div>
        <nav>
            @{
                string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                bool isFromColl = Context.Request.Query.ContainsKey("collectionId");

                bool activeMain = (controller == "Main") || (controller == "DetailsInMain" && !isFromColl);
                bool activeMySets = (controller == "MySets") || (controller == "Details" && !isFromColl);
                bool activeColl = (controller == "Collections") || isFromColl;

                string userAvatar = null;
                if (User.Identity.IsAuthenticated)
                {
                    var userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
                    if (int.TryParse(userIdStr, out int uId))
                    {
                        var profile = await UserService.GetMyPrivateProfileAsync(uId);
                        userAvatar = profile?.AvatarUrl;
                    }
                }
            }

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Reports" class="nav-btn @(controller == "Admin" && action == "Reports" ? "active" : "")">Скарги</a>
                <a asp-controller="Admin" asp-action="Users" class="nav-btn @(controller == "Admin" && action == "Users" ? "active" : "")">Користувачі</a>
                <a asp-controller="Admin" asp-action="Categories" class="nav-btn @(action == "Categories" ? "active" : "")">Категорії</a>
                <a asp-controller="Admin" asp-action="Settings" class="nav-btn @(controller == "Admin" && action == "Settings" ? "active" : "")">Налаштування</a>
            }
            else
            {
                <a asp-controller="Main" asp-action="Index" class="nav-btn @(activeMain ? "active" : "")">Головна</a>
                <a asp-controller="MySets" asp-action="Index" class="nav-btn @(activeMySets ? "active" : "")">Мої сети</a>
                <a asp-controller="Collections" asp-action="Index" class="nav-btn @(activeColl ? "active" : "")">Колекції</a>

                <a asp-controller="MyProfile" asp-action="Index" class="nav-btn @(controller == "MyProfile" ? "active" : "")">
                    <div class="nav-avatar-mini">
                        @if (!string.IsNullOrEmpty(userAvatar))
                        {
                            <img src="@userAvatar" alt="Avatar" />
                        }
                        else
                        {
                            <span>👤</span>
                        }
                    </div>
                    Профіль
                </a>

                <a asp-controller="Settings" asp-action="Index" class="nav-btn @(controller == "Settings" ? "active" : "")">Налаштування</a>
            }

            <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                <button type="submit" class="nav-btn btn-exit" style="cursor: pointer;">Вийти</button>
            </form>
        </nav>
    </aside>

    <main class="content-area">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>