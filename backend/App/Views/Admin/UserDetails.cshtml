@model Core.DTOs.PublicUserDTO
@{
    ViewData["Title"] = "Перегляд профілю " + Model.UserName;
}

<style>
 
    .profile-page-view {
        max-width: 1000px;
        margin: 0 auto;
        animation: fadeIn 0.4s ease-out;
    }

    .back-nav {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--accent-color);
        text-decoration: none;
        font-size: 0.9rem;
        margin-bottom: 25px;
        opacity: 0.7;
        transition: 0.3s;
    }

        .back-nav:hover {
            opacity: 1;
            transform: translateX(-3px);
        }

    .user-profile-header {
        display: flex;
        align-items: center;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(240, 255, 255, 0.1);
        padding: 40px;
        border-radius: 24px;
        gap: 50px;
        margin-bottom: 30px;
    }

    .user-view-avatar {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 4px solid var(--accent-color);
        flex-shrink: 0;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

        .user-view-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .user-view-avatar svg {
            width: 90px;
            height: 90px;
            fill: #4b3d5b; 
        }


    .user-view-info {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .info-row {
        display: flex;
        align-items: center;
    }

    .info-label {
        font-size: 0.95rem;
        opacity: 0.5;
        width: 120px;
        flex-shrink: 0;
    }

    .info-value-main {
        font-size: 1.6rem;
        font-weight: 800;
        color: #fff;
    }

    .info-value-sub {
        font-size: 1.1rem;
        color: #fff;
        opacity: 0.9;
    }
    .user-stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 40px;
    }

    .user-stat-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(240, 255, 255, 0.1);
        padding: 35px 20px;
        border-radius: 20px;
        text-align: center;
        transition: 0.3s ease;
    }

        .user-stat-card:hover {
            border-color: var(--accent-color);
            transform: translateY(-5px);
            background: rgba(255, 255, 255, 0.05);
        }

    .stat-card-label {
        font-size: 0.9rem;
        opacity: 0.6;
        display: block;
        margin-bottom: 12px;
    }

    .stat-card-number {
        font-size: 2rem;
        font-weight: 800;
        color: var(--accent-color);
    }
    .wide-card {
        grid-column: span 2;
    }
    .user-sets-header {
        font-size: 1.4rem;
        color: var(--accent-color);
        margin-bottom: 25px;
        padding-left: 10px;
        border-left: 4px solid var(--accent-color);
    }

    .user-sets-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
    }

    .admin-set-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--btn-border);
        padding: 25px;
        border-radius: 18px;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 900px) {
        .user-profile-header {
            flex-direction: column;
            text-align: center;
            gap: 25px;
        }

        .user-stats-grid {
            grid-template-columns: 1fr 1fr;
        }

        .wide-card {
            grid-column: span 2;
        }

        .info-row {
            justify-content: center;
        }
    }
</style>

<div class="profile-page-view">

    <a asp-action="Users" class="back-nav">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg>
        Назад до керування
    </a>

    <div class="user-profile-header">
        <div class="user-view-avatar">
            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
            {
                <img src="@Model.AvatarUrl" alt="Avatar" />
            }
            else
            {
                <svg viewBox="0 0 24 24">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                </svg>
            }
        </div>

        <div class="user-view-info">
            <div class="info-row">
                <span class="info-label">Нікнейм:</span>
                <span class="info-value-main">@Model.UserName</span>
            </div>
            <div class="info-row">
                <span class="info-label">Email:</span>
                <span class="info-value-sub">@Model.Email</span>
            </div>
            <div class="info-row">
                <span class="info-label">Реєстрація:</span>
                <span class="info-value-sub" style="opacity: 0.6;">@Model.CreatedAt.ToString("dd.MM.yyyy")</span>
            </div>
        </div>
    </div>

    <div class="user-stats-grid">
        <div class="user-stat-card">
            <span class="stat-card-label">Кількість ваших сетів</span>
            <div class="stat-card-number">@Model.SetsCount</div>
        </div>
        <div class="user-stat-card">
            <span class="stat-card-label">Кількість ваших колекцій</span>
            <div class="stat-card-number">@Model.CollectionsCount</div>
        </div>
        <div class="user-stat-card">
            <span class="stat-card-label">Кількість ваших карток</span>
            <div class="stat-card-number">@Model.FlashcardsCount</div>
        </div>
        <div class="user-stat-card">
            <span class="stat-card-label">Кількість пройдених тестів</span>
            <div class="stat-card-number">0</div>
        </div>
        <div class="user-stat-card wide-card">
            <span class="stat-card-label">Вивчено карток</span>
            <div class="stat-card-number">0</div>
        </div>
    </div>

    @if (Model.Sets != null && Model.Sets.Any())
    {
        <h3 class="user-sets-header">Опубліковані навчальні сети</h3>
        <div class="user-sets-grid">
            @foreach (var set in Model.Sets)
            {
                <div class="admin-set-card">
                    <h4 style="margin: 0 0 10px 0; color: #fff;">@set.Name</h4>
                    <p style="font-size: 0.85rem; opacity: 0.6; line-height: 1.4; min-height: 40px;">@set.Description</p>
                    <div style="margin-top: 15px; font-size: 0.8rem; color: var(--accent-color); font-weight: 600;">
                        @set.FlashcardsCount КАРТОК
                    </div>
                </div>
            }
        </div>
    }
</div>