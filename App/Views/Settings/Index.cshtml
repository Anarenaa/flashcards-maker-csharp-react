@using Core.DTOs
@model UserEditDTO

@{
    ViewData["Title"] = "Налаштування";
}

<style>
    .settings-container {
        max-width: 1100px;
        margin-bottom: 50px;
    }

    /* Картки розділів */
    .settings-card {
        background-color: var(--btn-bg);
        border: 1px solid var(--btn-border);
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 25px;
    }

        .settings-card h3 {
            color: var(--accent-color);
            margin-top: 0;
            margin-bottom: 20px;
            font-size: 1.25rem;
            display: flex;
            align-items: center;
            gap: 12px;
        }

    /* Рядок налаштування */
    .setting-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

        .setting-row:last-child {
            border-bottom: none;
        }

    .setting-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .setting-info label {
            font-weight: 600;
            font-size: 1rem;
            color: #fff;
        }

        .setting-info p {
            margin: 0;
            font-size: 0.85rem;
            opacity: 0.5;
            color: #DEE4C7;
        }

    /* --- ПЕРЕМИКАЧ (SWITCH) --- */
    .switch {
        position: relative;
        display: inline-block;
        width: 46px;
        height: 24px;
        flex-shrink: 0;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #2C3440;
        transition: .4s;
        border-radius: 34px;
        border: 1px solid var(--btn-border);
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 16px;
            width: 16px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #6B8789;
        border-color: var(--accent-color);
    }

        input:checked + .slider:before {
            transform: translateX(22px);
        }

    /* --- СТИЛІ ТЕМ --- */
    .theme-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
        margin: 20px 0;
    }

    .theme-item {
        background: #1C2531;
        border: 2px solid var(--btn-border);
        border-radius: 12px;
        padding: 20px;
        cursor: pointer;
        transition: 0.3s;
        text-align: center;
    }

        .theme-item:hover {
            border-color: var(--accent-color);
            background: var(--btn-hover);
            transform: translateY(-3px);
        }

        .theme-item.active {
            border-color: var(--accent-color);
            background: rgba(240, 255, 255, 0.05);
        }

    .theme-preview {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-bottom: 12px;
    }

    .preview-circle {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.1);
    }

    /* Кастомний вибір кольору */
    .custom-colors-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 25px;
        border-top: 1px solid rgba(255,255,255,0.05);
        flex-wrap: wrap;
        gap: 20px;
    }

    .color-picker-group {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .color-input {
        -webkit-appearance: none;
        appearance: none;
        width: 35px;
        height: 35px;
        background-color: transparent;
        border: none;
        cursor: pointer;
    }

        .color-input::-webkit-color-swatch {
            border-radius: 8px;
            border: 2px solid var(--btn-border);
        }

    /* --- СТАНДАРТНА КНОПКА (ЯК У ВСІЙ ПРОГРАМІ) --- */
    .btn-main {
        background-color: var(--btn-bg);
        border: 1px solid var(--btn-border);
        color: var(--text-color);
        padding: 10px 25px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-main:hover {
            background-color: var(--btn-hover);
            border-color: var(--accent-color);
            color: white;
            transform: translateY(-2px);
        }

    /* --- НЕБЕЗПЕЧНА ЗОНА --- */
    .danger-card {
        border-color: rgba(255, 100, 100, 0.2);
    }

    .btn-danger-outline {
        background: transparent;
        border: 1px solid #ff8080;
        color: #ff8080;
        padding: 10px 22px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
    }

        .btn-danger-outline:hover {
            background: rgba(255, 128, 128, 0.1);
        }
</style>

<div class="content-area">
    <h2 style="color: var(--accent-color); margin-bottom: 30px;">Налаштування</h2>

    <div class="settings-container">

        <!-- РОЗДІЛ 1: ПРИВАТНІСТЬ ТА ІНТЕРФЕЙС -->
        <div class="settings-card">
            <h3>🔓 Приватність та інтерфейс</h3>

            <div class="setting-row">
                <div class="setting-info">
                    <label>Публічний профіль</label>
                    <p>Дозволити іншим бачити вашу статистику та успіхи</p>
                </div>
                <label class="switch">
                    <input type="checkbox" checked>
                    <span class="slider"></span>
                </label>
            </div>

            <div class="setting-row">
                <div class="setting-info">
                    <label>Анімація інтерфейсу</label>
                    <p>Плавні переходи та рухомі квадрати на фоні</p>
                </div>
                <label class="switch">
                    <input type="checkbox" checked>
                    <span class="slider"></span>
                </label>
            </div>

            <div class="setting-row">
                <div class="setting-info">
                    <label>Мотиваційні листи</label>
                    <p>Отримувати звіти після 5 вдалих/недалих відповідей у тестах</p>
                </div>
                <label class="switch">
                    <input type="checkbox">
                    <span class="slider"></span>
                </label>
            </div>

            <div class="setting-row">
                <div class="setting-info">
                    <label>Темна тема</label>
                    <p>Завжди увімкнено (Storm Edition)</p>
                </div>
                <label class="switch">
                    <input type="checkbox" checked disabled>
                    <span class="slider"></span>
                </label>
            </div>
        </div>

        <!-- РОЗДІЛ 2: КАСТОМІЗАЦІЯ ТЕМИ -->
        <div class="settings-card">
            <h3>🎨 Кастомізація теми</h3>

            <div class="setting-info">
                <label>Оберіть кольорову схему</label>
                <p>Швидкі пресети для зміни вигляду додатку</p>
            </div>

            <div class="theme-grid">
                <div class="theme-item active">
                    <div class="theme-preview">
                        <div class="preview-circle" style="background: #141B25;"></div>
                        <div class="preview-circle" style="background: #F0FFFF;"></div>
                        <div class="preview-circle" style="background: #6B8789;"></div>
                    </div>
                    <span style="font-size: 0.9rem; font-weight: bold;">Storm Azure</span>
                </div>

                <div class="theme-item">
                    <div class="theme-preview">
                        <div class="preview-circle" style="background: #0D0D0D;"></div>
                        <div class="preview-circle" style="background: #BB86FC;"></div>
                        <div class="preview-circle" style="background: #3700B3;"></div>
                    </div>
                    <span style="font-size: 0.9rem; font-weight: bold;">Midnight Purple</span>
                </div>

                <div class="theme-item">
                    <div class="theme-preview">
                        <div class="preview-circle" style="background: #0B1410;"></div>
                        <div class="preview-circle" style="background: #81C784;"></div>
                        <div class="preview-circle" style="background: #2E7D32;"></div>
                    </div>
                    <span style="font-size: 0.9rem; font-weight: bold;">Deep Forest</span>
                </div>
            </div>

            <div class="custom-colors-box">
                <div style="display: flex; gap: 25px; flex-wrap: wrap;">
                    <div class="color-picker-group">
                        <input type="color" class="color-input" value="#141B25">
                        <label style="font-size: 0.85rem; opacity: 0.7;">Фон</label>
                    </div>
                    <div class="color-picker-group">
                        <input type="color" class="color-input" value="#F0FFFF">
                        <label style="font-size: 0.85rem; opacity: 0.7;">Акцент</label>
                    </div>
                    <div class="color-picker-group">
                        <input type="color" class="color-input" value="#6B8789">
                        <label style="font-size: 0.85rem; opacity: 0.7;">Кнопки</label>
                    </div>
                </div>

                @* СТАНДАРТНА КНОПКА *@
                <button type="button" class="btn-main">
                    Застосувати стиль
                </button>
            </div>
        </div>

        <!-- РОЗДІЛ 3: НЕБЕЗПЕЧНА ЗОНА -->
        <div class="settings-card danger-card">
            <h3 style="color: #ff8080 !important;">⚠️ Небезпечна зона</h3>

            <div class="setting-row">
                <div class="setting-info">
                    <label style="color: #ff8080;">Видалити профіль</label>
                    <p>Це видалить усі ваші дані назавжди без можливості відновлення</p>
                </div>
                <form asp-controller="Account" asp-action="DeleteProfile" method="post" onsubmit="return confirm('Ви впевнені?')">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-danger-outline">Видалити акаунт</button>
                </form>
            </div>
        </div>

    </div>
</div>