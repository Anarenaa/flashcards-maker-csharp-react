@model List<Core.DTOs.PublicUserDTO>
@{
    ViewData["Title"] = "Користувачі";
}

<style>
    .admin-page-wrapper {
        display: flex;
        gap: 25px;
        align-items: flex-start;
        animation: fadeIn 0.5s ease;
    }

    .users-main-panel {
        flex: 3;
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(240, 255, 255, 0.1);
        padding: 30px;
        border-radius: 24px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.3);
    }

    .users-side-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 20px;
        position: sticky;
        top: 20px;
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(240, 255, 255, 0.05);
        padding: 20px;
        border-radius: 18px;
        transition: 0.3s;
    }

        .stat-card:hover {
            background: rgba(255, 255, 255, 0.05);
            transform: translateY(-5px);
        }
    .search-container {
        display: flex;
        gap: 12px;
        margin-bottom: 25px;
        align-items: center;
    }

    .search-input-wrapper {
        position: relative;
        flex-grow: 1;
    }

    .search-input {
        width: 100%;
        background: rgba(20, 27, 37, 0.4);
        border: 1px solid rgba(129, 131, 117, 0.3);
        color: white;
        padding: 14px 15px;
        border-radius: 12px;
        outline: none;
        transition: 0.3s;
    }

        .search-input:focus {
            border-color: var(--accent-color);
            background: rgba(20, 27, 37, 0.8);
        }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 600px;
    }

    th {
        text-align: left;
        padding: 15px;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.6;
        border-bottom: 2px solid var(--btn-border);
    }
    .live-dot {
        width: 8px;
        height: 8px;
        background: #00ff00;
        border-radius: 50%;
        display: inline-block;
        margin-right: 8px;
        box-shadow: 0 0 10px #00ff00;
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.2);
            opacity: 0.5;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    .stat-val {
        font-size: 1.5rem;
        font-weight: bold;
        color: var(--accent-color);
        display: block;
        margin-top: 5px;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 1200px) {
        .admin-page-wrapper {
            flex-direction: column;
        }

        .users-side-panel {
            width: 100%;
            flex-direction: row;
            flex-wrap: wrap;
        }

        .stat-card {
            flex: 1;
            min-width: 200px;
        }
    }
</style>

<div class="admin-page-wrapper">
    <div class="users-main-panel">
        <h2 style="margin-top: 0; margin-bottom: 25px;">Керування користувачами</h2>

        <div class="search-container">
            <div class="search-input-wrapper">
                <input type="text" id="userSearchInput"
                       value="@Context.Request.Query["searchTerm"]"
                       placeholder="Введіть ім'я, email або ID для швидкого пошуку..."
                       class="search-input" autocomplete="off">
            </div>

            <a asp-action="Users" id="resetBtn" class="nav-btn"
               style="display: @(string.IsNullOrEmpty(Context.Request.Query["searchTerm"]) ? "none" : "block");
                      padding: 12px 20px; text-decoration: none; color: #ff6464 !important; border-color: rgba(255,100,100,0.3);">
                ✕ Скинути
            </a>
        </div>

        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Користувач</th>
                        <th>Email адреса</th>
                        <th>Роль</th>
                        <th style="text-align: right;">Дії</th>
                    </tr>
                </thead>
                <tbody id="userTableBody">
                    <partial name="UserTableRows" model="Model" />
                </tbody>
            </table>
        </div>
    </div>
    <div class="users-side-panel">
        <div class="stat-card">
            <div style="font-size: 0.75rem; opacity: 0.6; text-transform: uppercase;">
                <span class="live-dot"></span> Моніторинг
            </div>
            <h4 style="margin: 10px 0 5px 0;">Всього в системі</h4>
            <span id="total-users" class="stat-val">@Model.Count</span>
        </div>

        <div class="stat-card">
            <h4 style="margin: 0 0 5px 0; color: #88ff88;">Нові сьогодні</h4>
            <span id="new-users" class="stat-val">...</span>
        </div>

        <div class="stat-card">
            <h4 style="margin: 0 0 5px 0; color: #ff6464;">Заблоковано</h4>
            <span id="blocked-users" class="stat-val">...</span>
        </div>

        <div class="stat-card" style="background: rgba(240, 255, 255, 0.05);">
            <h4 style="margin: 0 0 10px 0; font-size: 0.9rem;">Швидкі дії</h4>
            <a asp-action="Reports" class="nav-btn" style="display: block; font-size: 0.8rem; margin-bottom: 8px;">Написати скаргу</a>
            <a asp-action="Settings" class="nav-btn" style="display: block; font-size: 0.8rem;">Додати адміна</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('userSearchInput');
        const tableBody = document.getElementById('userTableBody');
        const resetBtn = document.getElementById('resetBtn');
        let timeout = null;

        searchInput.addEventListener('input', function () {
            clearTimeout(timeout);
            const query = searchInput.value;

            resetBtn.style.display = query.length > 0 ? 'block' : 'none';

            timeout = setTimeout(() => {
                fetch(`/Admin/Users?searchTerm=${encodeURIComponent(query)}`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(response => response.text())
                .then(html => {
                    tableBody.innerHTML = html;
                });
            }, 300);
        });
        async function updateStats() {
            try {
                const response = await fetch('/Admin/GetRealTimeStats');
                const data = await response.json();
                document.getElementById('new-users').innerText = data.newUsers;
                document.getElementById('blocked-users').innerText = data.blockedTotal;
                if(data.totalUsers) {
                     document.getElementById('total-users').innerText = data.totalUsers;
                }
            } catch (err) {
                console.error("Статистику не оновлено", err);
            }
        }

        setInterval(updateStats, 10000);
        updateStats();
        resetBtn.addEventListener('click', function(e) {
            e.preventDefault();
            searchInput.value = '';
            resetBtn.style.display = 'none';
            searchInput.dispatchEvent(new Event('input'));
        });
    </script>
}