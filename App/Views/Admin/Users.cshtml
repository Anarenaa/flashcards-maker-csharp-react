@model List<Core.DTOs.PublicUserDTO>
@{
    ViewData["Title"] = "Керування користувачами";
}

<style>
    .admin-page-wrapper {
        display: flex;
        gap: 25px;
        align-items: flex-start;
        animation: fadeIn 0.5s ease;
    }

    .users-main-panel {
        flex: 3;
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(240, 255, 255, 0.1);
        padding: 30px;
        border-radius: 24px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.3);
    }

    .users-side-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 20px;
        position: sticky;
        top: 20px;
    }

    .admin-tabs {
        display: flex;
        gap: 25px;
        margin-bottom: 25px;
        border-bottom: 1px solid rgba(240, 255, 255, 0.1);
        padding-bottom: 5px;
    }

    .tab-link {
        background: none;
        border: none;
        color: var(--text-color);
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        opacity: 0.5;
        padding: 10px 5px;
        transition: 0.3s;
        position: relative;
    }

        .tab-link.active {
            opacity: 1;
            color: var(--accent-color);
        }

            .tab-link.active::after {
                content: '';
                position: absolute;
                bottom: -7px;
                left: 0;
                width: 100%;
                height: 2px;
                background: var(--accent-color);
                box-shadow: 0 0 10px var(--accent-color);
            }

    .search-container {
        display: flex;
        gap: 12px;
        margin-bottom: 25px;
        align-items: center;
    }

    .search-input {
        width: 100%;
        background: rgba(20, 27, 37, 0.4);
        border: 1px solid rgba(129, 131, 117, 0.3);
        color: white;
        padding: 14px 15px;
        border-radius: 12px;
        outline: none;
        transition: 0.3s;
    }

        .search-input:focus {
            border-color: var(--accent-color);
        }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 600px;
    }

    th {
        text-align: left;
        padding: 15px;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.5;
        border-bottom: 1px solid var(--btn-border);
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(240, 255, 255, 0.05);
        padding: 22px;
        border-radius: 20px;
        transition: 0.3s;
    }

    .stat-val {
        font-size: 1.6rem;
        font-weight: bold;
        color: var(--accent-color);
        display: block;
        margin-top: 5px;
        transition: 0.5s;
    }

    .live-indicator {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.65rem;
        font-weight: bold;
        color: #88ff88;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background-color: #00ff00;
        border-radius: 50%;
        box-shadow: 0 0 10px #00ff00;
        animation: pulse 1.5s infinite;
    }

    .stat-update {
        color: #fff !important;
        text-shadow: 0 0 10px var(--accent-color);
        transform: scale(1.1);
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(0, 255, 0, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(0, 255, 0, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(0, 255, 0, 0);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 1200px) {
        .admin-page-wrapper {
            flex-direction: column;
        }

        .users-side-panel {
            width: 100%;
            flex-direction: row;
            flex-wrap: wrap;
        }

        .stat-card {
            flex: 1;
            min-width: 220px;
        }
    }
</style>

<div class="admin-page-wrapper">
    <div class="users-main-panel">
        <h2 style="margin: 0 0 25px 0; color: white;">Керування користувачами</h2>

        <div class="admin-tabs">
            <button class="tab-link active" onclick="switchTab('all', this)">Усі користувачі</button>
            <button class="tab-link" onclick="switchTab('warned', this)">З попередженнями</button>
            <button class="tab-link" onclick="switchTab('blocked', this)">Заблоковані</button>
            <button class="tab-link" onclick="switchTab('deleted', this)">Видалені</button>
        </div>

        @if (TempData["Success"] != null)
        {
            <div id="successAlert" style="background: rgba(136, 255, 136, 0.1); border: 1px solid #88ff88; color: #88ff88; padding: 12px; border-radius: 10px; margin-bottom: 20px; font-size: 0.9rem;">
                ✓ @TempData["Success"]
            </div>
        }

        <div class="search-container">
            <div style="flex-grow: 1;">
                <input type="text" id="userSearchInput"
                       value="@Context.Request.Query["searchTerm"]"
                       placeholder="Пошук за нікнеймом або email..."
                       class="search-input" autocomplete="off">
            </div>
            <a asp-action="Users" id="resetBtn" class="nav-btn"
               style="display: @(string.IsNullOrEmpty(Context.Request.Query["searchTerm"]) ? "none" : "block");
                      padding: 12px 20px; text-decoration: none; color: #ff6464 !important; border-color: rgba(255,100,100,0.3);">
                ✕ Скинути
            </a>
        </div>

        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Користувач</th>
                        <th>Email адреса</th>
                        <th>Роль</th>
                        <th style="text-align: right;">Дії</th>
                    </tr>
                </thead>
                <tbody id="userTableBody">
                    <partial name="UserTableRows" model="Model" />
                </tbody>
            </table>
        </div>
    </div>

    <div class="users-side-panel">
        <div class="stat-card">
            <div class="live-indicator"><div class="pulse-dot"></div> Live Monitor</div>
            <h4 style="margin: 0; opacity: 0.7; font-size: 0.9rem;">Всього в системі</h4>
            <span id="total-users" class="stat-val">@Model.Count</span>
        </div>
        <div class="stat-card">
            <h4 style="margin: 0; opacity: 0.7; font-size: 0.9rem; color: #88ff88;">Нові сьогодні</h4>
            <span id="new-users" class="stat-val">0</span>
        </div>
        <div class="stat-card">
            <h4 style="margin: 0; opacity: 0.7; font-size: 0.9rem; color: #ff6464;">Заблоковано/Видалено</h4>
            <span id="blocked-users" class="stat-val">0</span>
        </div>
        <div class="stat-card" style="background: rgba(240, 255, 255, 0.05); border: 1px solid var(--accent-color);">
            <h4 style="margin: 0 0 15px 0; font-size: 0.9rem;">Швидкі дії</h4>
            <a asp-action="Reports" class="nav-btn" style="display: block; font-size: 0.8rem; margin-bottom: 8px; text-align:center; text-decoration:none;">Написати скаргу</a>
            <a asp-action="Settings" class="nav-btn" style="display: block; font-size: 0.8rem; text-align:center; text-decoration:none;">Додати адміна</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('userSearchInput');
        const tableBody = document.getElementById('userTableBody');
        const resetBtn = document.getElementById('resetBtn');
        let currentFilter = 'all';

        function switchTab(type, element) {
            currentFilter = type;
            document.querySelectorAll('.tab-link').forEach(btn => btn.classList.remove('active'));
            element.classList.add('active');
            applyTabFilter();
        }

        function applyTabFilter() {
            const rows = tableBody.querySelectorAll('tr');
            rows.forEach(row => {
                const isBlocked = row.getAttribute('data-blocked') === 'true';
                const isDeleted = row.getAttribute('data-deleted') === 'true';
                const warnings = parseInt(row.getAttribute('data-warnings') || '0');

                if (currentFilter === 'all') {
                    row.style.display = isDeleted ? 'none' : '';
                } else if (currentFilter === 'warned') {
                    row.style.display = (warnings > 0 && !isDeleted) ? '' : 'none';
                } else if (currentFilter === 'blocked') {
                    row.style.display = (isBlocked && !isDeleted) ? '' : 'none';
                } else if (currentFilter === 'deleted') {
                    row.style.display = isDeleted ? '' : 'none';
                }
            });
        }

       
        searchInput.addEventListener('input', function () {
            const query = searchInput.value;
            resetBtn.style.display = query.length > 0 ? 'block' : 'none';

            clearTimeout(window.searchTimeout);
            window.searchTimeout = setTimeout(() => {
                fetch(`/Admin/Users?searchTerm=${encodeURIComponent(query)}`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(response => response.text())
                .then(html => {
                    tableBody.innerHTML = html;
                    applyTabFilter(); 
                });
            }, 300);
        });

        async function updateStats() {
            try {
                const response = await fetch('/Admin/GetRealTimeStats');
                const data = await response.json();

                updateCounter('new-users', data.newUsers);
                updateCounter('blocked-users', data.blockedTotal);
                if(data.totalUsers) updateCounter('total-users', data.totalUsers);
            } catch (err) {}
        }

        function updateCounter(id, newVal) {
            const el = document.getElementById(id);
            if (el && el.innerText != newVal) {
                el.classList.add('stat-update');
                el.innerText = newVal;
                setTimeout(() => el.classList.remove('stat-update'), 1000);
            }
        }

        setInterval(updateStats, 10000);
        updateStats();

        resetBtn.addEventListener('click', function(e) {
            e.preventDefault();
            searchInput.value = '';
            resetBtn.style.display = 'none';
            searchInput.dispatchEvent(new Event('input'));
        });

        const alert = document.getElementById('successAlert');
        if (alert) setTimeout(() => alert.style.display = 'none', 5000);
    </script>
}