@model List<Core.Models.User>
@{
    ViewData["Title"] = "Заблоковані";
}

<div class="report-main-panel" style="flex: 1;">
    <h2 style="margin-bottom: 25px; color: #ff6464;">Заблоковані користувачі</h2>

    <table class="complaints-table">
        <thead>
            <tr>
                <th>Користувач</th>
                <th>Email</th>
                <th>Статус</th>
                <th style="text-align:right;">Дія</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td><strong>@user.UserName</strong></td>
                    <td style="opacity: 0.7;">@user.Email</td>
                    <td>
                        <span style="color: #ff6464; font-weight: bold; font-size: 0.8rem; text-transform: uppercase;">
                            🚫 Заблоковано
                        </span>
                    </td>
                    <td style="text-align:right;">
                        <form asp-action="ToggleBlock" method="post">
                            <input type="hidden" name="id" value="@user.Id" />
                            <input type="hidden" name="shouldBlock" value="false" />
                            <button type="submit" class="btn-action" style="color: #88ff88 !important; border-color: #88ff88;">Розблокувати</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="4" style="text-align:center; padding: 40px; opacity:0.5;">Зараз немає заблокованих користувачів</td></tr>
            }
        </tbody>
    </table>
</div>