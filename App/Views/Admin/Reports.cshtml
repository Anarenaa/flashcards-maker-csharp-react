@{
    ViewData["Title"] = "Надіслати попередження";
}

<style>
   
    .report-page-wrapper {
        display: flex;
        gap: 30px;
        align-items: flex-start;
        animation: fadeIn 0.5s ease;
    }

   
    .report-main-panel {
        flex: 2; 
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(240, 255, 255, 0.1);
        padding: 40px;
        border-radius: 24px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.3);
    }

 
    .report-side-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .info-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(240, 255, 255, 0.05);
        padding: 25px;
        border-radius: 20px;
    }

        .info-card h4 {
            margin-top: 0;
            color: var(--accent-color);
            display: flex;
            align-items: center;
            gap: 10px;
        }

   
    .form-group {
        margin-bottom: 25px;
        position: relative;
    }

    label {
        display: block;
        margin-bottom: 10px;
        font-weight: 500;
        opacity: 0.8;
    }

    .input-style {
        width: 100%;
        background: rgba(20, 27, 37, 0.4);
        border: 1px solid rgba(129, 131, 117, 0.3);
        color: white;
        padding: 15px;
        border-radius: 12px;
        outline: none;
        transition: 0.3s;
        box-sizing: border-box;
    }

        .input-style:focus {
            border-color: var(--accent-color);
            background: rgba(20, 27, 37, 0.8);
        }

   
    #suggestionList {
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        background: #1b2431;
        border: 1px solid var(--btn-border);
        border-radius: 0 0 12px 12px;
        z-index: 100;
        display: none;
        max-height: 200px;
        overflow-y: auto;
    }

    .suggestion-item {
        padding: 12px;
        cursor: pointer;
        transition: 0.2s;
    }

        .suggestion-item:hover {
            background: var(--btn-hover);
            color: var(--accent-color);
        }

    .btn-submit {
        width: 100%;
        background: transparent;
        border: 1px solid var(--accent-color);
        color: var(--accent-color) !important;
        padding: 18px;
        border-radius: 12px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
        text-transform: uppercase;
    }

        .btn-submit:hover {
            background: var(--accent-color);
            color: #141B25 !important;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 1100px) {
        .report-page-wrapper {
            flex-direction: column;
        }

        .report-side-panel {
            width: 100%;
            order: -1;
        }
    }

    .live-indicator {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.7rem;
        font-weight: bold;
        color: #88ff88;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 10px;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background-color: #00ff00;
        border-radius: 50%;
        box-shadow: 0 0 0 rgba(0, 255, 0, 0.4);
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(0, 255, 0, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(0, 255, 0, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(0, 255, 0, 0);
        }
    }

    .stat-number {
        font-size: 1.2rem;
        font-weight: bold;
        color: var(--accent-color);
        transition: all 0.5s ease;
    }

 
    .stat-update {
        color: #fff !important;
        text-shadow: 0 0 15px var(--accent-color);
        transform: scale(1.1);
    }
</style>

<div class="report-page-wrapper">


    <div class="report-main-panel">
        <h2 style="margin-top: 0; margin-bottom: 35px; color: var(--accent-color);">Центр попереджень</h2>

        @if (TempData["Success"] != null)
        {
            <div style="background: rgba(136, 255, 136, 0.1); border: 1px solid #88ff88; color: #88ff88; padding: 15px; border-radius: 10px; margin-bottom: 25px;">
                ✓ @TempData["Success"]
            </div>
        }

        <form asp-action="SendWarning" method="post">
            <div class="form-group">
                <label>Пошук користувача (Логін або Email)</label>
                <input type="email" name="email" id="emailInput" value="@ViewBag.TargetEmail"
                       class="input-style" placeholder="Введіть перші літери..." autocomplete="off" required>
                <div id="suggestionList"></div>
            </div>

            <div class="form-group">
                <label>Тип порушення (Шаблон)</label>
                <select id="templateSelect" class="input-style" onchange="applyTemplate()">
                    <option value="">-- Оберіть причину для автозаповнення --</option>
                    <option value="profanity"> Нецензурна лексика</option>
                    <option value="strange_cards"> Недоречний контент</option>
                    <option value="spam"> Спам та реклама</option>
                    <option value="toxic"> Токсична поведінка</option>
                </select>
            </div>

            <div class="form-group">
                <label>Тема листа</label>
                <input type="text" name="subject" id="mailSubject" class="input-style" placeholder="Наприклад: Попередження..." required>
            </div>

            <div class="form-group">
                <label>Текст офіційного повідомлення</label>
                <textarea name="message" id="mailMessage" rows="8" class="input-style" placeholder="Напишіть деталі порушення..." required></textarea>
            </div>

            <button type="submit" class="btn-submit">Надіслати офіційне попередження</button>
        </form>
    </div>

  
    <div class="report-side-panel">
        <div class="info-card">
            <h4>💡 Порада адміну</h4>
            <p style="font-size: 0.9rem; opacity: 0.7; line-height: 1.5;">
                Використовуйте шаблони для швидкої відповіді. Листи, надіслані через цю форму, приходять користувачу на офіційну пошту від імені системи.
            </p>
        </div>

        <div class="info-card" style="border-left: 3px solid #ff6464;">
            <h4 style="color: #ff6464;"> Правила модерації</h4>
            <ul style="font-size: 0.85rem; opacity: 0.7; padding-left: 20px; line-height: 1.8;">
                <li>Заборонено нецензурну лексику в назвах сетів.</li>
                <li>Картки не повинні містити образливий контент.</li>
                <li>Реклама сторонніх сервісів карається баном.</li>
                <li>Після 3-го попередження — автоматичне блокування.</li>
            </ul>
        </div>

        <div class="info-card">
            <div class="live-indicator">
                <div class="pulse-dot"></div> Live Monitor
            </div>
            <h4>📊 Активність модерації</h4>

            <div style="display: flex; justify-content: space-between; margin-top: 20px;">
                <span style="opacity: 0.6;">Листів за сьогодні:</span>
                <span id="count-emails" class="stat-number">...</span>
            </div>

            <div style="display: flex; justify-content: space-between; margin-top: 15px;">
                <span style="opacity: 0.6;">Остання дія:</span>
                <span id="last-action-time" style="opacity: 0.9;">завантаження...</span>
            </div>

            <div style="display: flex; justify-content: space-between; margin-top: 15px;">
                <span style="opacity: 0.6;">Адмінів в мережі:</span>
                <span id="online-admins" style="color: #88ff88; font-weight: bold;">1</span>
            </div>
        </div>
    </div>
</div>

<script>
    const emailInput = document.getElementById('emailInput');
    const suggestionList = document.getElementById('suggestionList');

    const templates = {
        "profanity": {
            sub: "Попередження: Нецензурна лексика",
            msg: "Вітаємо! Ми помітили використання недопустимих слів у ваших навчальних матеріалах. Будь ласка, приведіть їх у відповідність до правил нашого сервісу."
        },
        "strange_cards": {
            sub: "Зауваження щодо вмісту карток",
            msg: "Деякі з ваших публічних карток містять контент, який не відповідає освітній тематиці нашого ресурсу. Просимо видалити або приховати ці матеріали."
        },
        "spam": {
            sub: "Попередження щодо спам-активності",
            msg: "Ваш акаунт було помічено у розсиланні спаму або реклами. Це порушує умови використання Flashcards Maker."
        },
        "toxic": {
            sub: "Важливо: Поведінка в спільноті",
            msg: "На ваш акаунт надійшли скарги щодо токсичної поведінки. Просимо дотримуватися взаємоповаги до інших користувачів."
        }
    };

    emailInput.addEventListener('input', async () => {
        const query = emailInput.value;
        if (query.length < 2) {
            suggestionList.style.display = 'none';
            return;
        }

        try {
            const res = await fetch(`/Admin/GetEmailSuggestions?query=${encodeURIComponent(query)}`);
            const data = await res.json();

            if (data.length > 0) {
                suggestionList.innerHTML = data.map(u => `
                    <div class="suggestion-item" onclick="selectEmail('${u.email}')">
                        <strong>${u.userName}</strong> <br>
                        <small style="opacity:0.6">${u.email}</small>
                    </div>
                `).join('');
                suggestionList.style.display = 'block';
            } else {
                suggestionList.style.display = 'none';
            }
        } catch (err) {
            console.error("Помилка пошуку користувачів", err);
        }
    });

    function selectEmail(email) {
        emailInput.value = email;
        suggestionList.style.display = 'none';
    }

    function applyTemplate() {
        const key = document.getElementById('templateSelect').value;
        const subjectInput = document.getElementById('mailSubject');
        const messageInput = document.getElementById('mailMessage');

        if (templates[key]) {
            subjectInput.value = templates[key].sub;
            messageInput.value = templates[key].msg;

            subjectInput.style.borderColor = 'var(--accent-color)';
            messageInput.style.borderColor = 'var(--accent-color)';
            setTimeout(() => {
                subjectInput.style.borderColor = 'rgba(129, 131, 117, 0.3)';
                messageInput.style.borderColor = 'rgba(129, 131, 117, 0.3)';
            }, 1000);
        }
    }

    async function refreshStats() {
        try {
            const response = await fetch('/Admin/GetRealTimeStats');
            const data = await response.json();

            const emailElem = document.getElementById('count-emails');
            const actionElem = document.getElementById('last-action-time');

            if (emailElem.innerText !== "..." && emailElem.innerText != data.emailsToday) {
                emailElem.classList.add('stat-update');
                setTimeout(() => emailElem.classList.remove('stat-update'), 1000);
            }

            emailElem.innerText = data.emailsToday;
            actionElem.innerText = data.lastAction;
        } catch (err) {
            console.error("Помилка оновлення статистики", err);
        }
    }

   
    setInterval(refreshStats, 10000);
    refreshStats();

    document.addEventListener('click', (e) => {
        if (e.target !== emailInput) {
            suggestionList.style.display = 'none';
        }
    });

    document.querySelector('form').addEventListener('submit', function() {
        const btn = this.querySelector('.btn-submit');
        btn.innerText = "Надсилається...";
        btn.style.opacity = "0.7";
    });
</script>