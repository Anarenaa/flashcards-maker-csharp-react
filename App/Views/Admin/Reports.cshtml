@model IEnumerable<Core.Models.Report>
@{
    ViewData["Title"] = "Центр модерації";
    var adminWarnings = ViewBag.AdminWarnings as List<Core.Models.Report> ?? new List<Core.Models.Report>();
    var userComplaints = ViewBag.UserComplaints as List<Core.Models.Report> ?? new List<Core.Models.Report>();
}

<style>
    /* --- СТИЛІ ВКЛАДОК --- */
    .report-tabs {
        display: flex;
        gap: 20px;
        margin-bottom: 30px;
        border-bottom: 1px solid rgba(240, 255, 255, 0.1);
        padding-bottom: 10px;
    }

    .tab-btn {
        background: none;
        border: none;
        color: var(--text-color);
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        opacity: 0.5;
        padding: 10px 15px;
        transition: 0.3s;
        position: relative;
    }

        .tab-btn.active {
            opacity: 1;
            color: var(--accent-color);
        }

            .tab-btn.active::after {
                content: '';
                position: absolute;
                bottom: -11px;
                left: 0;
                width: 100%;
                height: 3px;
                background: var(--accent-color);
                box-shadow: 0 0 10px var(--accent-color);
            }

    /* --- СТРУКТУРА --- */
    .report-page-wrapper {
        display: flex;
        gap: 30px;
        align-items: flex-start;
        animation: fadeIn 0.5s ease;
    }

    .report-main-panel {
        flex: 2.5;
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(240, 255, 255, 0.1);
        padding: 35px;
        border-radius: 24px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        min-height: 550px;
    }

    .report-side-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .tab-content {
        display: none;
        animation: slideUp 0.4s ease;
    }

        .tab-content.active {
            display: block;
        }

    .mod-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

        .mod-table th {
            text-align: left;
            padding: 15px;
            opacity: 0.5;
            font-size: 0.8rem;
            text-transform: uppercase;
            border-bottom: 1px solid rgba(240, 255, 255, 0.1);
        }

        .mod-table td {
            padding: 18px 15px;
            border-bottom: 1px solid rgba(240, 255, 255, 0.05);
            font-size: 0.9rem;
        }

    .badge-reason {
        background: rgba(255, 100, 100, 0.15);
        color: #ff8080;
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: bold;
    }

    /* Форма */
    .form-group {
        margin-bottom: 22px;
        position: relative;
    }

    label {
        display: block;
        margin-bottom: 8px;
        font-weight: 500;
        opacity: 0.8;
        font-size: 0.9rem;
    }

    .input-style {
        width: 100%;
        background: rgba(20, 27, 37, 0.4);
        border: 1px solid rgba(129, 131, 117, 0.3);
        color: white;
        padding: 14px;
        border-radius: 12px;
        outline: none;
        transition: 0.3s;
        box-sizing: border-box;
    }

        .input-style:focus {
            border-color: var(--accent-color);
            background: rgba(20, 27, 37, 0.8);
        }

    .btn-submit {
        width: 100%;
        background: transparent;
        border: 1px solid var(--accent-color);
        color: var(--accent-color) !important;
        padding: 16px;
        border-radius: 12px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
        text-transform: uppercase;
    }

        .btn-submit:hover {
            background: var(--accent-color);
            color: #141B25 !important;
        }

    /* Live Monitor */
    .info-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(240, 255, 255, 0.05);
        padding: 22px;
        border-radius: 20px;
    }

    .stat-number {
        font-weight: bold;
        color: var(--accent-color);
        transition: 0.5s;
    }

    .live-indicator {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.65rem;
        font-weight: bold;
        color: #88ff88;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background-color: #00ff00;
        border-radius: 50%;
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(0, 255, 0, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(0, 255, 0, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(0, 255, 0, 0);
        }
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="report-tabs">
    <button class="tab-btn active" onclick="openTab(event, 'write-tab')">Написати</button>
    <button class="tab-btn" onclick="openTab(event, 'archive-tab')">Архів попереджень (Адмін)</button>
    <button class="tab-btn" onclick="openTab(event, 'complaints-tab')">Скарги від користувачів</button>
</div>

<div class="report-page-wrapper">
    <div class="report-main-panel">

        <!-- ВКЛАДКА 1: НАПИСАТИ -->
        <div id="write-tab" class="tab-content active">
            <h2 style="margin: 0 0 30px 0; color: var(--accent-color);">Центр попереджень</h2>
            @if (TempData["Success"] != null)
            {
                <div style="background: rgba(136, 255, 136, 0.1); border: 1px solid #88ff88; color: #88ff88; padding: 15px; border-radius: 10px; margin-bottom: 25px;">✓ @TempData["Success"]</div>
            }
            <form asp-action="SendWarning" method="post">
                <div class="form-group">
                    <label>Пошук користувача</label>
                    <input type="email" name="email" id="emailInput" value="@ViewBag.TargetEmail" class="input-style" placeholder="Введіть email або логін..." autocomplete="off" required>
                    <div id="suggestionList"></div>
                </div>
                <div class="form-group">
                    <label>Шаблон повідомлення</label>
                    <select id="templateSelect" class="input-style" onchange="applyTemplate()">
                        <option value="">-- Оберіть причину --</option>
                        <option value="profanity"> Нецензурна лексика</option>
                        <option value="content"> Недоречний контент</option>
                        <option value="spam"> Спам та реклама</option>
                    </select>
                </div>
                <div class="form-group"><input type="text" name="subject" id="mailSubject" class="input-style" placeholder="Тема листа" required></div>
                <div class="form-group"><textarea name="message" id="mailMessage" rows="8" class="input-style" placeholder="Офіційний текст..." required></textarea></div>
                <button type="submit" class="btn-submit">Надіслати попередження</button>
            </form>
        </div>

        <!-- ВКЛАДКА 2: АРХІВ АДМІНА -->
        <div id="archive-tab" class="tab-content">
            <h2 style="margin: 0 0 25px 0;">Історія попереджень</h2>
            <table class="mod-table">
                <thead><tr><th>Кому</th><th>Деталі</th><th>Дата</th><th style="text-align:right;">Дія</th></tr></thead>
                <tbody>
                    @foreach (var w in adminWarnings)
                    {
                        <tr>
                            <td><strong>@w.ReportedUser?.UserName</strong></td>
                            <td style="opacity:0.8">@w.CustomReason</td>
                            <td style="opacity:0.5">@w.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</td>
                            <td style="text-align:right;">
                                <form asp-action="DeleteReport" method="post" onsubmit="return confirm('Видалити цей запис?')">
                                    <input type="hidden" name="id" value="@w.Id" />
                                    <button type="submit" style="background:none; border:none; color:#ff6464; cursor:pointer;"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ВКЛАДКА 3: СКАРГИ ВІД ЮЗЕРІВ -->
        <div id="complaints-tab" class="tab-content">
            <h2 style="margin: 0 0 25px 0;">Скарги від спільноти</h2>
            <table class="mod-table">
                <thead><tr><th>Від кого</th><th>Об'єкт</th><th>Причина</th><th style="text-align:right;">Дія</th></tr></thead>
                <tbody>
                    @foreach (var c in userComplaints)
                    {
                        <tr>
                            <td><strong>@(c.Reporter?.UserName ?? "Гість")</strong></td>
                            <td>
                                @if (c.ReportedSetId != null)
                                {
                                    <span style="color:var(--accent-color)">Сет #@c.ReportedSetId</span>
                                }
                                else
                                {

                                    <span>Юзер: @c.ReportedUser?.UserName</span>
                                }
                            </td>
                            <td><span class="badge-reason">@c.Reason.ToString()</span></td>
                            <td style="text-align:right; display:flex; gap:15px; justify-content:flex-end; align-items:center;">
                                @if (c.ReportedSetId != null)
                                {
                                    <a asp-controller="DetailsInMain" asp-action="Sets" asp-route-id="@c.ReportedSetId" style="color:var(--accent-color); text-decoration:none; font-weight:600;">Перевірити</a>
                                }
                                else
                                {
                                    <a asp-action="UserDetails" asp-route-id="@c.ReportedUserId" style="color:var(--accent-color); text-decoration:none; font-weight:600;">Профіль</a>
                                }
                                <form asp-action="DeleteReport" method="post" onsubmit="return confirm('Видалити скаргу?')">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" style="background:none; border:none; color:#ff6464; cursor:pointer;"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- SIDEBAR -->
    <div class="report-side-panel">
        <div class="info-card">
            <div class="live-indicator"><div class="pulse-dot"></div> Live Monitor</div>
            <h4>📊 Активність</h4>
            <div class="stat-row"><span>Листів сьогодні:</span> <span id="count-emails" class="stat-number">0</span></div>
            <div class="stat-row"><span>Всього юзерів:</span> <span id="total-users-count" class="stat-number">...</span></div>
        </div>
        <div class="info-card" style="border-left: 3px solid #ff6464;">
            <h4 style="color: #ff6464;">🚩 Правила</h4>
            <ul style="font-size: 0.8rem; opacity: 0.7; padding-left: 15px; line-height: 1.8; margin:0;">
                <li>Без нецензурної лексики.</li>
                <li>Тільки освітній контент.</li>
                <li>3 скарги = бан акаунта.</li>
            </ul>
        </div>
    </div>
</div>

<script>
    function openTab(evt, tabName) {
        document.querySelectorAll(".tab-content").forEach(c => c.classList.remove("active"));
        document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
        document.getElementById(tabName).classList.add("active");
        evt.currentTarget.classList.add("active");
    }

    // Живий пошук
    const emailInput = document.getElementById('emailInput');
    const suggestionList = document.getElementById('suggestionList');
    emailInput.addEventListener('input', async () => {
        const query = emailInput.value;
        if (query.length < 2) { suggestionList.style.display = 'none'; return; }
        const res = await fetch(`/Admin/GetEmailSuggestions?query=${encodeURIComponent(query)}`);
        const data = await res.json();
        if (data.length > 0) {
            suggestionList.innerHTML = data.map(u => `<div class="suggestion-item" onclick="selectEmail('${u.email}')"><strong>${u.userName}</strong><br><small>${u.email}</small></div>`).join('');
            suggestionList.style.display = 'block';
        } else suggestionList.style.display = 'none';
    });
    function selectEmail(email) { emailInput.value = email; suggestionList.style.display = 'none'; }

    // Шаблони
    const templates = {
        "profanity": { sub: "Попередження: Нецензурна лексика", msg: "Ми помітили використання недопустимих слів у ваших навчальних матеріалах." },
        "content": { sub: "Зауваження щодо вмісту", msg: "Деякі з ваших публічних карток містять контент, який не відповідає правилам." },
        "spam": { sub: "Попередження: Спам", msg: "Ваш акаунт було помічено у розсиланні реклами або спаму." }
    };
    function applyTemplate() {
        const key = document.getElementById('templateSelect').value;
        if (templates[key]) {
            document.getElementById('mailSubject').value = templates[key].sub;
            document.getElementById('mailMessage').value = templates[key].msg;
        }
    }

    // Статистика
    async function refreshStats() {
        try {
            const response = await fetch('/Admin/GetRealTimeStats');
            const data = await response.json();
            document.getElementById('count-emails').innerText = data.emailsToday;
            document.getElementById('total-users-count').innerText = data.totalUsers || "...";
        } catch (err) {}
    }
    setInterval(refreshStats, 10000); refreshStats();
    document.addEventListener('click', (e) => { if (e.target !== emailInput) suggestionList.style.display = 'none'; });
</script>