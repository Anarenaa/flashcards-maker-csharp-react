@using Core.DTOs
@using Core.Models
@model SetDetailDTO

@{
    ViewData["Title"] = "Редактор карток - " + Model.Name;
}

<style>
    .back-link {
        color: var(--accent-color);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        opacity: 0.7;
        text-decoration: none;
        transition: 0.3s;
        font-size: 0.9rem;
    }

        .back-link:hover {
            opacity: 1;
            transform: translateX(-5px);
        }

    .header-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 30px;
        gap: 20px;
    }

    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
    }

    .flashcard-item {
        background-color: var(--btn-bg);
        border: 1px solid var(--btn-border);
        border-radius: 15px;
        padding: 25px;
        min-height: 140px;
        display: flex;
        flex-direction: column;
        position: relative;
        transition: 0.3s ease;
    }

        .flashcard-item:hover {
            border-color: var(--accent-color);
            transform: translateY(-3px);
        }

    .card-term {
        font-weight: bold;
        color: var(--accent-color);
        font-size: 1.15rem;
        margin-bottom: 12px;
        padding-right: 25px;
        word-break: break-word;
    }

    .card-divider {
        height: 1px;
        background: rgba(240, 255, 255, 0.1);
        border: none;
        margin: 10px 0;
    }

    .card-definition {
        opacity: 0.8;
        font-size: 1rem;
        line-height: 1.4;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .dots {
        position: absolute;
        top: 15px;
        right: 15px;
        cursor: pointer;
        font-size: 1.5rem;
        opacity: 0.5;
        z-index: 10;
    }

    .dropdown {
        position: absolute;
        top: 45px;
        right: 15px;
        background: #2C3440;
        border: 1px solid #818375;
        border-radius: 8px;
        display: none;
        flex-direction: column;
        z-index: 100;
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        overflow: hidden;
        min-width: 150px;
    }

        .dropdown button {
            background: none;
            border: none;
            color: white;
            padding: 10px 20px;
            text-align: left;
            cursor: pointer;
            width: 100%;
            font-size: 0.9rem;
        }

            .dropdown button:hover {
                background-color: #6B8789;
            }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.85);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal {
        background: #1C2531;
        border: 1px solid var(--accent-color);
        padding: 30px;
        border-radius: 20px;
        width: 440px;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .field-block {
        display: flex;
        flex-direction: column;
        width: 100%;
        margin-bottom: 10px;
    }

        .field-block label {
            font-size: 0.75rem;
            opacity: 0.6;
            margin-bottom: 5px;
            color: white;
        }

    .modal input, .modal textarea {
        background: #141B25;
        border: 1px solid #818375;
        color: white !important;
        padding: 12px;
        border-radius: 10px;
        outline: none;
        box-sizing: border-box;
        font-family: inherit;
        width: 100%;
    }

    .hint-btn {
        position: absolute;
        right: 10px;
        bottom: 10px;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: none;
        background: #f4a261;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.3s;
        box-shadow: 0 0 10px rgba(244, 162, 97, 0.2);
        z-index: 10;
    }

        .hint-btn:hover:not(:disabled) {
            transform: scale(1.1) rotate(10deg);
            box-shadow: 0 0 15px rgba(244, 162, 97, 0.5);
        }

        .hint-btn:disabled {
            background: #2c3440 !important;
            opacity: 0.4;
            cursor: not-allowed;
        }

    .spinner-hint {
        width: 18px;
        height: 18px;
        border: 2px solid rgba(0, 0, 0, 0.1);
        border-top: 2px solid #000;
        border-radius: 50%;
        animation: spin-hint 0.8s linear infinite;
    }

    @@keyframes spin-hint {
        to {
            transform: rotate(360deg);
        }
    }

    .btn-main {
        background: #6B8789;
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
        transition: 0.3s;
    }
</style>

<div class="content-area">
    <a asp-controller="MySets" asp-action="Index" class="back-link">← Назад до моїх сетів</a>

    <div class="header-row">
        <div>
            <h2 style="color: var(--accent-color); margin: 0; font-size: 1.8rem;">@Model.Name</h2>
            <p style="opacity: 0.6; margin: 5px 0 0 0;">@Model.Description</p>
        </div>
        <button class="btn-main" onclick="openCreateCardModal()">+ Картка</button>
    </div>

    <div class="cards-grid">
        @foreach (var card in Model.Flashcards)
        {
            <div class="flashcard-item">
                <div class="dots" onclick="toggleMenu(event)">⋮</div>
                <div class="dropdown">
                    <button type="button" onclick="openEditCardModal('@card.Id', '@card.Term', '@card.Definition')">Редагувати</button>
                    <form asp-action="DeleteCard" method="post" onsubmit="return confirm('Видалити?')">
                        <input type="hidden" name="cardId" value="@card.Id" />
                        <input type="hidden" name="setId" value="@Model.Id" />
                        <button type="submit" style="color: #ff8080;">Видалити</button>
                    </form>
                </div>
                <div class="card-term">@card.Term</div>
                <hr class="card-divider">
                <div class="card-definition">@card.Definition</div>
            </div>
        }
    </div>
</div>

<div class="modal-overlay" id="cardModal">
    <div class="modal">
        <h2 id="modalTitle" style="color: var(--accent-color); margin: 0 0 10px 0;">Нова картка</h2>
        <form asp-action="SaveCard" method="post">
            <input type="hidden" name="setId" value="@Model.Id" />
            <input type="hidden" name="cardDto.Id" id="modalCardId" value="0" />

            <div class="field-block">
                <label>Питання (Термін)</label>
                <input type="text" name="cardDto.Term" id="modalTerm" required oninput="validateHintBtn()">
            </div>

            <div class="field-block">
                <label>Відповідь (Визначення)</label>
                <div style="position: relative; width: 100%;">
                    <textarea name="cardDto.Definition" id="modalDefinition" rows="5" required style="padding-right: 50px; resize: none;"></textarea>

                    <button type="button" id="hintBtn" class="hint-btn" onclick="askAI()" disabled title="ШІ підказка">
                        <span id="hintIcon" style="font-size: 1.2rem;">💡</span>
                        <div id="hintLoader" class="spinner-hint" style="display: none;"></div>
                    </button>
                </div>
                <div id="hintError" style="display: none; color: #ff8080; font-size: 0.75rem; margin-top: 8px; line-height: 1.2;"></div>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 15px; border-top: 1px solid #333; padding-top: 15px;">
                <button type="button" onclick="closeCardModal()" style="background:none; border:none; color:#818375; cursor:pointer;">Скасувати</button>
                <button type="submit" class="btn-main">Зберегти</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const cardModal = document.getElementById('cardModal');
        const termInput = document.getElementById('modalTerm');
        const defInput = document.getElementById('modalDefinition');
        const hintBtn = document.getElementById('hintBtn');
        const hIcon = document.getElementById('hintIcon');
        const hLoader = document.getElementById('hintLoader');
        const hError = document.getElementById('hintError');

        function validateHintBtn() {
            hintBtn.disabled = termInput.value.trim().length === 0;
            if (hintBtn.disabled) hError.style.display = 'none';
        }

        async function askAI() {
            const term = termInput.value.trim();
            if (!term) return;

            hintBtn.disabled = true;
            hIcon.style.display = 'none';
            hLoader.style.display = 'block';
            hError.style.display = 'none';
            defInput.value = "ШІ думає...";

            try {
                const t = new Date().getTime();
                const url = `/api/get-hint?term=${encodeURIComponent(term)}&setType=@((int)Model.Type)&fromLang=en&toLang=uk&uiLang=uk&_t=${t}`;

                const response = await fetch(url);
                if (!response.ok) throw new Error();

                const hintText = await response.text();

                const isBad = hintText.toLowerCase().trim() === term.toLowerCase().trim() || hintText.includes("недоступна");

                if (isBad) {
                    console.log("ШІ не зміг, йду у Вікіпедію...");
                    const wikiUrl = `https://uk.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(term)}`;
                    const wikiRes = await fetch(wikiUrl);
                    if (!wikiRes.ok) throw new Error();
                    const wikiData = await wikiRes.json();

       
                    let text = wikiData.extract || "";
                    defInput.value = text.split('. ')[0] + "."; 
                } else {
                    defInput.value = hintText;
                }

            } catch (e) {
                defInput.value = "";
                hError.style.display = 'block';
                hError.innerText = "⚠️ Не вдалося знайти короткий опис.";
            } finally {
                hLoader.style.display = 'none';
                hIcon.style.display = 'block';
                validateHintBtn();
            }
        }

        function openCreateCardModal() { document.getElementById('modalTitle').innerText = "Нова картка"; document.getElementById('modalCardId').value = "0"; termInput.value = ""; defInput.value = ""; hError.style.display = 'none'; validateHintBtn(); cardModal.style.display = 'flex'; }
        function openEditCardModal(id, term, def) { document.getElementById('modalTitle').innerText = "Редагувати картка"; document.getElementById('modalCardId').value = id; termInput.value = term; defInput.value = def; hError.style.display = 'none'; validateHintBtn(); cardModal.style.display = 'flex'; }
        function closeCardModal() { cardModal.style.display = 'none'; }
        function toggleMenu(e) { e.stopPropagation(); const d = e.currentTarget.nextElementSibling; document.querySelectorAll('.dropdown').forEach(x => { if (x !== d) x.style.display = 'none'; }); d.style.display = d.style.display === 'flex' ? 'none' : 'flex'; }

        window.onclick = (e) => {
            if (e.target === cardModal) closeCardModal();
            if (!e.target.matches('.dots')) document.querySelectorAll('.dropdown').forEach(d => d.style.display = 'none');
        };
    </script>
}