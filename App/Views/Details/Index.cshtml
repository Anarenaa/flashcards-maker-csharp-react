@using Core.DTOs
@model SetDetailDTO

@{
    ViewData["Title"] = "Редактор карток - " + Model.Name;
}

<style>
   
    .practice-sticky-container {
        position: fixed;
        top: 30px;
        right: 40px;
        z-index: 9999; 
    }

    .btn-practice-float {
        background: var(--accent-color);
        color: #141B25 !important;
        padding: 14px 28px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 800;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 2px solid rgba(255, 255, 255, 0.2);
    }

        .btn-practice-float:hover {
            transform: scale(1.08) translateY(-3px);
            background: #fff;
            box-shadow: 0 15px 35px rgba(240, 255, 255, 0.4);
        }

    .back-link {
        color: var(--accent-color);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        opacity: 0.7;
        text-decoration: none;
        transition: 0.3s;
        font-size: 0.9rem;
    }

        .back-link:hover {
            opacity: 1;
            transform: translateX(-5px);
        }

    .header-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 30px;
        gap: 20px;
    }

    .categories-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 15px;
        padding: 0;
        list-style: none;
    }

    .category-badge {
        display: inline-flex;
        align-items: center;
        background: rgba(119, 158, 203, 0.15);
        border: 1px solid rgba(119, 158, 203, 0.4);
        color: #DEE4C7;
        padding: 6px 12px;
        border-radius: 12px;
        font-size: 0.85rem;
        gap: 8px;
    }

    .remove-cat-btn {
        background: none;
        border: none;
        color: #ff8080;
        cursor: pointer;
        font-weight: bold;
        font-size: 1.1rem;
        padding: 0;
        line-height: 1;
        transition: 0.2s;
    }

        .remove-cat-btn:hover {
            color: #ff4d4d;
        }

    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
    }

    .flashcard-item {
        background-color: var(--btn-bg);
        border: 1px solid var(--btn-border);
        border-radius: 15px;
        padding: 25px;
        min-height: 140px;
        display: flex;
        flex-direction: column;
        position: relative;
        transition: 0.3s ease;
    }

        .flashcard-item:hover {
            border-color: var(--accent-color);
            transform: translateY(-3px);
        }

    .card-term {
        font-weight: bold;
        color: var(--accent-color);
        font-size: 1.15rem;
        margin-bottom: 12px;
        padding-right: 25px;
    }

    .card-divider {
        height: 1px;
        background: rgba(240, 255, 255, 0.1);
        border: none;
        margin: 10px 0;
    }

    .card-definition {
        opacity: 0.8;
        font-size: 1rem;
        line-height: 1.4;
    }

    .dots {
        position: absolute;
        top: 15px;
        right: 15px;
        cursor: pointer;
        font-size: 1.5rem;
        opacity: 0.5;
        transition: 0.3s;
    }

        .dots:hover {
            opacity: 1;
            color: var(--accent-color);
        }

    .dropdown {
        position: absolute;
        top: 45px;
        right: 15px;
        background: #2C3440;
        border: 1px solid #818375;
        border-radius: 8px;
        display: none;
        flex-direction: column;
        z-index: 100;
        box-shadow: 0 8px 25px rgba(0,0,0,0.6);
    }

        .dropdown button {
            background: none;
            border: none;
            color: white;
            padding: 12px 20px;
            text-align: left;
            cursor: pointer;
            width: 100%;
            font-size: 0.9rem;
        }

            .dropdown button:hover {
                background-color: #6B8789;
            }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.85);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 10000;
    }

    .modal {
        background: #1C2531;
        border: 1px solid var(--accent-color);
        padding: 30px;
        border-radius: 20px;
        width: 420px;
        max-width: 90%;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

        .modal input, .modal textarea, .modal select {
            background: #141B25;
            border: 1px solid #818375;
            color: white;
            padding: 12px;
            border-radius: 10px;
            outline: none;
            font-family: inherit;
            width: 100%;
            box-sizing: border-box;
        }

    .modal-label {
        font-size: 0.85rem;
        opacity: 0.6;
        margin-bottom: 5px;
        display: block;
    }

    .btn-main {
        background: #6B8789;
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
        transition: 0.3s;
    }

        .btn-main:hover {
            background: #7ba1a3;
        }

    @@media (max-width: 950px) {
        .practice-sticky-container {
            top: auto;
            bottom: 30px;
            right: 20px;
        }

        .btn-practice-float {
            padding: 12px 20px;
            font-size: 0.8rem;
        }
    }
</style>

<!-- ПЛАВАЮЧА КНОПКА (Додана на початок) -->
<div class="practice-sticky-container">
    <a asp-controller="Test" asp-action="Map" asp-route-setId="@Model.Id" class="btn-practice-float">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
            <path d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
        ПРАКТИКА
    </a>
</div>

<div class="content-area">
    <a asp-controller="MySets" asp-action="Index" class="back-link">← Назад до моїх сетів</a>

    <div class="header-row">
        <div>
            <h2 style="color: var(--accent-color); margin: 0; font-size: 2.2rem;">@Model.Name</h2>
            <p style="opacity: 0.6; margin: 8px 0 0 0; font-size: 1.1rem;">@Model.Description</p>

            <ul class="categories-list">
                @foreach (var cat in Model.Categories)
                {
                    <li class="category-badge">
                        @cat.Name
                        <form asp-controller="Details" asp-action="RemoveCategory" method="post" style="display:inline;">
                            <input type="hidden" name="setId" value="@Model.Id" />
                            <input type="hidden" name="categoryId" value="@cat.Id" />
                            <button type="submit" class="remove-cat-btn" title="Прибрати">×</button>
                        </form>
                    </li>
                }
            </ul>
        </div>
        <div style="display: flex; gap: 12px;">
            <button class="btn-main" onclick="openCreateCardModal()">+ Картка</button>
            <button class="btn-main" onclick="openCategoryModal()">+ Категорія</button>
        </div>
    </div>

    <div class="cards-grid">
        @foreach (var card in Model.Flashcards)
        {
            <div class="flashcard-item">
                <div class="dots" onclick="toggleMenu(event)">⋮</div>
                <div class="dropdown">
                    <button type="button" onclick="openEditCardModal('@card.Id', '@card.Term', '@card.Definition')">Редагувати</button>
                    <form asp-controller="Details" asp-action="DeleteCard" method="post" onsubmit="return confirm('Видалити картку?')">
                        <input type="hidden" name="cardId" value="@card.Id" />
                        <input type="hidden" name="setId" value="@Model.Id" />
                        <button type="submit" style="color: #ff8080;">Видалити</button>
                    </form>
                </div>

                <div class="card-term">@card.Term</div>
                <hr class="card-divider">
                <div class="card-definition">@card.Definition</div>
            </div>
        }
    </div>
</div>

<!-- МОДАЛКИ (Карток та Категорій) -->
<div class="modal-overlay" id="cardModal">
    <div class="modal">
        <h2 id="modalTitle" style="color: var(--accent-color); margin: 0;">Нова картка</h2>
        <form asp-controller="Details" asp-action="SaveCard" method="post">
            <input type="hidden" name="setId" value="@Model.Id" />
            <input type="hidden" name="cardDto.Id" id="modalCardId" value="0" />
            <div style="display: flex; flex-direction: column; gap: 15px; margin-top: 20px;">
                <div>
                    <label class="modal-label">Питання</label>
                    <input type="text" name="cardDto.Term" id="modalTerm" required>
                </div>
                <div>
                    <label class="modal-label">Відповідь</label>
                    <textarea name="cardDto.Definition" id="modalDefinition" rows="4" required></textarea>
                </div>
                <div style="display: flex; gap: 10px; justify-content: flex-end;">
                    <button type="button" onclick="closeCardModal()" style="background:none; border:none; color:#818375; cursor:pointer;">Скасувати</button>
                    <button type="submit" class="btn-main">Зберегти</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="categoryModal">
    <div class="modal">
        <form asp-controller="Details" asp-action="SaveCategory" method="post">
            <h2 style="color: var(--accent-color); margin: 0 0 10px 0;">Додати категорію</h2>
            <input type="hidden" name="setId" value="@Model.Id" />
            <p style="font-size: 0.85rem; opacity: 0.7; margin-bottom: 10px;">Оберіть категорію зі списку:</p>
            <select name="selectedCategoryId" required>
                <option value="">-- Оберіть --</option>
                @if (ViewBag.AllCategories != null)
                {
                    @foreach (var cat in (IEnumerable<CategoryDTO>)ViewBag.AllCategories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                }
            </select>
            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px;">
                <button type="button" onclick="closeCategoryModal()" style="background:none; border:none; color:#818375; cursor:pointer;">Скасувати</button>
                <button type="submit" class="btn-main">Додати</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const catModal = document.getElementById('categoryModal');
        const cardModal = document.getElementById('cardModal');

        function openCategoryModal() { catModal.style.display = 'flex'; }
        function closeCategoryModal() { catModal.style.display = 'none'; }

        function openCreateCardModal() {
            document.getElementById('modalTitle').innerText = "Нова картка";
            document.getElementById('modalCardId').value = "0";
            document.getElementById('modalTerm').value = "";
            document.getElementById('modalDefinition').value = "";
            cardModal.style.display = 'flex';
        }

        function openEditCardModal(id, term, def) {
            document.getElementById('modalTitle').innerText = "Редагувати картку";
            document.getElementById('modalCardId').value = id;
            document.getElementById('modalTerm').value = term;
            document.getElementById('modalDefinition').value = def;
            cardModal.style.display = 'flex';
        }

        function closeCardModal() { cardModal.style.display = 'none'; }

        function toggleMenu(e) {
            e.stopPropagation();
            const dropdown = e.currentTarget.nextElementSibling;
            document.querySelectorAll('.dropdown').forEach(d => { if (d !== dropdown) d.style.display = 'none'; });
            dropdown.style.display = dropdown.style.display === 'flex' ? 'none' : 'flex';
        }

        window.addEventListener('click', (e) => {
            if (e.target === catModal) closeCategoryModal();
            if (e.target === cardModal) closeCardModal();
            if (!e.target.matches('.dots')) {
                document.querySelectorAll('.dropdown').forEach(d => d.style.display = 'none');
            }
        });
    </script>
}