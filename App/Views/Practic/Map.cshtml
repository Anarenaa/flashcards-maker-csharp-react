@using Core.DTOs.Practice
@model SetProgressDTO
@{
    ViewData["Title"] = "Мапа практики";

    bool isOwner = ViewBag.IsOwner ?? false;
    var collId = Context.Request.Query["collectionId"];
    string source = Context.Request.Query["source"].ToString();
    bool fromColl = !string.IsNullOrEmpty(collId);

    string backUrl;
    string backText;

    if (fromColl)
    {
        backUrl = Url.Action("Details", "Collections", new { id = collId });
        backText = "Назад до колекції";
    }
    else if (isOwner)
    {
        backUrl = Url.Action("Index", "Details", new { id = Model.SetId });
        backText = "Назад до карток";
    }
    else
    {
        backUrl = Url.Action("Sets", "DetailsInMain", new { id = Model.SetId });
        backText = "Назад до перегляду";
    }

    bool IsUnlocked(int mode) => mode switch
    {
        1 => true,
        2 => Model.OverallProgress >= PracticeActivityLimit.ReviewLimit,
        3 => Model.OverallProgress >= PracticeActivityLimit.QuizLimit,
        4 => Model.OverallProgress >= PracticeActivityLimit.MatchingLimit,
        5 => Model.OverallProgress >= PracticeActivityLimit.WritingLimit,
        _ => false
    };

    int[] visibleModes = { 1, 2, 3, 4, 5 };
}

<style>
    .map-page-container {
        max-width: 1100px;
        margin: 40px auto;
        padding: 20px;
        text-align: center;
        animation: fadeIn 0.6s ease;
    }

    .map-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
    }

    .map-page-container .back-link {
        color: var(--accent-color);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        opacity: 0.7;
        font-size: 0.95rem;
        transition: 0.3s;
        background: none;
        border: none;
        cursor: pointer;
    }

        .map-page-container .back-link:hover {
            opacity: 1;
            transform: translateX(-5px);
        }

    .btn-reset-top {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        background: var(--btn-bg);
        border: 1px solid var(--btn-border);
        padding: 10px 20px;
        border-radius: 12px;
        color: white;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        transition: 0.3s;
        cursor: pointer;
    }

        .btn-reset-top:hover {
            background: rgba(255, 100, 100, 0.1);
            border-color: #ff6b6b;
            transform: translateY(-2px);
        }

    .reset-icon-bg {
        width: 26px;
        height: 26px;
        background: #ff6b6b;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        flex-shrink: 0;
    }

    .map-page-container .progress-header h2 {
        color: var(--text-color);
        opacity: 0.8;
        margin: 0;
        font-size: 2.2rem;
    }

    .map-page-container .percentage {
        font-size: 6rem;
        font-weight: 900;
        color: var(--accent-color);
        line-height: 1;
        margin: 15px 0;
    }

    .map-page-container .roadmap {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 80px;
        flex-wrap: wrap;
    }

    .map-page-container .node {
        display: flex;
        align-items: center;
        position: relative;
        margin-bottom: 60px;
    }

    .map-page-container .circle {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 0.85rem;
        text-decoration: none;
        transition: 0.4s;
        z-index: 2;
        border: 4px solid transparent;
        text-align: center;
        padding: 10px;
    }

    .map-page-container .unlocked {
        background: var(--accent-color);
        color: var(--bg-color) !important;
        box-shadow: 0 0 30px rgba(0,0,0,0.3);
    }

    .map-page-container .locked {
        background: var(--btn-bg);
        color: var(--text-color) !important;
        opacity: 0.4;
        border-color: var(--btn-border);
    }

    .map-page-container .line {
        width: 60px;
        height: 4px;
        background: var(--btn-border);
        z-index: 1;
    }

        .map-page-container .line.active {
            background: var(--accent-color);
            opacity: 0.6;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
        }
    }
</style>

<div class="map-page-container">
    <div class="map-top-bar">
        <a href="@backUrl" class="back-link">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path d="M19 12H5M12 19l-7-7 7-7"></path>
            </svg>
            @backText
        </a>

        <button onclick="handleResetProgress(@Model.SetId)" class="btn-reset-top">
            <span>Скинути прогрес</span>
            <div class="reset-icon-bg">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M16 9v10H8V9h8m-1.5-6h-5l-1 1H5v2h14V4h-3.5l-1-1zM18 7H6v12c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7z"></path>
                </svg>
            </div>
        </button>
    </div>

    <div class="progress-header">
        <h2>@ViewBag.SetName</h2>
        <div class="percentage">@((Model.OverallProgress * 100).ToString("0"))%</div>
        <p style="opacity: 0.5;">Рівень володіння набором</p>
    </div>

    <div class="roadmap">
        @for (int i = 0; i < visibleModes.Length; i++)
        {
            var modeId = visibleModes[i];
            var unlocked = IsUnlocked(modeId);
            bool nextWillBeUnlocked = (i < visibleModes.Length - 1) && IsUnlocked(visibleModes[i + 1]);

            <div class="node">
                @if (unlocked)
                {
                    <a asp-controller="Test" asp-action="Index" asp-route-setId="@Model.SetId" asp-route-mode="@modeId" class="circle unlocked">
                        @GetModeName(modeId)
                    </a>
                }
                else
                {
                    <div class="circle locked">
                        @GetModeName(modeId)
                        <div style="position: absolute; bottom: -35px; font-size: 0.7rem; opacity: 0.8; white-space:nowrap;">🔒 Заблоковано</div>
                    </div>
                }

                @if (i < visibleModes.Length - 1)
                {
                    <div class="line @(nextWillBeUnlocked ? "active" : "")"></div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        async function handleResetProgress(setId) {
            if (!confirm("Ви впевнені? Це обнулить увесь ваш прогрес навчання для цього сету!")) return;

            try {
                const response = await fetch(`/Test/ResetProgress?setId=${setId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                if (response.ok) {
                    location.reload();
                } else {
                    alert("Не вдалося скинути прогрес.");
                }
            } catch (e) {
                console.error(e);
                alert("Помилка мережі.");
            }
        }
    </script>
}

@functions {
    string GetModeName(int mode) => mode switch
    {
        1 => "Флеш картки",
        2 => "Вікторина",
        3 => "З'єднання",
        4 => "Письмо",
        5 => "Mixed-режим",
        _ => ""
    };
}