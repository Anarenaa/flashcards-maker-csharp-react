@using Core.DTOs.Practice
@model PracticeSessionDTO

<style>
    :root {
        --success-color: #28a745;
        --error-color: #dc3545;
        --practice-gradient: linear-gradient(135deg, #6e8efb, #a777e3);
        --accent-color: #6e8efb;
    }

    .practice-page {
        max-width: 900px;
        margin: 40px auto;
        text-align: center;
        perspective: 1000px;
        position: relative;
    }

    .progress-container {
        width: 100%;
        height: 12px;
        background: rgba(255,255,255,0.05);
        border-radius: 20px;
        margin-bottom: 25px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .p-bar-fill {
        height: 100%;
        background: var(--practice-gradient);
        width: 0%;
        transition: 0.6s cubic-bezier(0.17, 0.67, 0.83, 0.67);
    }

    #card-counter {
        opacity: 0.5;
        margin-bottom: 15px;
        font-size: 0.9rem;
    }

    .flashcard {
        width: 100%;
        height: 420px;
        cursor: pointer;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        margin-bottom: 30px;
    }

        .flashcard.is-flipped {
            transform: rotateY(180deg);
        }

    .card-face {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 40px;
        border-radius: 30px;
        border: 2px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(20px);
        box-shadow: 0 25px 50px rgba(0,0,0,0.3);
    }

    .card-back {
        transform: rotateY(180deg);
        background: rgba(255, 255, 255, 0.05);
    }

    .term-text {
        font-size: 2.8rem;
        font-weight: 800;
        color: var(--accent-color);
        margin-bottom: 20px;
    }

    .def-text {
        font-size: 1.8rem;
        color: #fff;
    }

    .matching-wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        margin-top: 40px;
    }

    .matching-column {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .matching-item {
        background: rgba(255, 255, 255, 0.05);
        border: 2px solid rgba(255,255,255,0.1);
        color: #fff;
        padding: 18px;
        border-radius: 15px;
        cursor: pointer;
        min-height: 75px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        transition: all 0.3s ease;
        user-select: none;
    }

        .matching-item.selected {
            border-color: var(--accent-color);
            background: rgba(110, 142, 251, 0.2);
        }

        .matching-item.correct-flash {
            background: var(--success-color) !important;
            border-color: var(--success-color) !important;
        }

        .matching-item.wrong-flash {
            background: var(--error-color) !important;
            border-color: var(--error-color) !important;
            animation: shake 0.4s ease;
        }

        .matching-item.matched-hidden {
            opacity: 0;
            transform: scale(0.9);
            pointer-events: none;
        }

    @@keyframes shake {
        0%, 100% {
            transform: translateX(0);
        }

        25% {
            transform: translateX(-5px);
        }

        75% {
            transform: translateX(5px);
        }
    }

    .btn-practice-main {
        background: var(--practice-gradient);
        color: white;
        border: none;
        padding: 18px 35px;
        border-radius: 20px;
        font-weight: 800;
        cursor: pointer;
        text-transform: uppercase;
    }

    .btn-practice-outline {
        background: transparent;
        border: 2px solid rgba(255,255,255,0.1);
        color: white;
        padding: 16px 30px;
        border-radius: 20px;
        cursor: pointer;
    }

    .summary-card {
        background: rgba(255,255,255,0.05);
        padding: 60px 40px;
        border-radius: 40px;
        display: none;
        backdrop-filter: blur(20px);
    }
</style>

<div class="practice-page">
    <div id="topPanel">
        <div class="progress-container"><div id="p-bar" class="p-bar-fill"></div></div>
        <div id="card-counter">0 / 0</div>
    </div>

    <div id="standardZone" style="display:none">
        <div class="flashcard" id="mainCard">
            <div class="card-face card-front">
                <div id="frontText" class="term-text"></div>
                <div id="quizOptions" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 20px; width: 100%;"></div>
            </div>
            <div class="card-face card-back"><div id="backText" class="def-text"></div></div>
        </div>
    </div>

    <div id="matchingZone" class="matching-wrapper" style="display: none;"></div>

    <div id="inputZone" style="display: none; background: rgba(255,255,255,0.03); padding: 50px; border-radius: 30px;">
        <div id="writingPrompt" class="term-text"></div>
        <input type="text" id="simpleInput" autocomplete="off" style="width: 100%; background: rgba(255,255,255,0.05); border: 2px solid rgba(255,255,255,0.1); border-radius: 15px; padding: 18px; color: white; font-size: 1.4rem; text-align: center;">
        <div id="inputFeedback" style="display:none; margin-top:15px; color:var(--error-color);">Правильно: <span id="correctVal" style="color:white;"></span></div>
    </div>

    <div id="summaryZone" class="summary-card">
        <div style="font-size: 60px; margin-bottom: 20px;">🎉</div>
        <h2>Завершено!</h2>
        <p id="summaryStat" style="opacity: 0.7; margin-bottom: 35px;"></p>
        <div style="display: flex; flex-direction: column; gap: 15px; max-width: 350px; margin: 0 auto;">
            <button onclick="retryIncorrect()" id="retryWrongBtn" class="btn-practice-outline" style="color: #ff4d4d; display: none;">Повторити помилки</button>
            <button onclick="retryAll()" class="btn-practice-main">Пройти ще раз</button>
            <button onclick="location.href='/Test/Map/@Model.SetId'" class="btn-practice-outline">До мапи</button>
        </div>
    </div>

    <div class="navigation-zone" id="navZone" style="display: none; justify-content: center; gap: 40px; margin-top: 30px;">
        <button class="btn-circle" style="width:60px; height:60px; border-radius:50%; background:rgba(255,255,255,0.1); color:white; border:none; cursor:pointer;" onclick="prevCard()">←</button>
        <button class="btn-circle" style="width:60px; height:60px; border-radius:50%; background:rgba(255,255,255,0.1); color:white; border:none; cursor:pointer;" onclick="nextManual()">→</button>
    </div>
</div>

@section Scripts {
    <script>
        const rawData = @Json.Serialize(Model.Flashcards);
        const setId = @Model.SetId;
        const globalMode = @((int)Model.SelectedActivity);
        const batchSizeLimit = @(Model.BatchSize > 0 ? Model.BatchSize : 5);

        let flashcards = [];
        let currentIndex = 0;
        let resultsData = { Results: [], IsTrainingMode: false, SetId: setId };
        let wrongIds = new Set();
        let startTime = Date.now();

        const getVal = (obj, prop) => obj[prop.charAt(0).toLowerCase() + prop.slice(1)] || obj[prop];
        function shuffle(arr) { return [...arr].sort(() => Math.random() - 0.5); }

        function init(cards) {
            let taskList = [];
            const raw = JSON.parse(JSON.stringify(cards));

            if (globalMode === 6) {
                raw.forEach(c => { let t = {...c}; t.assignedMode = 2; taskList.push(t); });

                raw.forEach(c => { let t = {...c}; t.assignedMode = 4; taskList.push(t); });

                let forMatch = shuffle([...raw]);
                for (let i = 0; i < forMatch.length; i += 4) {
                    let batch = forMatch.slice(i, i + 4);
                    batch.forEach(c => { let t = {...c}; t.assignedMode = 3; taskList.push(t); });
                }

                flashcards = shuffle(taskList);
            } else {
                flashcards = shuffle(raw);
                flashcards.forEach(c => c.assignedMode = globalMode || 1);
            }

            currentIndex = 0;
            wrongIds.clear();
            resultsData.Results = [];
            document.getElementById('retryWrongBtn').style.display = 'none';
            render();
        }

        function render() {
            if (currentIndex >= flashcards.length) { finish(); return; }

            const card = flashcards[currentIndex];
            const mode = card.assignedMode;

            document.getElementById('topPanel').style.display = 'block';
            ['standardZone', 'matchingZone', 'inputZone', 'navZone', 'summaryZone'].forEach(id => document.getElementById(id).style.display = 'none');

            document.getElementById('card-counter').innerText = `${currentIndex + 1} / ${flashcards.length}`;
            document.getElementById('p-bar').style.width = `${(currentIndex / flashcards.length) * 100}%`;

            startTime = Date.now();

            if (mode === 3) renderMatching();
            else if (mode === 4) renderWriting();
            else if (mode === 2) renderQuiz();
            else renderReview();
        }

        function renderReview() {
            const card = flashcards[currentIndex];
            document.getElementById('standardZone').style.display = 'block';
            document.getElementById('navZone').style.display = 'flex';
            document.getElementById('quizOptions').style.display = 'none';
            const cardEl = document.getElementById('mainCard');
            cardEl.classList.remove('is-flipped');
            document.getElementById('frontText').innerText = getVal(card, 'Term');
            document.getElementById('backText').innerText = getVal(card, 'Definition');
            cardEl.onclick = () => {
                cardEl.classList.toggle('is-flipped');
                saveStep(getVal(card, 'Id'), true, 1);
            };
        }

        function renderQuiz() {
            const card = flashcards[currentIndex];
            document.getElementById('standardZone').style.display = 'block';
            const optsBox = document.getElementById('quizOptions');
            optsBox.innerHTML = ''; optsBox.style.display = 'grid';
            document.getElementById('mainCard').classList.remove('is-flipped');
            document.getElementById('mainCard').onclick = null;
            document.getElementById('frontText').innerText = getVal(card, 'Term');

            const correct = getVal(card, 'Definition');
            let options = shuffle([correct, ...shuffle(rawData.filter(c => getVal(c, 'Id') !== getVal(card, 'Id')).map(c => getVal(c, 'Definition'))).slice(0, 3)]);

            options.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = 'btn-practice-outline';
                btn.innerText = opt;
                btn.onclick = () => {
                    const isCorrect = opt === correct;
                    btn.style.background = isCorrect ? 'var(--success-color)' : 'var(--error-color)';
                    if(!isCorrect) wrongIds.add(getVal(card, 'Id'));
                    saveStep(getVal(card, 'Id'), isCorrect, 2);
                    setTimeout(nextManual, 600);
                };
                optsBox.appendChild(btn);
            });
        }

        function renderWriting() {
            const card = flashcards[currentIndex];
            document.getElementById('inputZone').style.display = 'block';
            const input = document.getElementById('simpleInput');
            const feedback = document.getElementById('inputFeedback');
            feedback.style.display = 'none';
            input.value = ''; input.disabled = false; input.style.borderColor = '';
            document.getElementById('writingPrompt').innerText = getVal(card, 'Definition');
            input.focus();

            input.onkeypress = (e) => {
                if (e.key === 'Enter') {
                    const isCorrect = input.value.trim().toLowerCase() === getVal(card, 'Term').toLowerCase();
                    input.disabled = true;
                    input.style.borderColor = isCorrect ? 'var(--success-color)' : 'var(--error-color)';
                    saveStep(getVal(card, 'Id'), isCorrect, 4);
                    if (!isCorrect) {
                        wrongIds.add(getVal(card, 'Id'));
                        document.getElementById('correctVal').innerText = getVal(card, 'Term');
                        feedback.style.display = 'block';
                        setTimeout(nextManual, 1500);
                    } else setTimeout(nextManual, 600);
                }
            };
        }

        function renderMatching() {
            const zone = document.getElementById('matchingZone');
            zone.innerHTML = ''; zone.style.display = 'grid';

            let batch = [];
            for (let i = currentIndex; i < flashcards.length; i++) {
                const c = flashcards[i];
                if (c.assignedMode === 3 && batch.length < batchSizeLimit) batch.push(c);
                else break;
            }
            if(batch.length < 2 && rawData.length > 2) {
                let extra = rawData.find(r => getVal(r, 'Id') !== getVal(batch[0], 'Id'));
                batch.push(extra);
            }

            let sT = null, sD = null, matches = 0;
            const terms = shuffle(batch.map(c => ({ id: getVal(c, 'Id'), text: getVal(c, 'Term'), type: 't' })));
            const defs = shuffle(batch.map(c => ({ id: getVal(c, 'Id'), text: getVal(c, 'Definition'), type: 'd' })));

            const createItem = (item) => {
                const div = document.createElement('div');
                div.className = 'matching-item';
                div.innerText = item.text;
                div.dataset.id = item.id;
                div.onclick = () => {
                    if (div.classList.contains('matched-hidden') || div.classList.contains('correct-flash')) return;
                    if (item.type === 't') { if(sT) sT.classList.remove('selected'); sT = div; }
                    else { if(sD) sD.classList.remove('selected'); sD = div; }
                    div.classList.add('selected');
                    if (sT && sD) {
                        const isMatch = sT.dataset.id === sD.dataset.id;
                        const t = sT, d = sD;
                        if (isMatch) {
                            t.className = 'matching-item correct-flash'; d.className = 'matching-item correct-flash';
                            saveStep(parseInt(t.dataset.id), true, 3);
                            matches++; sT = null; sD = null;
                            setTimeout(() => {
                                t.classList.add('matched-hidden'); d.classList.add('matched-hidden');
                                if (matches === batch.length) { currentIndex += batch.length; render(); }
                            }, 600);
                        } else {
                            t.className = 'matching-item wrong-flash'; d.className = 'matching-item wrong-flash';
                            saveResultManually(parseInt(t.dataset.id), false, 3);
                            wrongIds.add(parseInt(t.dataset.id));
                            sT = null; sD = null;
                            setTimeout(() => { t.classList.remove('wrong-flash', 'selected'); d.classList.remove('wrong-flash', 'selected'); }, 600);
                        }
                    }
                };
                return div;
            };

            const leftCol = document.createElement('div'); leftCol.className = 'matching-column';
            const rightCol = document.createElement('div'); rightCol.className = 'matching-column';
            terms.forEach(t => leftCol.appendChild(createItem(t)));
            defs.forEach(d => rightCol.appendChild(createItem(d)));
            zone.appendChild(leftCol); zone.appendChild(rightCol);
        }

        function saveStep(id, correct, mode) {
            const time = Date.now() - startTime;
            const idx = resultsData.Results.findIndex(r => r.FlashcardId === id);
            if (idx > -1) {
                resultsData.Results[idx].IsCorrect = correct;
                resultsData.Results[idx].ResponseTimeMs = time;
                resultsData.Results[idx].ReviewType = mode;
            } else resultsData.Results.push({ FlashcardId: id, IsCorrect: correct, ResponseTimeMs: time, ReviewType: mode });
        }

        function saveResultManually(id, correct, mode) { saveStep(id, correct, mode); }

        function nextManual() { currentIndex++; render(); }
        function prevCard() { if (currentIndex > 0) { currentIndex--; render(); } }

        async function finish() {
            document.getElementById('p-bar').style.width = '100%';
            document.getElementById('topPanel').style.display = 'none';
            ['standardZone', 'matchingZone', 'inputZone', 'navZone'].forEach(id => document.getElementById(id).style.display = 'none');
            document.getElementById('summaryZone').style.display = 'block';
            document.getElementById('summaryStat').innerText = `Прогрес збережено. Помилок: ${wrongIds.size}`;
            if (wrongIds.size > 0) document.getElementById('retryWrongBtn').style.display = 'block';

            await fetch('/Test/SaveResults', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(resultsData)
            });
        }

        function retryAll() { init(shuffle(rawData)); }
        function retryIncorrect() {
            const failed = rawData.filter(c => wrongIds.has(getVal(c, 'Id')));
            init(shuffle(failed));
        }

        init(rawData);
    </script>
}