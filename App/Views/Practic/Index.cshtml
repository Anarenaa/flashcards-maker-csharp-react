@using Core.DTOs.Practice
@model PracticeSessionDTO

<style>
    .practice-page {
        max-width: 800px;
        margin: 40px auto;
        text-align: center;
        perspective: 1000px;
    }

    .timer-container {
        width: 100%;
        height: 4px;
        background: rgba(255,255,255,0.1);
        margin-bottom: 10px;
        border-radius: 2px;
        overflow: hidden;
        visibility: hidden;
    }

    .timer-bar {
        height: 100%;
        background: #ffbd44;
        width: 100%;
    }

    .flashcard {
        width: 100%;
        height: 400px;
        cursor: pointer;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        margin-bottom: 30px;
    }

        .flashcard.is-flipped {
            transform: rotateY(180deg);
        }

    .card-face {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 40px;
        border-radius: 30px;
        border: 2px solid var(--btn-border);
        background: var(--btn-bg);
        backdrop-filter: blur(15px);
        box-shadow: 0 20px 50px rgba(0,0,0,0.3);
    }

    .card-back {
        transform: rotateY(180deg);
        background: rgba(255, 255, 255, 0.05);
    }

    .term-text {
        font-size: 3rem;
        font-weight: 800;
        color: var(--accent-color);
    }

    .def-text {
        font-size: 2rem;
        color: #fff;
    }

    .navigation-zone {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        min-height: 60px;
    }

    .btn-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: var(--btn-bg);
        border: 1px solid var(--btn-border);
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.3s;
    }

        .btn-circle:hover:not(:disabled) {
            border-color: var(--accent-color);
            background: var(--btn-hover);
        }

        .btn-circle:disabled {
            opacity: 0.1;
            cursor: not-allowed;
        }

    .btn-choice {
        padding: 12px 35px;
        border-radius: 12px;
        border: none;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
    }

    .btn-again {
        background: rgba(255, 100, 100, 0.1);
        color: #ff6464;
        border: 1px solid #ff6464;
    }

    .btn-know {
        background: var(--accent-color);
        color: #141B25;
    }

    .progress-container {
        width: 100%;
        height: 6px;
        background: rgba(255,255,255,0.1);
        border-radius: 3px;
        margin-bottom: 20px;
        overflow: hidden;
    }

    .p-bar-fill {
        height: 100%;
        background: var(--accent-color);
        width: 0%;
        transition: 0.5s;
    }
</style>

<div class="practice-page">
    <div class="progress-container">
        <div id="p-bar" class="p-bar-fill"></div>
    </div>

    <div class="timer-container" id="timerBox">
        <div class="timer-bar" id="timerBar"></div>
    </div>

    <div id="card-counter" style="opacity: 0.5; margin-bottom: 10px;">Завантаження...</div>

    <div class="flashcard" id="mainCard" onclick="flipCard()">
        <div class="card-face card-front">
            <div id="frontText" class="term-text"></div>
            <div style="opacity: 0.4; font-size: 0.8rem; margin-top: 15px; text-transform: uppercase;">Натисніть, щоб перевернути</div>
        </div>
        <div class="card-face card-back">
            <div id="backText" class="def-text"></div>
        </div>
    </div>

    <div class="navigation-zone">
        <button class="btn-circle" id="prevBtn" onclick="prevCard()" title="Назад">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"></path></svg>
        </button>

        <div id="controlButtons" style="display: flex; gap: 15px; visibility: hidden;">
            <button class="btn-choice btn-again" onclick="submitResult(false)">Ще раз</button>
            <button class="btn-choice btn-know" onclick="submitResult(true)">Знаю</button>
        </div>

        <button class="btn-circle" id="nextBtn" onclick="nextManual()" title="Вперед">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"></path></svg>
        </button>
    </div>
</div>

@section Scripts {
    <script>
        const session = @Json.Serialize(Model);
        const currentProgress = @(ViewBag.CurrentProgress != null ? ViewBag.CurrentProgress.ToString().Replace(",", ".") : "0");
        const mode = @(ViewBag.Mode ?? 1);

        let currentIndex = 0;
        let autoFlipTimeout = null;
        let practiceResults = { results: [], isTrainingMode: false };

        const modeLimits = { 1: 0.15, 2: 0.35, 3: 0.55, 4: 0.75, 5: 0.90, 6: 1.0 };
        const myLimit = modeLimits[mode] || 1.0;

        function render() {
            stopTimer();
            const flashcards = session.flashcards || session.Flashcards;
            const total = session.totalCards || session.TotalCards;

            if (!flashcards || !flashcards[currentIndex]) return;

            const card = flashcards[currentIndex];
            const cardEl = document.getElementById('mainCard');
            const controls = document.getElementById('controlButtons');

            cardEl.classList.remove('is-flipped');
            controls.style.visibility = 'hidden';

            document.getElementById('frontText').innerText = card.term || card.Term;
            document.getElementById('backText').innerText = card.definition || card.Definition;

            document.getElementById('card-counter').innerText = `Картка ${currentIndex + 1} із ${total}`;
            document.getElementById('p-bar').style.width = ((currentIndex + 1) / total * 100) + '%';

            document.getElementById('prevBtn').disabled = currentIndex === 0;
        }

        function flipCard() {
            const cardEl = document.getElementById('mainCard');
            const controls = document.getElementById('controlButtons');
            if (cardEl.classList.contains('is-flipped')) return;

            cardEl.classList.add('is-flipped');
            controls.style.visibility = 'visible';
            startTimer();
        }

        function startTimer() {
            const timerBox = document.getElementById('timerBox');
            const timerBar = document.getElementById('timerBar');

            timerBox.style.visibility = 'visible';
            timerBar.style.transition = 'none';
            timerBar.style.width = '100%';

            setTimeout(() => {
                timerBar.style.transition = 'width 5s linear';
                timerBar.style.width = '0%';
            }, 50);

            autoFlipTimeout = setTimeout(() => {
                const cardEl = document.getElementById('mainCard');
                cardEl.classList.remove('is-flipped');
                timerBox.style.visibility = 'hidden';
            }, 5000);
        }

        function stopTimer() {
            clearTimeout(autoFlipTimeout);
            const timerBox = document.getElementById('timerBox');
            if(timerBox) timerBox.style.visibility = 'hidden';
        }

        function nextManual() {
            const flashcards = session.flashcards || session.Flashcards;
            if (currentIndex < flashcards.length - 1) {
                currentIndex++;
                render();
            } else {
                finishSession();
            }
        }

        function prevCard() {
            if (currentIndex > 0) {
                currentIndex--;
                render();
            }
        }

        async function submitResult(isKnown) {
            const flashcards = session.flashcards || session.Flashcards;
            const currentCard = flashcards[currentIndex];

            if (isKnown === true && currentProgress < myLimit) {
                const alreadyAdded = practiceResults.results.some(r => r.flashcardId === (currentCard.id || currentCard.Id));

                if (!alreadyAdded) {
                    practiceResults.results.push({
                        flashcardId: currentCard.id || currentCard.Id,
                        isCorrect: true,
                        responseTimeMs: 0,
                        reviewType: mode
                    });
                }
            }

            nextManual();
        }

        async function finishSession() {
            if (practiceResults.results.length === 0) {
                const setId = session.setId || session.SetId;
                window.location.href = `/Test/Map/${setId}`;
                return;
            }

            try {
                const res = await fetch('/Test/SaveResults', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(practiceResults)
                });
                const data = await res.json();
                window.location.href = data.redirectUrl;
            } catch (e) {
                window.location.href = '/Main';
            }
        }

        
        render();
    </script>
}