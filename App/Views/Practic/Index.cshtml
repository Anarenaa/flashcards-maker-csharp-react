@using Core.DTOs.Practice
@model PracticeSessionDTO

<style>
    :root {
        --success-color: #28a745;
        --error-color: #dc3545;
        --practice-gradient: linear-gradient(135deg, #6e8efb, #a777e3);
        --accent-color: #6e8efb;
    }

    .practice-page {
        max-width: 900px;
        margin: 40px auto;
        text-align: center;
        perspective: 1000px;
        position: relative;
    }

    /* ВЕРХНЯ ПАНЕЛЬ */
    .progress-container {
        width: 100%;
        height: 12px;
        background: rgba(255,255,255,0.05);
        border-radius: 20px;
        margin-bottom: 25px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .p-bar-fill {
        height: 100%;
        background: var(--practice-gradient);
        width: 0%;
        transition: 0.6s cubic-bezier(0.17, 0.67, 0.83, 0.67);
    }

    #card-counter {
        opacity: 0.5;
        margin-bottom: 15px;
        font-size: 0.9rem;
    }

    /* КАРТКИ (FLASHCARDS / QUIZ) */
    .flashcard {
        width: 100%;
        height: 420px;
        cursor: pointer;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        margin-bottom: 30px;
    }

        .flashcard.is-flipped {
            transform: rotateY(180deg);
        }

    .card-face {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 40px;
        border-radius: 30px;
        border: 2px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(20px);
        box-shadow: 0 25px 50px rgba(0,0,0,0.3);
    }

    .card-back {
        transform: rotateY(180deg);
        background: rgba(255, 255, 255, 0.05);
    }

    .term-text {
        font-size: 2.8rem;
        font-weight: 800;
        color: var(--accent-color);
        margin-bottom: 20px;
    }

    .def-text {
        font-size: 1.8rem;
        color: #fff;
    }

    /* MATCHING (З'ЄДНАННЯ) */
    .matching-wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        margin-top: 40px; /* Трохи більше відступу, бо зверху немає панелі */
    }

    .matching-column {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .matching-item {
        background: rgba(255, 255, 255, 0.05);
        border: 2px solid rgba(255,255,255,0.1);
        color: #fff;
        padding: 18px;
        border-radius: 15px;
        cursor: pointer;
        min-height: 75px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        transition: all 0.3s ease;
        user-select: none;
    }

        .matching-item:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
        }

        .matching-item.selected {
            border-color: var(--accent-color);
            background: rgba(110, 142, 251, 0.2);
        }

        .matching-item.correct-flash {
            background: var(--success-color) !important;
            border-color: var(--success-color) !important;
            color: white !important;
        }

        .matching-item.wrong-flash {
            background: var(--error-color) !important;
            border-color: var(--error-color) !important;
            animation: shake 0.4s ease;
        }

        .matching-item.matched-hidden {
            opacity: 0;
            transform: scale(0.9);
            pointer-events: none;
        }

    @@keyframes shake {
        0%, 100% {
            transform: translateX(0);
        }

        25% {
            transform: translateX(-5px);
        }

        75% {
            transform: translateX(5px);
        }
    }

    /* КНОПКИ */
    .btn-practice-main {
        background: var(--practice-gradient);
        color: white;
        border: none;
        padding: 18px 35px;
        border-radius: 20px;
        font-weight: 800;
        cursor: pointer;
        transition: 0.3s;
        text-transform: uppercase;
    }

        .btn-practice-main:hover {
            transform: translateY(-3px);
            filter: brightness(1.1);
        }

    .btn-practice-outline {
        background: transparent;
        border: 2px solid rgba(255,255,255,0.1);
        color: white;
        padding: 16px 30px;
        border-radius: 20px;
        cursor: pointer;
    }

    .summary-card {
        background: rgba(255,255,255,0.05);
        padding: 60px 40px;
        border-radius: 40px;
        display: none;
        backdrop-filter: blur(20px);
    }
</style>

<div class="practice-page">
    <div class="exit-container" style="position: absolute; top: -45px; left: 0;">
        <button onclick="exitToMap()" class="btn-exit" style="background:none; border:none; color:white; opacity:0.6; cursor:pointer; display:flex; align-items:center; gap:5px;">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7"></path></svg>
            До мапи
        </button>
    </div>

    <!-- Верхня панель (ховається в Matching) -->
    <div id="topPanel">
        <div class="progress-container"><div id="p-bar" class="p-bar-fill"></div></div>
        <div id="card-counter">Завантаження...</div>
    </div>

    <!-- Режими -->
    <div id="standardZone" style="display:none">
        <div class="flashcard" id="mainCard">
            <div class="card-face card-front">
                <div id="frontText" class="term-text"></div>
                <div id="quizOptions" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 20px; width: 100%;"></div>
            </div>
            <div class="card-face card-back"><div id="backText" class="def-text"></div></div>
        </div>
    </div>

    <div id="matchingZone" class="matching-wrapper" style="display: none;"></div>

    <div id="inputZone" style="display: none; background: rgba(255,255,255,0.03); padding: 50px; border-radius: 30px;">
        <div id="writingPrompt" class="term-text"></div>
        <input type="text" id="simpleInput" style="width: 100%; background: rgba(255,255,255,0.05); border: 2px solid rgba(255,255,255,0.1); border-radius: 15px; padding: 18px; color: white; font-size: 1.4rem; text-align: center;" placeholder="Введіть переклад...">
        <div id="inputFeedback" style="display:none; margin-top:15px; color:var(--success-color);">Правильно: <span id="correctVal" style="color:white;"></span></div>
    </div>

    <div id="summaryZone" class="summary-card">
        <div style="font-size: 60px; margin-bottom: 20px;">🎉</div>
        <h2 id="summaryTitle">Завершено!</h2>
        <p id="summaryStat" style="opacity: 0.7; margin-bottom: 35px;"></p>
        <div style="display: flex; flex-direction: column; gap: 15px; max-width: 350px; margin: 0 auto;">
            <button onclick="retryIncorrect()" id="retryWrongBtn" class="btn-practice-outline" style="color: #ff4d4d; display: none;">Повторити помилки</button>
            <button onclick="retryAll()" class="btn-practice-main">Пройти ще раз</button>
            <button onclick="location.href='/Test/Map/@Model.SetId'" class="btn-practice-outline">До мапи</button>
        </div>
    </div>

    <div class="navigation-zone" id="navZone" style="display: flex; justify-content: center; gap: 40px; margin-top: 30px;">
        <button class="btn-circle" style="width:60px; height:60px; border-radius:50%; background:rgba(255,255,255,0.1); color:white; border:none; cursor:pointer;" onclick="prevCard()">←</button>
        <button class="btn-circle" style="width:60px; height:60px; border-radius:50%; background:rgba(255,255,255,0.1); color:white; border:none; cursor:pointer;" onclick="nextManual()">→</button>
    </div>
</div>

@section Scripts {
    <script>
        const originalCards = @Json.Serialize(Model.Flashcards);
        const globalMode = parseInt("@(ViewBag.Mode ?? 1)");
        const setId = @Model.SetId;

        let flashcards = [...originalCards];
        let currentIndex = 0, cardViews = {}, practiceResults = { results: [] }, wrongFlashcardIds = new Set();
        let matchingBatchIndex = 0, MATCHING_LIMIT = 5;

        function shuffle(arr) { return arr.sort(() => Math.random() - 0.5); }
        if (globalMode >= 2) shuffle(flashcards);

        flashcards.forEach(c => c.assignedMode = (globalMode === 6) ? (Math.floor(Math.random() * 3) + 2) : globalMode);

        function render() {
            const card = flashcards[currentIndex];
            const currentCardMode = card ? card.assignedMode : globalMode;

            if (currentCardMode !== 3 && currentIndex >= flashcards.length) { showSummary(); return; }

            // Логіка приховування верхньої панелі
            const topPanel = document.getElementById('topPanel');
            if (currentCardMode === 3) {
                topPanel.style.display = 'none';
            } else {
                topPanel.style.display = 'block';
                document.getElementById('card-counter').innerText = `Картка ${currentIndex+1} з ${flashcards.length}`;
                document.getElementById('p-bar').style.width = ((currentIndex+1)/flashcards.length*100)+'%';
            }

            document.getElementById('standardZone').style.display = 'none';
            document.getElementById('matchingZone').style.display = 'none';
            document.getElementById('inputZone').style.display = 'none';
            document.getElementById('summaryZone').style.display = 'none';
            document.getElementById('navZone').style.display = (currentCardMode === 1) ? 'flex' : 'none';

            if (currentCardMode === 3) {
                renderMatching();
            } else if (currentCardMode === 4) {
                renderWriting();
            } else {
                renderStandard(currentCardMode);
            }
        }

        // --- MATCHING ---
        let sT = null, sD = null, mCount = 0;
        function renderMatching() {
            const zone = document.getElementById('matchingZone');
            zone.innerHTML = ''; zone.style.display = 'grid';
            mCount = 0; sT = null; sD = null;

            let start = matchingBatchIndex * MATCHING_LIMIT;
            let batch = flashcards.slice(start, start + MATCHING_LIMIT);
            if (!batch.length) { showSummary(); return; }

            const leftCol = document.createElement('div'); leftCol.className = 'matching-column';
            const rightCol = document.createElement('div'); rightCol.className = 'matching-column';

            let terms = shuffle(batch.map(f => ({ id: f.id || f.Id, text: f.term || f.Term, type: 't' })));
            let defs = shuffle(batch.map(f => ({ id: f.id || f.Id, text: f.definition || f.Definition, type: 'd' })));

            terms.forEach(item => leftCol.appendChild(createMatchBtn(item)));
            defs.forEach(item => rightCol.appendChild(createMatchBtn(item)));

            zone.appendChild(leftCol);
            zone.appendChild(rightCol);
        }

        function createMatchBtn(item) {
            const div = document.createElement('div');
            div.className = 'matching-item';
            div.innerText = item.text;
            div.dataset.id = item.id;
            div.onclick = () => {
                if (div.classList.contains('matched-hidden') || div.classList.contains('correct-flash')) return;
                if (item.type === 't') { if (sT) sT.classList.remove('selected'); sT = div; }
                else { if (sD) sD.classList.remove('selected'); sD = div; }
                div.classList.add('selected');
                if (sT && sD) {
                    const first = sT, second = sD;
                    if (first.dataset.id === second.dataset.id) {
                        first.classList.add('correct-flash'); second.classList.add('correct-flash');
                        saveResult(parseInt(first.dataset.id), true);
                        mCount++; sT = null; sD = null;
                        setTimeout(() => {
                            first.classList.add('matched-hidden'); second.classList.add('matched-hidden');
                            if (mCount === Math.min(MATCHING_LIMIT, flashcards.length - (matchingBatchIndex * MATCHING_LIMIT))) {
                                matchingBatchIndex++; setTimeout(render, 400);
                            }
                        }, 600);
                    } else {
                        first.classList.add('wrong-flash'); second.classList.add('wrong-flash');
                        saveResult(parseInt(first.dataset.id), false);
                        wrongFlashcardIds.add(parseInt(first.dataset.id));
                        sT = null; sD = null;
                        setTimeout(() => { first.classList.remove('wrong-flash', 'selected'); second.classList.remove('wrong-flash', 'selected'); }, 600);
                    }
                }
            };
            return div;
        }

        // --- QUIZ & FLASH ---
        function renderStandard(cMode) {
            document.getElementById('standardZone').style.display = 'block';
            const card = flashcards[currentIndex];
            const cardEl = document.getElementById('mainCard');
            const optsBox = document.getElementById('quizOptions');
            cardEl.classList.remove('is-flipped');
            document.getElementById('frontText').innerText = card.term || card.Term;
            if (cMode === 2) {
                optsBox.innerHTML = ''; optsBox.style.display = 'grid';
                const correct = (card.definition || card.Definition).trim();
                let distractors = [...new Set(originalCards.map(f => (f.definition || f.Definition).trim()).filter(d => d !== correct))];
                let opts = shuffle([correct, ...shuffle(distractors).slice(0, 3)]);
                opts.forEach(o => {
                    const b = document.createElement('button');
                    b.className = 'btn-practice-outline'; b.innerText = o;
                    b.onclick = () => {
                        if (o === correct) { b.style.background = 'var(--success-color)'; saveResult(card.id || card.Id, true); }
                        else { b.style.background = 'var(--error-color)'; saveResult(card.id || card.Id, false); wrongFlashcardIds.add(card.id || card.Id); }
                        setTimeout(nextManual, 800);
                    };
                    optsBox.appendChild(b);
                });
            } else {
                optsBox.style.display = 'none'; document.getElementById('backText').innerText = card.definition || card.Definition;
                cardEl.onclick = () => { cardEl.classList.toggle('is-flipped'); cardViews[card.id || card.Id] = 1; };
            }
        }

        // --- WRITING ---
        function renderWriting() {
            document.getElementById('inputZone').style.display = 'block';
            const card = flashcards[currentIndex];
            const input = document.getElementById('simpleInput');
            document.getElementById('inputFeedback').style.display = 'none';
            document.getElementById('writingPrompt').innerText = card.definition || card.Definition;
            input.value = ''; input.disabled = false; input.focus();
            input.onkeypress = (e) => { if(e.key === 'Enter') {
                const correct = (card.term || card.Term).trim();
                input.disabled = true;
                if (input.value.trim().toLowerCase() === correct.toLowerCase()) {
                    input.style.borderColor = 'var(--success-color)'; saveResult(card.id || card.Id, true);
                    setTimeout(nextManual, 1000);
                } else {
                    input.style.borderColor = 'var(--error-color)'; saveResult(card.id || card.Id, false);
                    wrongFlashcardIds.add(card.id || card.Id); document.getElementById('correctVal').innerText = correct;
                    document.getElementById('inputFeedback').style.display = 'block'; setTimeout(nextManual, 2000);
                }
            }};
        }

        function showSummary() {
            finishSession(false);
            document.getElementById('topPanel').style.display = 'none';
            ['standardZone', 'matchingZone', 'inputZone', 'navZone'].forEach(id => document.getElementById(id).style.display = 'none');
            document.getElementById('summaryZone').style.display = 'block';
            const wCount = wrongFlashcardIds.size;
            document.getElementById('summaryStat').innerText = wCount > 0 ? `Помилок: ${wCount}.` : "Ви ідеально знаєте цей набір!";
            if (wCount > 0) document.getElementById('retryWrongBtn').style.display = 'block';
        }

        function saveResult(id, correct) {
            const existing = practiceResults.results.find(r => r.FlashcardId === id);
            if (existing) existing.IsCorrect = correct;
            else practiceResults.results.push({ FlashcardId: id, IsCorrect: correct, ReviewType: globalMode });
        }

        function nextManual() { currentIndex++; render(); }
        function prevCard() { if (currentIndex > 0) { currentIndex--; render(); } }
        function retryAll() { flashcards = [...originalCards]; shuffle(flashcards); resetSession(); }
        function retryIncorrect() { flashcards = originalCards.filter(c => wrongFlashcardIds.has(c.id || c.Id)); resetSession(); }
        function resetSession() { currentIndex = 0; matchingBatchIndex = 0; wrongFlashcardIds.clear(); practiceResults.results = []; render(); }

        async function finishSession(redirect = true) {
            if (globalMode === 1) flashcards.forEach(c => { if(cardViews[c.id || c.Id]) saveResult(c.id || c.Id, true); });
            if (!practiceResults.results.length && redirect) { window.location.href = `/Test/Map/${setId}`; return; }
            await fetch('/Test/SaveResults', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ Results: practiceResults.results }) });
            if(redirect) window.location.href = `/Test/Map/${setId}`;
        }
        async function exitToMap() { if (confirm("Зберегти прогрес і вийти?")) await finishSession(true); }

        render();
    </script>
}