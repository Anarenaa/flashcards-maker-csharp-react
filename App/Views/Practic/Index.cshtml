@using Core.DTOs.Practice
@model PracticeSessionDTO

<style>
    .practice-page {
        max-width: 800px;
        margin: 40px auto;
        text-align: center;
        perspective: 1000px;
    }

    .timer-container {
        width: 100%;
        height: 4px;
        background: rgba(255,255,255,0.1);
        margin-bottom: 15px;
        border-radius: 2px;
        overflow: hidden;
        visibility: hidden;
    }

    .timer-bar {
        height: 100%;
        background: var(--accent-color);
        width: 100%;
    }

    .flashcard {
        width: 100%;
        height: 400px;
        cursor: pointer;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        margin-bottom: 30px;
    }

        .flashcard.is-flipped {
            transform: rotateY(180deg);
        }

    .card-face {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 40px;
        border-radius: 30px;
        border: 2px solid var(--btn-border);
        background: var(--btn-bg);
        backdrop-filter: blur(15px);
        box-shadow: 0 20px 50px rgba(0,0,0,0.3);
    }

    .card-back {
        transform: rotateY(180deg);
        background: rgba(255, 255, 255, 0.05);
    }

    .term-text {
        font-size: 2.8rem;
        font-weight: 800;
        color: var(--accent-color);
        word-break: break-word;
    }

    .def-text {
        font-size: 1.8rem;
        color: #fff;
        word-break: break-word;
    }

    .navigation-zone {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 450px;
        margin: 20px auto;
    }

    .btn-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: var(--btn-bg);
        border: 1px solid var(--btn-border);
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.3s;
    }

        .btn-circle:hover:not(:disabled) {
            border-color: var(--accent-color);
            background: var(--btn-hover);
            transform: scale(1.1);
        }

        .btn-circle:disabled {
            opacity: 0.1;
            cursor: not-allowed;
        }

    .view-dots {
        display: flex;
        gap: 10px;
        justify-content: center;
        margin-bottom: 20px;
    }

    .view-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: rgba(255,255,255,0.1);
        border: 1px solid var(--btn-border);
        transition: 0.4s;
    }

        .view-dot.active {
            background: var(--accent-color);
            box-shadow: 0 0 10px var(--accent-color);
            border-color: white;
        }

    .progress-container {
        width: 100%;
        height: 6px;
        background: rgba(255,255,255,0.1);
        border-radius: 3px;
        margin-bottom: 20px;
        overflow: hidden;
    }

    .p-bar-fill {
        height: 100%;
        background: var(--accent-color);
        width: 0%;
        transition: 0.5s;
    }

    /* QUIZ */
    .quiz-container {
        display: grid;
        gap: 15px;
        width: 100%;
        margin-top: 25px;
    }

    .quiz-option-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--btn-border);
        color: var(--text-color);
        padding: 15px;
        border-radius: 12px;
        cursor: pointer;
        font-size: 1rem;
        transition: 0.3s;
        font-weight: 600;
    }

        .quiz-option-btn:hover:not(:disabled) {
            border-color: var(--accent-color);
            background: var(--btn-hover);
            transform: translateY(-2px);
        }

    .option-correct {
        background: #28a745 !important;
        border-color: #28a745 !important;
        color: white !important;
    }

    .option-wrong {
        background: #dc3545 !important;
        border-color: #dc3545 !important;
        color: white !important;
    }
</style>

<div class="practice-page">
    <div class="progress-container">
        <div id="p-bar" class="p-bar-fill"></div>
    </div>

    <div class="timer-container" id="timerBox">
        <div class="timer-bar" id="timerBar"></div>
    </div>

    <div id="card-counter" style="opacity: 0.5; margin-bottom: 10px;">Завантаження...</div>

    <div class="view-dots" id="dotsContainer">
        <div class="view-dot" id="dot-1"></div>
        <div class="view-dot" id="dot-2"></div>
    </div>

    <div class="flashcard" id="mainCard">
        <div class="card-face card-front">
            <div id="frontText" class="term-text"></div>
            <div id="quizOptions" class="quiz-container" style="display: none;"></div>
            <div id="hintLabel" style="opacity: 0.4; font-size: 0.8rem; margin-top: 15px; text-transform: uppercase;">
                Натисніть, щоб перевернути
            </div>
        </div>
        <div class="card-face card-back">
            <div id="backText" class="def-text"></div>
        </div>
    </div>

    <div class="navigation-zone">
        <button class="btn-circle" id="prevBtn" onclick="prevCard()" title="Назад">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"></path></svg>
        </button>
        <button class="btn-circle" id="nextBtn" onclick="nextManual()" title="Вперед">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"></path></svg>
        </button>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Ініціалізація даних
        const session = @Json.Serialize(Model);
        const currentProgress = parseFloat("@(ViewBag.CurrentProgress != null ? ViewBag.CurrentProgress.ToString().Replace(",", ".") : "0")");
        const mode = parseInt("@(ViewBag.Mode ?? 1)");
        const setId = session.setId || session.SetId;

        let currentIndex = 0;
        let autoFlipTimeout = null;
        let cardViews = {}; // Рахуємо перегляди зворотного боку для кожної карти
        let practiceResults = { results: [], isTrainingMode: false };

        const modeLimits = { 1: 0.15, 2: 0.35, 3: 0.55, 4: 0.75, 5: 0.90, 6: 1.0 };
        const myLimit = modeLimits[mode] || 1.0;

        // 2. Основна функція рендеру картки
        function render() {
            stopTimer();
            const flashcards = session.flashcards || session.Flashcards;
            const total = session.totalCards || session.TotalCards;

            if (!flashcards || flashcards.length === 0) return;

            const card = flashcards[currentIndex];
            const cardId = card.id || card.Id;

            // Елементи DOM
            const cardEl = document.getElementById('mainCard');
            const quizZone = document.getElementById('quizOptions');
            const hint = document.getElementById('hintLabel');
            const dotsContainer = document.getElementById('dotsContainer');

            // Скидання стану картки
            cardEl.classList.remove('is-flipped');
            quizZone.innerHTML = '';

            // Оновлення текстової інформації
            document.getElementById('frontText').innerText = card.term || card.Term;
            document.getElementById('card-counter').innerText = `Картка ${currentIndex + 1} із ${total}`;
            document.getElementById('p-bar').style.width = ((currentIndex + 1) / total * 100) + '%';
            document.getElementById('prevBtn').disabled = currentIndex === 0;

            if (mode === 2) {
                // --- ЛОГІКА РЕЖИМУ ВІКТОРИНИ ---
                hint.style.display = 'none';
                dotsContainer.style.display = 'none';
                quizZone.style.display = 'grid';
                cardEl.onclick = null;

                const correct = (card.definition || card.Definition).trim();
                let distractors = (card.distractors || card.Distractors || [])
                                    .filter(d => d.trim().toLowerCase() !== correct.toLowerCase());

                // Створюємо набір варіантів
                let options = [correct, ...distractors].slice(0, 4);
                options = [...new Set(options)].sort(() => Math.random() - 0.5);

                if (options.length < 2) options.push("Інший варіант");

                options.forEach(opt => {
                    const btn = document.createElement('button');
                    btn.className = 'quiz-option-btn';
                    btn.innerText = opt;
                    btn.onclick = () => checkQuizAnswer(btn, opt, correct);
                    quizZone.appendChild(btn);
                });

                quizZone.style.gridTemplateColumns = options.length > 2 ? "1fr 1fr" : "1fr";
            } else {
                // --- ЛОГІКА РЕЖИМУ КАРТОК ---
                hint.style.display = 'block';
                dotsContainer.style.display = 'flex';
                quizZone.style.display = 'none';
                cardEl.onclick = flipCard;
                document.getElementById('backText').innerText = card.definition || card.Definition;
                updateViewDots(cardId);
            }
        }

        // 3. Обробка відповіді у вікторині
        function checkQuizAnswer(btn, selected, correct) {
            const isCorrect = selected === correct;
            document.querySelectorAll('.quiz-option-btn').forEach(b => b.disabled = true);

            if (isCorrect) {
                btn.classList.add('option-correct');
                if (currentProgress < myLimit) saveCorrectResult();
            } else {
                btn.classList.add('option-wrong');
                document.querySelectorAll('.quiz-option-btn').forEach(b => {
                    if(b.innerText === correct) b.classList.add('option-correct');
                });
            }

            setTimeout(nextManual, 1200);
        }

        // 4. Поворот картки (Mode 1)
        function flipCard() {
            const cardEl = document.getElementById('mainCard');
            if (cardEl.classList.contains('is-flipped')) return;

            const flashcards = session.flashcards || session.Flashcards;
            const cardId = flashcards[currentIndex].id || flashcards[currentIndex].Id;

            cardEl.classList.add('is-flipped');

            // Зараховуємо перегляд
            cardViews[cardId] = (cardViews[cardId] || 0) + 1;
            updateViewDots(cardId);
            startTimer();
        }

        function updateViewDots(cardId) {
            const views = cardViews[cardId] || 0;
            document.getElementById('dot-1').classList.toggle('active', views >= 1);
            document.getElementById('dot-2').classList.toggle('active', views >= 2);
        }

        // 5. Таймер авто-повороту назад
        function startTimer() {
            const timerBox = document.getElementById('timerBox');
            const timerBar = document.getElementById('timerBar');
            timerBox.style.visibility = 'visible';
            timerBar.style.transition = 'none';
            timerBar.style.width = '100%';

            setTimeout(() => {
                timerBar.style.transition = 'width 5s linear';
                timerBar.style.width = '0%';
            }, 50);

            autoFlipTimeout = setTimeout(() => {
                document.getElementById('mainCard').classList.remove('is-flipped');
                timerBox.style.visibility = 'hidden';
            }, 5000);
        }

        function stopTimer() {
            clearTimeout(autoFlipTimeout);
            if(document.getElementById('timerBox'))
                document.getElementById('timerBox').style.visibility = 'hidden';
        }

        // 6. Збереження результату в локальний масив
        function saveCorrectResult() {
            const flashcards = session.flashcards || session.Flashcards;
            const cardId = flashcards[currentIndex].id || flashcards[currentIndex].Id;

            if (!practiceResults.results.some(r => r.flashcardId === cardId)) {
                practiceResults.results.push({
                    flashcardId: cardId,
                    isCorrect: true,
                    responseTimeMs: 0,
                    reviewType: mode
                });
            }
        }

        // 7. Навігація
        function nextManual() {
            const flashcards = session.flashcards || session.Flashcards;
            if (currentIndex < flashcards.length - 1) {
                currentIndex++;
                render();
            } else {
                finishSession();
            }
        }

        function prevCard() {
            if (currentIndex > 0) {
                currentIndex--;
                render();
            }
        }

        // 8. Завершення сесії та відправка на сервер
        async function finishSession() {
            const flashcards = session.flashcards || session.Flashcards;

            // Якщо режим 1, збираємо результати на основі переглядів перед відправкою
            if (mode === 1) {
                flashcards.forEach(card => {
                    const id = card.id || card.Id;
                    if (cardViews[id] >= 1 && currentProgress < myLimit) {
                        if (!practiceResults.results.some(r => r.flashcardId === id)) {
                            practiceResults.results.push({
                                flashcardId: id,
                                isCorrect: true,
                                responseTimeMs: 0,
                                reviewType: 1
                            });
                        }
                    }
                });
            }

            // Якщо результатів немає (нічого не клікнули), просто виходимо
            if (practiceResults.results.length === 0) {
                window.location.href = `/Test/Map/${setId}`;
                return;
            }

            try {
                const response = await fetch('/Test/SaveResults', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(practiceResults)
                });

                if (response.ok) {
                    const data = await response.json();
                    window.location.href = data.redirectUrl;
                } else {
                    window.location.href = `/Test/Map/${setId}`;
                }
            } catch (error) {
                console.error("Error saving results:", error);
                window.location.href = `/Test/Map/${setId}`;
            }
        }

        // Запуск першого рендеру
        render();
    </script>
}