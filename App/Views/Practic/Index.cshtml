@using Core.DTOs.Practice
@model PracticeSessionDTO

<style>
    :root {
        --success-color: #28a745;
        --error-color: #dc3545;
        --practice-gradient: linear-gradient(135deg, #6e8efb, #a777e3);
        --accent-color: #6e8efb;
    }

    .practice-page {
        max-width: 900px;
        margin: 60px auto;
        text-align: center;
        perspective: 1000px;
        position: relative;
    }

    .progress-container {
        width: 100%;
        height: 12px;
        background: rgba(255,255,255,0.05);
        border-radius: 20px;
        margin-bottom: 25px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .p-bar-fill {
        height: 100%;
        background: var(--practice-gradient);
        width: 0%;
        transition: 0.6s cubic-bezier(0.17, 0.67, 0.83, 0.67);
    }

    #card-counter {
        opacity: 0.5;
        margin-bottom: 15px;
        font-size: 0.9rem;
    }

    .flashcard {
        width: 100%;
        height: 420px;
        cursor: pointer;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        margin-bottom: 30px;
    }

        .flashcard.is-flipped {
            transform: rotateY(180deg);
        }

    .card-face {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 40px;
        border-radius: 30px;
        border: 2px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(20px);
        box-shadow: 0 25px 50px rgba(0,0,0,0.3);
    }

    .card-back {
        transform: rotateY(180deg);
        background: rgba(255, 255, 255, 0.05);
    }

    .term-text {
        font-size: 2.8rem;
        font-weight: 800;
        color: var(--accent-color);
        margin-bottom: 20px;
    }

    .def-text {
        font-size: 1.8rem;
        color: #fff;
    }

    .matching-wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 30px;
    }

    .matching-column {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .matching-item {
        background: rgba(255, 255, 255, 0.05);
        border: 2px solid rgba(255,255,255,0.1);
        color: #fff;
        padding: 15px;
        border-radius: 12px;
        cursor: pointer;
        min-height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        transition: all 0.2s ease;
        font-size: 1.1rem;
    }

        .matching-item.selected {
            border-color: var(--accent-color);
            background: rgba(110, 142, 251, 0.2);
            transform: scale(1.02);
        }

        .matching-item.correct-flash {
            background: var(--success-color) !important;
            border-color: #fff !important;
        }

        .matching-item.wrong-flash {
            background: var(--error-color) !important;
            border-color: var(--error-color) !important;
            animation: shake 0.4s ease;
        }

        .matching-item.matched-hidden {
            opacity: 0;
            transform: scale(0.8);
            pointer-events: none;
            transition: 0.4s;
        }

    .btn-practice-main {
        background: var(--practice-gradient);
        color: white;
        border: none;
        padding: 20px 40px;
        border-radius: 20px;
        font-weight: 800;
        cursor: pointer;
        transition: 0.3s;
        text-transform: uppercase;
        width: 100%;
        max-width: 400px;
    }

    .btn-practice-outline {
        background: none;
        padding: 18px 40px;
        border-radius: 20px;
        font-weight: 800;
        cursor: pointer;
        transition: 0.3s;
        text-transform: uppercase;
        width: 100%;
        max-width: 400px;
        border: 2px solid rgba(255,255,255,0.1);
        color: white;
    }

    .summary-card {
        background: rgba(255,255,255,0.05);
        padding: 60px 40px;
        border-radius: 40px;
        display: none;
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.1);
    }

    @@keyframes shake {
        0%, 100% {
            transform: translateX(0);
        }

        25% {
            transform: translateX(-5px);
        }

        75% {
            transform: translateX(5px);
        }
    }
</style>

<div class="practice-page">
    <div class="exit-container" style="position: absolute; top: -45px; left: 0; z-index: 10;">
        <button onclick="exitToMap()" style="background:none; border:none; color:white; opacity:0.6; cursor:pointer; display:flex; align-items:center; gap:5px;">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7"></path></svg>
            До мапи
        </button>
    </div>

    <div id="topPanel">
        <div class="progress-container"><div id="p-bar" class="p-bar-fill"></div></div>
        <div id="card-counter">Завантаження...</div>
    </div>

    <div id="standardZone" style="display:none">
        <div class="flashcard" id="mainCard">
            <div class="card-face card-front">
                <div id="frontText" class="term-text"></div>
                <div id="quizOptions" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 20px; width: 100%;"></div>
            </div>
            <div class="card-face card-back"><div id="backText" class="def-text"></div></div>
        </div>
    </div>

    <div id="matchingZone" class="matching-wrapper" style="display: none;"></div>

    <div id="inputZone" style="display: none; background: rgba(255,255,255,0.03); padding: 50px; border-radius: 30px;">
        <div id="writingPrompt" class="term-text"></div>
        <input type="text" id="simpleInput" style="width: 100%; background: rgba(255,255,255,0.05); border: 2px solid rgba(255,255,255,0.1); border-radius: 15px; padding: 18px; color: white; font-size: 1.4rem; text-align: center;" placeholder="Введіть переклад...">
        <div id="inputFeedback" style="display:none; margin-top:15px; color:var(--success-color);">Правильно: <span id="correctVal" style="color:white;"></span></div>
    </div>

    <div id="summaryZone" class="summary-card">
        <div style="font-size: 80px; margin-bottom: 20px;">🎉</div>
        <h2 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 10px;">Завершено!</h2>
        <p id="summaryStat" style="opacity: 0.7; font-size: 1.2rem; margin-bottom: 40px;"></p>
        <div style="display: flex; flex-direction: column; align-items: center; gap: 15px;">
            <button onclick="retryAll()" class="btn-practice-main">Пройти ще раз</button>
            <button onclick="location.href='/Test/Map/@Model.SetId'" class="btn-practice-outline">До мапи</button>
        </div>
    </div>

    <div class="navigation-zone" id="navZone" style="display: none; justify-content: center; gap: 40px; margin-top: 30px;">
        <button class="btn-circle" style="width:60px; height:60px; border-radius:50%; background:rgba(255,255,255,0.1); color:white; border:none; cursor:pointer;" onclick="prevCard()">←</button>
        <button class="btn-circle" style="width:60px; height:60px; border-radius:50%; background:rgba(255,255,255,0.1); color:white; border:none; cursor:pointer;" onclick="nextManual()">→</button>
    </div>
</div>

@section Scripts {
    <script>
        const originalCards = @Json.Serialize(Model.Flashcards);
        const globalMode = parseInt("@(ViewBag.Mode ?? 1)");
        const setId = @Model.SetId;

        let tasks = [];
        let currentIndex = 0, practiceResults = { results: [] }, wrongFlashcardIds = new Set();
        let sT = null, sD = null;

        const getTerm = (c) => c.term || c.Term;
        const getDef = (c) => c.definition || c.Definition;
        const getId = (c) => c.id || c.Id;

        function shuffle(arr) { return [...arr].sort(() => Math.random() - 0.5); }

        function initSession() {
            tasks = [];
            const cards = shuffle([...originalCards]);

            if (globalMode === 6) {
            
                cards.forEach(c => tasks.push({ ...c, assignedMode: 2 }));
              
                cards.forEach(c => tasks.push({ ...c, assignedMode: 4 }));

                for(let r=0; r<3; r++) {
                    const matchPool = shuffle([...originalCards]);
                    let i = 0;
                    while (i < matchPool.length) {
                        let remaining = matchPool.length - i;
                        let size = 4 + Math.floor(Math.random() * 3); 

                        if (remaining < 3 && tasks.length > 0) {
                            let lastTask = tasks[tasks.length - 1];
                            if (lastTask.assignedMode === 3) {
                                lastTask.batch = [...lastTask.batch, ...matchPool.slice(i)];
                                break;
                            }
                        }

                        if (remaining < size + 3) size = remaining; 
                        tasks.push({ assignedMode: 3, batch: matchPool.slice(i, i + size) });
                        i += size;
                    }
                }
                tasks = shuffle(tasks);
            } else if (globalMode === 3) {
                let i = 0;
                while (i < cards.length) {
                    let remaining = cards.length - i;
                    let size = 5;
                    if (remaining < size + 3) size = remaining;
                    tasks.push({ assignedMode: 3, batch: cards.slice(i, i + size) });
                    i += size;
                }
            } else {
                tasks = cards.map(c => ({ ...c, assignedMode: globalMode }));
            }
            currentIndex = 0;
        }

        function render() {
            if (currentIndex >= tasks.length) { showSummary(); return; }
            const currentTask = tasks[currentIndex];
            const cMode = currentTask.assignedMode;

            document.getElementById('topPanel').style.display = (cMode === 3) ? 'none' : 'block';
            document.getElementById('card-counter').innerText = `Завдання ${currentIndex + 1} з ${tasks.length}`;
            document.getElementById('p-bar').style.width = ((currentIndex + 1) / tasks.length * 100) + '%';

            ['standardZone', 'matchingZone', 'inputZone', 'summaryZone'].forEach(id => document.getElementById(id).style.display = 'none');
            document.getElementById('navZone').style.display = (cMode === 1) ? 'flex' : 'none';

            if (cMode === 3) renderMatching(currentTask.batch);
            else if (cMode === 4) renderWriting(currentTask);
            else renderStandard(currentTask, cMode);
        }

        function renderMatching(batch) {
            const zone = document.getElementById('matchingZone');
            zone.innerHTML = ''; zone.style.display = 'grid';
            sT = null; sD = null;
            let matchedInBatch = 0;

            let terms = shuffle(batch.map(c => ({ id: getId(c), text: getTerm(c), type: 't' })));
            let defs = shuffle(batch.map(c => ({ id: getId(c), text: getDef(c), type: 'd' })));

            const leftCol = document.createElement('div'); leftCol.className = 'matching-column';
            const rightCol = document.createElement('div'); rightCol.className = 'matching-column';

            const createItem = (item) => {
                const d = document.createElement('div');
                d.className = 'matching-item';
                d.innerText = item.text;
                d.dataset.id = item.id;
                d.onclick = () => {
                    if (d.classList.contains('matched-hidden') || d.classList.contains('correct-flash')) return;
                    if (item.type === 't') { if (sT) sT.classList.remove('selected'); sT = d; }
                    else { if (sD) sD.classList.remove('selected'); sD = d; }
                    d.classList.add('selected');

                    if (sT && sD) {
                        const first = sT, second = sD;
                        if (first.dataset.id === second.dataset.id) {
                            first.classList.add('correct-flash'); second.classList.add('correct-flash');
                            matchedInBatch++; saveResult(parseInt(first.dataset.id), true);
                            setTimeout(() => {
                                first.classList.add('matched-hidden'); second.classList.add('matched-hidden');
                                if (matchedInBatch === batch.length) { currentIndex++; render(); }
                            }, 500);
                        } else {
                            first.classList.add('wrong-flash'); second.classList.add('wrong-flash');
                            saveResult(parseInt(first.dataset.id), false);
                            wrongFlashcardIds.add(parseInt(first.dataset.id));
                            setTimeout(() => {
                                first.classList.remove('wrong-flash', 'selected');
                                second.classList.remove('wrong-flash', 'selected');
                            }, 500);
                        }
                        sT = null; sD = null;
                    }
                };
                return d;
            };

            terms.forEach(t => leftCol.appendChild(createItem(t)));
            defs.forEach(d => rightCol.appendChild(createItem(d)));
            zone.append(leftCol, rightCol);
        }

        function renderStandard(card, cMode) {
            document.getElementById('standardZone').style.display = 'block';
            document.getElementById('frontText').innerText = getTerm(card);
            document.getElementById('backText').innerText = getDef(card);
            document.getElementById('mainCard').classList.remove('is-flipped');
            const opts = document.getElementById('quizOptions'); opts.innerHTML = '';

            if (cMode === 2) {
                opts.style.display = 'grid';
                let correct = getDef(card);
                let distractors = originalCards.map(getDef).filter(d => d !== correct);
                let choices = shuffle([correct, ...shuffle(distractors).slice(0, 3)]);
                choices.forEach(text => {
                    const b = document.createElement('button');
                    b.className = 'btn-practice-outline'; b.innerText = text;
                    b.onclick = (e) => {
                        e.stopPropagation();
                        if (text === correct) { b.style.background = 'var(--success-color)'; saveResult(getId(card), true); setTimeout(nextManual, 600); }
                        else { b.style.background = 'var(--error-color)'; saveResult(getId(card), false); wrongFlashcardIds.add(getId(card)); }
                    };
                    opts.appendChild(b);
                });
                document.getElementById('mainCard').onclick = null;
            } else {
                opts.style.display = 'none';
                document.getElementById('mainCard').onclick = () => document.getElementById('mainCard').classList.toggle('is-flipped');
            }
        }

        function renderWriting(card) {
            document.getElementById('inputZone').style.display = 'block';
            document.getElementById('writingPrompt').innerText = getDef(card);
            const input = document.getElementById('simpleInput');
            input.value = ''; input.style.borderColor = 'rgba(255,255,255,0.1)';
            input.focus();
            input.onkeypress = (e) => { if(e.key === 'Enter') {
                if (input.value.trim().toLowerCase() === getTerm(card).toLowerCase()) {
                    input.style.borderColor = 'var(--success-color)'; saveResult(getId(card), true); setTimeout(nextManual, 800);
                } else {
                    input.style.borderColor = 'var(--error-color)'; document.getElementById('correctVal').innerText = getTerm(card);
                    document.getElementById('inputFeedback').style.display = 'block'; saveResult(getId(card), false); wrongFlashcardIds.add(getId(card));
                    setTimeout(() => { document.getElementById('inputFeedback').style.display = 'none'; nextManual(); }, 2000);
                }
            }};
        }

        function showSummary() {
            finishSession(false);
            ['standardZone', 'matchingZone', 'inputZone', 'topPanel'].forEach(id => document.getElementById(id).style.display = 'none');
            document.getElementById('summaryZone').style.display = 'block';
            document.getElementById('summaryStat').innerText = `Ви пройшли повний цикл тренування!`;
        }

        function saveResult(id, correct) {
            practiceResults.results.push({ FlashcardId: id, IsCorrect: correct, ReviewType: globalMode });
        }

        function nextManual() { currentIndex++; render(); }
        function prevCard() { if (currentIndex > 0) { currentIndex--; render(); } }
        function retryAll() { initSession(); render(); }

        async function finishSession(redirect = true) {
            if (practiceResults.results.length > 0) await fetch('/Test/SaveResults', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ Results: practiceResults.results }) });
            if(redirect) window.location.href = `/Test/Map/${setId}`;
        }
        function exitToMap() { if (confirm("Зберегти прогрес і вийти?")) finishSession(true); }

        initSession();
        render();
    </script>
}