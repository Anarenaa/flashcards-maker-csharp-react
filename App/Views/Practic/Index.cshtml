@using Core.DTOs.Practice
@model PracticeSessionDTO

<style>
    /* БАЗОВІ СТИЛІ */
    .practice-page {
        max-width: 800px;
        margin: 40px auto;
        text-align: center;
        perspective: 1000px;
    }

    .timer-container {
        width: 100%;
        height: 4px;
        background: rgba(255,255,255,0.1);
        margin-bottom: 15px;
        border-radius: 2px;
        overflow: hidden;
        visibility: hidden;
    }

    .timer-bar {
        height: 100%;
        background: var(--accent-color);
        width: 100%;
    }

    .flashcard {
        width: 100%;
        height: 400px;
        cursor: pointer;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        margin-bottom: 30px;
    }

        .flashcard.is-flipped {
            transform: rotateY(180deg);
        }

    .card-face {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 40px;
        border-radius: 30px;
        border: 2px solid var(--btn-border);
        background: var(--btn-bg);
        backdrop-filter: blur(15px);
        box-shadow: 0 20px 50px rgba(0,0,0,0.3);
    }

    .card-back {
        transform: rotateY(180deg);
        background: rgba(255, 255, 255, 0.05);
    }

    .term-text {
        font-size: 2.8rem;
        font-weight: 800;
        color: var(--accent-color);
        word-break: break-word;
    }

    .def-text {
        font-size: 1.8rem;
        color: #fff;
        word-break: break-word;
    }

    /* З'ЄДНАННЯ (MATCHING) */
    .matching-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 20px;
    }

    .matching-item {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--btn-border);
        color: var(--text-color);
        padding: 20px;
        border-radius: 15px;
        cursor: pointer;
        transition: 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 80px;
        font-weight: 600;
    }

        .matching-item.selected {
            background: var(--accent-color);
            color: var(--bg-color);
            border-color: white;
            transform: scale(1.05);
        }

        .matching-item.matched {
            opacity: 0;
            pointer-events: none;
            transform: scale(0.8);
        }

        .matching-item.wrong {
            background: #dc3545 !important;
            border-color: #dc3545 !important;
        }

    /* ПИСЬМО ТА КОНТЕКСТ (INPUT MODES) */
    .input-mode-container {
        background: var(--btn-bg);
        padding: 40px;
        border-radius: 30px;
        border: 2px solid var(--btn-border);
        box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        margin-bottom: 30px;
    }

    .mode-input {
        width: 100%;
        background: rgba(255,255,255,0.05);
        border: 2px solid var(--btn-border);
        border-radius: 15px;
        padding: 20px;
        color: white;
        font-size: 1.4rem;
        text-align: center;
        margin-top: 25px;
        transition: 0.3s;
        outline: none;
    }

        .mode-input:focus {
            border-color: var(--accent-color);
            background: rgba(255,255,255,0.1);
        }

        .mode-input.correct {
            border-color: #28a745;
            background: rgba(40, 167, 69, 0.1);
        }

        .mode-input.wrong {
            border-color: #dc3545;
            background: rgba(220, 53, 69, 0.1);
        }

    .sentence-display {
        font-size: 1.6rem;
        line-height: 1.4;
        color: #fff;
        margin-bottom: 20px;
    }

        .sentence-display b {
            color: var(--accent-color);
            text-decoration: underline;
        }

    .context-hint {
        font-style: italic;
        opacity: 0.6;
        margin-top: 10px;
        font-size: 1rem;
    }

    .feedback-zone {
        margin-top: 20px;
        font-size: 1.2rem;
        display: none;
    }

        .feedback-zone.visible {
            display: block;
        }

    /* ЗАГАЛЬНЕ */
    .quiz-container {
        display: grid;
        gap: 15px;
        width: 100%;
        margin-top: 25px;
    }

    .quiz-option-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--btn-border);
        color: var(--text-color);
        padding: 15px;
        border-radius: 12px;
        cursor: pointer;
        font-size: 1rem;
        transition: 0.3s;
        font-weight: 600;
    }

    .option-correct {
        background: #28a745 !important;
    }

    .option-wrong {
        background: #dc3545 !important;
    }

    .navigation-zone {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 450px;
        margin: 20px auto;
    }

    .btn-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: var(--btn-bg);
        border: 1px solid var(--btn-border);
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.3s;
    }

        .btn-circle:disabled {
            opacity: 0.1;
        }
</style>

<div class="practice-page">
    <div class="progress-container"><div id="p-bar" class="p-bar-fill"></div></div>
    <div id="card-counter" style="opacity: 0.5; margin-bottom: 10px;">Завантаження...</div>

    <!-- Mode 1 & 2: Standard -->
    <div id="standardZone">
        <div class="timer-container" id="timerBox"><div class="timer-bar" id="timerBar"></div></div>
        <div class="flashcard" id="mainCard">
            <div class="card-face card-front">
                <div id="frontText" class="term-text"></div>
                <div id="quizOptions" class="quiz-container" style="display: none;"></div>
                <div id="hintLabel" style="opacity: 0.4; font-size: 0.8rem; margin-top: 15px; text-transform: uppercase;">Натисніть перевернути</div>
            </div>
            <div class="card-face card-back"><div id="backText" class="def-text"></div></div>
        </div>
    </div>

    <!-- Mode 3: Matching -->
    <div id="matchingZone" class="matching-container" style="display: none;"></div>

    <!-- Mode 4 & 5: Writing & Context -->
    <div id="inputZone" class="input-mode-container" style="display: none;">
        <div id="contextSentence" class="sentence-display" style="display: none;"></div>
        <div id="inputPrompt" class="term-text"></div>
        <div id="contextHint" class="context-hint"></div>

        <input type="text" id="mainInput" class="mode-input" placeholder="Ваша відповідь..." autocomplete="off">

        <div id="inputFeedback" class="feedback-zone">
            <div style="opacity: 0.6; font-size: 0.9rem;">Правильна відповідь:</div>
            <div id="correctValue" style="color: var(--accent-color); font-weight: 700;"></div>
        </div>
    </div>

    <div class="navigation-zone" id="navZone">
        <button class="btn-circle" id="prevBtn" onclick="prevCard()"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"></path></svg></button>
        <button class="btn-circle" id="nextBtn" onclick="nextManual()"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"></path></svg></button>
    </div>
</div>

@section Scripts {
    <script>
        const sessionData = @Json.Serialize(Model);
        let flashcards = sessionData.flashcards || sessionData.Flashcards || [];
        const currentProgress = parseFloat("@(ViewBag.CurrentProgress != null ? ViewBag.CurrentProgress.ToString().Replace(",", ".") : "0")");
        const mode = parseInt("@(ViewBag.Mode ?? 1)");
        const setId = sessionData.setId || sessionData.SetId;

        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
            return array;
        }
        if (mode >= 2) flashcards = shuffleArray([...flashcards]);

        let currentIndex = 0;
        let cardViews = {};
        let practiceResults = { results: [], isTrainingMode: false };

        function getActiveMode(prog) {
            if (prog < 0.02) return 1;
            if (prog < 0.07) return 2;
            if (prog < 0.15) return 3;
            if (prog < 0.25) return 4;
            if (prog < 0.40) return 5; // Пороговий режим для Контексту
            return 6;
        }
        const isProgressAllowed = (mode === getActiveMode(currentProgress));

        function render() {
            const standardZone = document.getElementById('standardZone');
            const matchingZone = document.getElementById('matchingZone');
            const inputZone = document.getElementById('inputZone');
            const navZone = document.getElementById('navZone');

            if (mode === 3) {
                standardZone.style.display = 'none'; inputZone.style.display = 'none';
                navZone.style.display = 'none'; matchingZone.style.display = 'grid';
                renderMatching();
            } else if (mode === 4 || mode === 5) {
                standardZone.style.display = 'none'; matchingZone.style.display = 'none';
                navZone.style.display = 'flex'; inputZone.style.display = 'block';
                renderInputMode();
            } else {
                standardZone.style.display = 'block'; matchingZone.style.display = 'none';
                inputZone.style.display = 'none'; navZone.style.display = 'flex';
                renderStandard();
            }
        }

        // --- РЕЖИМИ ВВОДУ (4 та 5) ---
        function renderInputMode() {
            const card = flashcards[currentIndex];
            const input = document.getElementById('mainInput');
            const sentenceBox = document.getElementById('contextSentence');
            const promptBox = document.getElementById('inputPrompt');
            const hintBox = document.getElementById('contextHint');
            const feedback = document.getElementById('inputFeedback');

            input.value = ''; input.className = 'mode-input'; input.disabled = false;
            feedback.classList.remove('visible');

            if (mode === 5) {
                // РЕЖИМ КОНТЕКСТУ
                sentenceBox.style.display = 'block';
                promptBox.style.display = 'none';
                // Виводимо речення з пропуском або дефолтне, якщо ШІ не згенерував
                sentenceBox.innerHTML = (card.contextSentence || card.ContextSentence || "_____ (контекст не знайдено)").replace("_____", "<b>_____</b>");
                hintBox.innerText = card.contextHint || card.ContextHint || card.definition || card.Definition;
            } else {
                // РЕЖИМ ПИСЬМА
                sentenceBox.style.display = 'none';
                promptBox.style.display = 'block';
                promptBox.innerText = card.term || card.Term;
                hintBox.innerText = '';
            }

            document.getElementById('card-counter').innerText = `Картка ${currentIndex + 1} із ${flashcards.length}`;
            document.getElementById('p-bar').style.width = ((currentIndex + 1) / flashcards.length * 100) + '%';
            document.getElementById('prevBtn').disabled = currentIndex === 0;

            input.focus();
            input.onkeypress = (e) => { if(e.key === 'Enter') handleInputCheck(); };
        }

        function handleInputCheck() {
            const input = document.getElementById('mainInput');
            if (input.disabled) return;
            const card = flashcards[currentIndex];

            // Відповідь у контексті — це зазвичай сам Термін (якщо питаємо слово для речення)
            // Або Визначення (якщо письмо). Backend Service зазвичай перевіряє Term.
            const userAnswer = input.value.trim().toLowerCase();
            const correctAnswer = (mode === 5 ? (card.term || card.Term) : (card.definition || card.Definition)).trim().toLowerCase();

            input.disabled = true;
            if (userAnswer === correctAnswer) {
                input.classList.add('correct');
                if (isProgressAllowed) saveCorrectResult();
                setTimeout(nextManual, 1000);
            } else {
                input.classList.add('wrong');
                document.getElementById('correctValue').innerText = (mode === 5 ? card.term : card.definition);
                document.getElementById('inputFeedback').classList.add('visible');
                setTimeout(nextManual, 3000);
            }
        }

        // --- РЕЖИМ З'ЄДНАННЯ (3) ---
        let selectedTerm = null, selectedDef = null, matchedCount = 0;
        function renderMatching() {
            const zone = document.getElementById('matchingZone');
            zone.innerHTML = ''; matchedCount = 0;
            let terms = flashcards.map(f => ({ id: f.id || f.Id, text: f.term || f.Term, type: 'term' }));
            let defs = flashcards.map(f => ({ id: f.id || f.Id, text: f.definition || f.Definition, type: 'def' }));
            shuffleArray(terms); shuffleArray(defs);
            terms.forEach((t, i) => { zone.appendChild(createMatchBtn(t)); zone.appendChild(createMatchBtn(defs[i])); });
            document.getElementById('card-counter').innerText = "З'єднайте пари";
        }
        function createMatchBtn(item) {
            const div = document.createElement('div'); div.className = 'matching-item'; div.innerText = item.text; div.dataset.id = item.id;
            div.onclick = () => {
                if (item.type === 'term') { if(selectedTerm) selectedTerm.classList.remove('selected'); selectedTerm = div; }
                else { if(selectedDef) selectedDef.classList.remove('selected'); selectedDef = div; }
                div.classList.add('selected');
                if (selectedTerm && selectedDef) {
                    if (selectedTerm.dataset.id === selectedDef.dataset.id) {
                        selectedTerm.classList.add('matched'); selectedDef.classList.add('matched');
                        if (isProgressAllowed) saveCorrectResultManually(parseInt(selectedTerm.dataset.id));
                        selectedTerm = null; selectedDef = null; matchedCount++;
                        document.getElementById('p-bar').style.width = (matchedCount / flashcards.length * 100) + '%';
                        if (matchedCount === flashcards.length) setTimeout(finishSession, 800);
                    } else {
                        const t = selectedTerm, d = selectedDef; t.classList.add('wrong'); d.classList.add('wrong');
                        selectedTerm = null; selectedDef = null;
                        setTimeout(() => { t.classList.remove('wrong', 'selected'); d.classList.remove('wrong', 'selected'); }, 500);
                    }
                }
            }; return div;
        }

        // --- СТАНДАРТ (1 та 2) ---
        function renderStandard() {
            const card = flashcards[currentIndex];
            const cardEl = document.getElementById('mainCard');
            cardEl.classList.remove('is-flipped');
            document.getElementById('frontText').innerText = card.term || card.Term;
            document.getElementById('card-counter').innerText = `Картка ${currentIndex+1} з ${flashcards.length}`;
            document.getElementById('p-bar').style.width = ((currentIndex+1)/flashcards.length*100)+'%';
            document.getElementById('prevBtn').disabled = (currentIndex === 0);

            if (mode === 2) {
                document.getElementById('quizOptions').style.display = 'grid';
                document.getElementById('hintLabel').style.display = 'none';
                const correct = (card.definition || card.Definition).trim();
                let opts = shuffleArray([correct, ...flashcards.map(f => f.definition || f.Definition).filter(d => d !== correct)].slice(0, 4));
                document.getElementById('quizOptions').innerHTML = '';
                opts.forEach(o => {
                    const b = document.createElement('button'); b.className = 'quiz-option-btn'; b.innerText = o;
                    b.onclick = () => {
                        if(o === correct) { b.classList.add('option-correct'); if(isProgressAllowed) saveCorrectResult(); }
                        else b.classList.add('option-wrong');
                        setTimeout(nextManual, 1000);
                    };
                    document.getElementById('quizOptions').appendChild(b);
                });
            } else {
                document.getElementById('quizOptions').style.display = 'none';
                document.getElementById('hintLabel').style.display = 'block';
                document.getElementById('backText').innerText = card.definition || card.Definition;
                cardEl.onclick = () => cardEl.classList.toggle('is-flipped');
            }
        }

        function saveCorrectResult() {
            const id = flashcards[currentIndex].id || flashcards[currentIndex].Id;
            if (!practiceResults.results.some(r => r.flashcardId === id))
                practiceResults.results.push({ flashcardId: id, isCorrect: true, responseTimeMs: 0, reviewType: mode });
        }
        function saveCorrectResultManually(id) {
            if (!practiceResults.results.some(r => r.flashcardId === id))
                practiceResults.results.push({ flashcardId: id, isCorrect: true, responseTimeMs: 0, reviewType: mode });
        }
        function nextManual() { if (currentIndex < flashcards.length - 1) { currentIndex++; render(); } else finishSession(); }
        function prevCard() { if (currentIndex > 0) { currentIndex--; render(); } }

        async function finishSession() {
            if (practiceResults.results.length === 0 && !isProgressAllowed) { window.location.href = `/Test/Map/${setId}`; return; }
            try {
                const res = await fetch('/Test/SaveResults', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(practiceResults) });
                const data = await res.json(); window.location.href = data.redirectUrl;
            } catch (e) { window.location.href = `/Test/Map/${setId}`; }
        }

        render();
    </script>
}