@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Flashcards Maker</title>

    <script>
        const currentUserId = "@User.FindFirstValue(ClaimTypes.NameIdentifier)";

        function getCookie(name) {
            let value = "; " + document.cookie;
            let parts = value.split("; " + name + "=");
            if (parts.length === 2) return parts.pop().split(";").shift();
        }

        function applyTheme(bg, accent, btn) {
            if (!bg || !accent || !btn) return;
            const root = document.documentElement;

            root.style.setProperty('--bg-color', bg);
            root.style.setProperty('--accent-color', accent);
            root.style.setProperty('--btn-border', accent + '4D');
            root.style.setProperty('--btn-hover', btn);

            const lightBackgrounds = ["#FFFFFF", "#F8FAFC", "#F0F2F5", "#F5E8B7", "#EDE6D4"];
            const isLight = lightBackgrounds.includes(bg.toUpperCase());

            if (isLight) {
                root.style.setProperty('--text-color', '#1E293B');
                root.style.setProperty('--btn-text', '#1E293B');
            } else {
                root.style.setProperty('--text-color', '#DEE4C7');
                root.style.setProperty('--btn-text', '#DEE4C7');
            }

            if (currentUserId) {
                localStorage.setItem('UserTheme_' + currentUserId, `${bg}|${accent}|${btn}`);
            }
        }

        let themeData = null;
        if (currentUserId) {
            themeData = localStorage.getItem('UserTheme_' + currentUserId);
            if (!themeData) {
                const themeCookie = getCookie("UserTheme_" + currentUserId);
                if (themeCookie) themeData = decodeURIComponent(themeCookie);
            }
        }
        if (themeData) {
            const colors = themeData.split('|');
            if (colors.length === 3) {
                applyTheme(colors[0], colors[1], colors[2]);
            }
        }
    </script>

    <style>
        :root {
            --bg-color: #141B25;
            --text-color: #DEE4C7;
            --accent-color: #F0FFFF;
            --btn-bg: rgba(129, 131, 117, 0.1);
            --btn-border: rgba(129, 131, 117, 0.3);
            --btn-hover: rgba(107, 135, 137, 0.3);
            --btn-text: #DEE4C7;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background: var(--bg-color);
            margin: 0;
            color: var(--text-color);
            font-family: system-ui, sans-serif;
            display: flex;
            height: 100vh;
            overflow: hidden;
            transition: background 0.3s ease, color 0.3s ease;
        }

        h1, h2, h3, label, p {
            color: var(--text-color);
            transition: color 0.3s ease;
        }

        .nav-btn, .btn-main {
            color: var(--btn-text) !important;
        }

        aside {
            width: 300px;
            padding: 40px;
            display: flex;
            flex-direction: column;
            border-right: 2px solid rgba(240, 255, 255, 0.2);
            flex-shrink: 0;
            z-index: 20;
        }

        h1 {
            font-size: 1.5rem;
            margin: 0;
            text-shadow: 0 2px 10px rgba(0,0,0,0.5);
            color: var(--accent-color);
        }

        .line {
            width: 100%;
            height: 2px;
            background-color: var(--accent-color);
            margin-top: 10px;
            opacity: 0.8;
        }

        nav {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 30px;
            flex-grow: 1;
        }

        .nav-btn {
            background-color: var(--btn-bg);
            border: 1px solid var(--btn-border);
            color: var(--btn-text);
            padding: 12px;
            border-radius: 6px;
            text-decoration: none;
            text-align: center;
            font-size: 14px;
            transition: 0.3s ease;
            display: block;
        }

            .nav-btn:hover {
                background-color: var(--btn-hover);
                border-color: var(--accent-color);
                transform: translateX(8px);
            }

            .nav-btn.active {
                background-color: rgba(240, 255, 255, 0.15);
                border-color: var(--accent-color);
                color: var(--accent-color) !important;
                font-weight: 600;
                transform: translateX(5px);
            }

        .btn-exit {
            margin-top: auto;
            border-color: rgba(255, 100, 100, 0.2);
        }

        .content-area {
            flex-grow: 1;
            padding: 40px;
            overflow-y: auto;
        }

        @@media (max-width: 950px) {
            body {
                flex-direction: column;
                overflow-y: auto;
                height: auto;
            }

            aside {
                width: 100%;
                padding: 20px;
                border-right: none;
                border-bottom: 2px solid rgba(240, 255, 255, 0.2);
            }

            nav {
                flex-direction: row;
                flex-wrap: wrap;
                margin-top: 20px;
            }

            .nav-btn {
                flex: 1 1 140px;
            }

            .content-area {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <aside>
        <h1>Flashcards Maker</h1>
        <div class="line"></div>
        <nav>
            @{
                string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            }

            @if (User.IsInRole("Admin"))
            {
                
                <a asp-controller="Admin" asp-action="Reports"
                   class="nav-btn @(controller == "Admin" && (action == "Reports" || action == "SetDetails") ? "active" : "")">Скарги</a>

                <a asp-controller="Admin" asp-action="Users"
                   class="nav-btn @(controller == "Admin" && (action == "Users" || action == "UserDetails") ? "active" : "")">Користувачі</a>

                <a asp-controller="Admin" asp-action="Categories"
                   class="nav-btn @(action == "Categories" ? "active" : "")">Категорії</a>

                <a asp-controller="Admin" asp-action="Settings"
                   class="nav-btn @(controller == "Admin" && action == "Settings" ? "active" : "")">Налаштування</a>
            }
            else
            {
                <a asp-controller="Main" asp-action="Index"
                   class="nav-btn @(controller == "Main" && action == "Index" ? "active" : "")">Головна</a>
                <a asp-controller="MySets" asp-action="Index"
                   class="nav-btn @(controller == "MySets" ? "active" : "")">Мої сети</a>

                <a asp-controller="Collections" asp-action="Index"
                   class="nav-btn @(controller == "Collections" ? "active" : "")">Колекції</a>

                <a asp-controller="MyProfile" asp-action="Index"
                   class="nav-btn @(controller == "MyProfile" ? "active" : "")">Профіль</a>

                <a asp-controller="Settings" asp-action="Index"
                   class="nav-btn @(controller == "Settings" ? "active" : "")">Налаштування</a>
            }

            <form asp-controller="Account" asp-action="Logout" method="post" style="margin-top: auto;">
                <button type="submit" class="nav-btn btn-exit" style="width:100%; text-align:center; cursor: pointer;">Вийти</button>
            </form>

        </nav>
    </aside>

    <main class="content-area">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>