@using Core.DTOs
@model IEnumerable<SetDTO>

@{
    ViewData["Title"] = "Головна";
    var currentUserName = User.Identity?.Name;
}

<style>
    .search-container {
        display: flex;
        gap: 15px;
        margin-bottom: 30px;
        background: rgba(255, 255, 255, 0.03);
        padding: 15px;
        border-radius: 12px;
        border: 1px solid var(--btn-border);
        align-items: center;
    }

    .search-bar-form {
        display: flex;
        flex-grow: 1;
        gap: 10px;
    }

        .search-bar-form input {
            flex-grow: 1;
            background: #141B25;
            border: 1px solid #818375;
            color: white;
            padding: 12px 15px;
            border-radius: 8px;
            outline: none;
            font-family: inherit;
        }

    .sort-select {
        background: #141B25;
        border: 1px solid #818375;
        color: white;
        padding: 0 15px;
        border-radius: 8px;
        outline: none;
        cursor: pointer;
        min-width: 170px;
    }

    .btn-search {
        background: var(--accent-color);
        color: #141B25;
        border: none;
        padding: 0 25px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
        transition: 0.3s;
    }

    .sets-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
    }

    .set-card {
        background-color: var(--btn-bg);
        border: 1px solid var(--btn-border);
        border-radius: 12px;
        padding: 25px;
        min-height: 220px;
        display: flex;
        flex-direction: column;
        position: relative;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .set-card:hover {
            border-color: var(--accent-color);
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
        }

    .card-menu-btn {
        position: absolute;
        top: 15px;
        right: 15px;
        cursor: pointer;
        font-size: 1.5rem;
        line-height: 1;
        padding: 5px;
        z-index: 10;
        opacity: 0.5;
        transition: 0.3s;
    }

        .card-menu-btn:hover {
            opacity: 1;
            color: var(--accent-color);
        }

    .dropdown {
        position: absolute;
        top: 45px;
        right: 15px;
        background: #2C3440;
        border: 1px solid #818375;
        border-radius: 8px;
        display: none;
        flex-direction: column;
        z-index: 100;
        box-shadow: 0 8px 25px rgba(0,0,0,0.6);
        overflow: hidden;
    }

        .dropdown button {
            background: none;
            border: none;
            color: white;
            padding: 12px 20px;
            text-align: left;
            cursor: pointer;
            width: 100%;
            font-size: 0.9rem;
            font-family: inherit;
        }

            .dropdown button:hover {
                background-color: #6B8789;
            }

        .dropdown .btn-report-red:hover {
            background-color: rgba(255, 100, 100, 0.2);
            color: #ff8080;
        }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.85);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal {
        background: #1C2531;
        border: 1px solid var(--accent-color);
        padding: 30px;
        border-radius: 15px;
        width: 420px;
        max-width: 90%;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

        .modal select, .modal input, .modal textarea {
            background: #141B25;
            border: 1px solid #818375;
            color: white;
            padding: 12px;
            border-radius: 8px;
            outline: none;
            width: 100%;
            font-family: inherit;
        }

    .card-footer {
        margin-top: auto;
        padding-top: 15px;
        border-top: 1px solid rgba(240, 255, 255, 0.05);
    }

    .date-info {
        font-size: 0.7rem;
        opacity: 0.4;
        display: flex;
        justify-content: space-between;
    }

    .author-name {
        font-size: 0.75rem;
        opacity: 0.5;
        margin-bottom: 10px;
        display: block;
    }

    .my-set-tag {
        position: absolute;
        top: -10px;
        right: 15px;
        background: var(--accent-color);
        color: #141B25;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: bold;
    }
</style>

<div class="content-area">
    <h2 style="margin-bottom: 20px;">Всі навчальні сети</h2>

    <div class="search-container">
        <form asp-controller="Main" asp-action="Index" method="get" class="search-bar-form">
            <input type="text" name="searchText" placeholder="Шукати сети..." value="@ViewData["CurrentFilter"]" />
            <select name="sortOrder" class="sort-select" onchange="this.form.submit()">
                <!option value="newest" @(ViewData["CurrentSort"]?.ToString() == "newest" ? "selected" : "")>Спочатку нові</!option>
                <!option value="oldest" @(ViewData["CurrentSort"]?.ToString() == "oldest" ? "selected" : "")>Спочатку старі</!option>
            </select>
            <button type="submit" class="btn-search">Шукати</button>
        </form>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background: rgba(136, 255, 136, 0.1); color: #88ff88; border: 1px solid #88ff88; padding: 15px; border-radius: 10px; margin-bottom: 20px;">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="sets-grid">
        @foreach (var set in Model)
        {
            bool isMine = set.UserName == currentUserName;

            <div class="set-card @(isMine ? "owner-border" : "")"
                 onclick="handleCardClick(event, '@Url.Action("Sets", "DetailsInMain", new { id = set.Id })')">
                <div class="card-menu-btn" onclick="toggleMenu(event)">⋮</div>

                <div class="dropdown" onclick="event.stopPropagation()">
                    <button type="button" onclick="location.href='@Url.Action("UserProfile", "MyProfile", new { id = set.UserName })'">
                        Переглянути акаунт
                    </button>

                    <button type="button" class="btn-report-red" style="color: #ff8080;" onclick="openReportModal(event, '@set.Id', '@set.UserName')">
                        Поскаржитися
                    </button>

                    @if (!isMine)
                    {
                        <button type="button" onclick="openCollectModal(event, '@set.Id')">
                            Зберегти в колекцію
                        </button>
                    }
                </div>

                @if (isMine)
                {
                    <div class="my-set-tag">МІЙ СЕТ</div>
                }
                <span class="author-name">@(isMine ? "Ви створили" : $"Автор: {set.UserName}")</span>

                <h3 style="margin: 0 0 8px 0; color: var(--accent-color);">@set.Name</h3>
                <p style="opacity: 0.7; font-size: 0.9rem; margin: 0; flex-grow: 1;">@set.Description</p>

                <div class="card-footer">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                        <span style="font-size: 0.75rem; opacity: 0.6;">@set.FlashcardsCount карток</span>
                        <span style="font-size: 0.75rem; opacity: 0.6;">🌐 Публічний</span>
                    </div>
                    <div class="date-info">
                        <span>Оновлено:</span>
                        <span style="color: var(--accent-color); opacity: 0.8;">@set.LastUpdatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal-overlay" id="collectModal">
    <div class="modal">
        <form asp-controller="Main" asp-action="AddToCollection" method="post">
            <h2 style="color: var(--accent-color); margin: 0;">Зберегти сет</h2>
            <input type="hidden" name="setId" id="modalSetId" />
            <div style="display: flex; flex-direction: column; gap: 15px; margin-top: 20px;">
                <select name="collectionId">
                    <option value="">-- Оберіть папку --</option>
                    @if (ViewBag.UserCollections != null)
                    {
                        foreach (var col in ViewBag.UserCollections as IEnumerable<CollectionDTO>)
                        {
                            <option value="@col.Id">@col.Name</option>
                        }
                    }
                </select>
                <input type="text" name="newCollectionName" placeholder="Або впишіть нову назву..." />
                <div style="display: flex; gap: 10px; justify-content: flex-end;">
                    <button type="button" onclick="closeCollectModal()" style="background:none; border:none; color:#818375; cursor:pointer;">Скасувати</button>
                    <button type="submit" class="btn-search" style="width: auto;">Зберегти</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="reportModal">
    <div class="modal" style="border-color: #ff6464;">
        <form asp-controller="Main" asp-action="CreateReport" method="post">
            <h2 style="color: #ff6464; margin: 0;">Повідомити про порушення</h2>
            <input type="hidden" name="ReportedSetId" id="repSetId" />
            <input type="hidden" name="ReportedUserId" id="repUserId" />

            <div style="display: flex; flex-direction: column; gap: 15px; margin-top: 20px;">
                <label style="font-size: 0.85rem; opacity: 0.7;">Причина скарги:</label>
                <select name="Reason" required>
                    <option value="0">Спам</option>
                    <option value="1">Неприйнятний контент</option>
                    <option value="2">Образи або цькування</option>
                    <option value="3">Порушення авторських прав</option>
                    <option value="4">Інше</option>
                </select>

                <textarea name="CustomReason" placeholder="Опишіть проблему детальніше..." rows="4" style="resize: none;"></textarea>

                <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 10px;">
                    <button type="button" onclick="closeReportModal()" style="background:none; border:none; color:#818375; cursor:pointer;">Скасувати</button>
                    <button type="submit" class="btn-search" style="width: auto; background: #ff6464; color: white; border-color: #ff6464;">Надіслати</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const collectModal = document.getElementById('collectModal');
        const reportModal = document.getElementById('reportModal');

        function handleCardClick(event, url) {
            if (event.target.closest('.card-menu-btn') || event.target.closest('.dropdown')) return;
            window.location.href = url;
        }

        function toggleMenu(event) {
            event.stopPropagation();
            const dropdown = event.currentTarget.nextElementSibling;
            document.querySelectorAll('.dropdown').forEach(d => { if (d !== dropdown) d.style.display = 'none'; });
            dropdown.style.display = (dropdown.style.display === 'flex') ? 'none' : 'flex';
        }

        function openCollectModal(event, setId) {
            event.stopPropagation();
            document.getElementById('modalSetId').value = setId;
            collectModal.style.display = 'flex';
            document.querySelectorAll('.dropdown').forEach(d => d.style.display = 'none');
        }

        function openReportModal(event, setId, userId) {
            event.stopPropagation();
            document.getElementById('repSetId').value = setId;
            document.getElementById('repUserId').value = userId;
            reportModal.style.display = 'flex';
            document.querySelectorAll('.dropdown').forEach(d => d.style.display = 'none');
        }

        function closeCollectModal() { collectModal.style.display = 'none'; }
        function closeReportModal() { reportModal.style.display = 'none'; }

        window.onclick = (e) => {
            if (!e.target.matches('.card-menu-btn')) document.querySelectorAll('.dropdown').forEach(d => d.style.display = 'none');
            if (e.target === collectModal) closeCollectModal();
            if (e.target === reportModal) closeReportModal();
        };

        // Анімація карток
        document.querySelectorAll('.set-card').forEach((card, index) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            setTimeout(() => {
                card.style.transition = 'all 0.4s ease';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, index * 50);
        });
    </script>
}