@using Core.DTOs
@model IEnumerable<SetDTO>

@{
    ViewData["Title"] = "Головна";
    var currentUserName = User.Identity?.Name;
    var authorAvatars = ViewBag.AuthorAvatars as Dictionary<string, string>;
}

<style>

    .search-container {
        display: flex;
        gap: 15px;
        margin-bottom: 30px;
        background: rgba(255, 255, 255, 0.03);
        padding: 15px;
        border-radius: 12px;
        border: 1px solid var(--btn-border);
        align-items: center;
    }

    .search-bar-form {
        display: flex;
        flex-grow: 1;
        gap: 10px;
    }

        .search-bar-form input {
            flex-grow: 1;
            background: #141B25;
            border: 1px solid #818375;
            color: white;
            padding: 12px 15px;
            border-radius: 8px;
            outline: none;
            width: 100%;
        }

    .sort-select {
        background: #141B25;
        border: 1px solid #818375;
        color: white;
        padding: 0 15px;
        border-radius: 8px;
        outline: none;
        cursor: pointer;
        min-width: 170px;
        height: 45px;
    }

    .btn-search {
        background: var(--accent-color);
        color: #141B25;
        border: none;
        padding: 0 25px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        height: 45px;
        transition: 0.3s;
    }

    .sets-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
    }

    .set-card {
        background-color: var(--btn-bg);
        border: 1px solid var(--btn-border);
        border-radius: 12px;
        padding: 25px;
        min-height: 240px;
        display: flex;
        flex-direction: column;
        position: relative;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .set-card:hover {
            border-color: var(--accent-color);
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
        }

    .progress-mini-area {
        margin: 15px 0;
    }

    .progress-mini-label {
        display: flex;
        justify-content: space-between;
        font-size: 0.65rem;
        color: white;
        opacity: 0.5;
        margin-bottom: 5px;
    }

    .progress-mini-track {
        height: 5px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        overflow: hidden;
    }

    .progress-mini-fill {
        height: 100%;
        background: linear-gradient(135deg, #6e8efb, #a777e3);
        transition: width 0.8s ease;
    }

    .card-menu-btn {
        position: absolute;
        top: 15px;
        right: 15px;
        cursor: pointer;
        font-size: 1.5rem;
        opacity: 0.5;
        z-index: 10;
        padding: 5px;
    }

    .dropdown {
        position: absolute;
        top: 45px;
        right: 15px;
        background: #2C3440;
        border: 1px solid #818375;
        border-radius: 8px;
        display: none;
        flex-direction: column;
        z-index: 100;
        box-shadow: 0 8px 25px rgba(0,0,0,0.6);
        overflow: hidden;
    }

        .dropdown button {
            background: none;
            border: none;
            color: white;
            padding: 12px 20px;
            text-align: left;
            cursor: pointer;
            width: 100%;
            font-size: 0.9rem;
        }

            .dropdown button:hover {
                background-color: #6B8789;
            }

    .author-wrapper {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
    }

    .author-avatar-mini {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 1.5px solid var(--accent-color);
        overflow: hidden;
        background: #fff;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .author-avatar-mini img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .author-name {
        font-size: 0.75rem;
        opacity: 0.6;
    }

    .card-footer {
        margin-top: auto;
        padding-top: 15px;
        border-top: 1px solid rgba(240, 255, 255, 0.05);
    }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.85);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 2000;
    }

    .modal {
        background: #1C2531;
        border: 1px solid var(--accent-color);
        padding: 30px;
        border-radius: 15px;
        width: 420px;
        max-width: 90%;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

        .modal select, .modal input {
            background: #141B25;
            border: 1px solid #818375;
            color: white;
            padding: 12px;
            border-radius: 8px;
            outline: none;
            width: 100%;
        }

    @@media (max-width: 1000px) {
        .search-container {
            flex-direction: column;
            align-items: stretch;
            gap: 10px;
        }

        .search-bar-form {
            flex-direction: column;
        }

        .sort-select, .btn-search {
            width: 100% !important;
        }
    }
</style>

<div class="content-area">
    <h2 style="margin-bottom: 20px;">Всі навчальні сети</h2>

    <div class="search-container">
        <form asp-controller="Main" asp-action="Index" method="get" class="search-bar-form">
            <input type="text" name="searchText" placeholder="Шукати сети..." value="@ViewData["CurrentFilter"]" />

            <select name="categoryId" class="sort-select" onchange="this.form.submit()">
                <option value="">Усі категорії</option>
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in (IEnumerable<CategoryDTO>)ViewBag.Categories)
                    {
                        <!option value="@cat.Id" @(ViewData["CurrentCategory"]?.ToString() == cat.Id.ToString() ? "selected" : "")>@cat.Name</!option>
                    }
                }
            </select>

            <select name="sortOrder" class="sort-select" onchange="this.form.submit()">
                <!option value="newest" @(ViewData["CurrentSort"]?.ToString() == "newest" ? "selected" : "")>Спочатку нові</!option>
                <!option value="oldest" @(ViewData["CurrentSort"]?.ToString() == "oldest" ? "selected" : "")>Спочатку старі</!option>
            </select>

            <button type="submit" class="btn-search">Шукати</button>
        </form>
    </div>

    <div class="sets-grid">
        @foreach (var set in Model)
        {
            bool isMine = set.UserName == currentUserName;
            <div class="set-card" onclick="handleCardClick(event, '@Url.Action("Sets", "DetailsInMain", new { id = set.Id })')">

                <div class="card-menu-btn" onclick="toggleMenu(event)">⋮</div>
                <div class="dropdown" onclick="event.stopPropagation()">
 
                    <button type="button" onclick="location.href='@Url.Action("UserProfile", "MyProfile", new { username = set.UserName })'">Переглянути акаунт</button>
                    <button type="button" style="color: #ff8080;" onclick="openReportModal(event, '@set.Id', '@set.UserName')">Поскаржитися</button>
                    @if (!isMine)
                    {
                        <button type="button" onclick="openCollectModal(event, '@set.Id')">Зберегти в колекцію</button>
                    }
                </div>

                <div class="author-wrapper">
                    <div class="author-avatar-mini">
                        @{
                            string av = null; authorAvatars?.TryGetValue(set.UserName, out av);
                        }
                        @if (!string.IsNullOrEmpty(av))
                        {
                            <img src="@av" />
                        }
                        else
                        {

                            <span>👤</span>
                        }
                    </div>
                    <span class="author-name">Автор: @set.UserName</span>
                </div>

                <h3 style="margin: 0 0 8px 0; color: var(--accent-color);">@set.Name</h3>
                <p style="opacity: 0.7; font-size: 0.9rem; margin: 0; flex-grow: 1;">@set.Description</p>

                <div class="progress-mini-area">
                    <div class="progress-mini-label"><span>Прогрес вивчення</span><span>@set.Progress%</span></div>
                    <div class="progress-mini-track"><div class="progress-mini-fill" style="width: @set.Progress%"></div></div>
                </div>

                <div class="card-footer">
                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem;">
                        <span style="opacity: 0.6;">@set.FlashcardsCount карток</span>
                        <span style="opacity: 0.4;">@set.LastUpdatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal-overlay" id="collectModal">
    <div class="modal">
        <form asp-controller="Main" asp-action="AddToCollection" method="post">
            <h2 style="color: var(--accent-color); margin: 0; font-size: 1.2rem;">Зберегти сет</h2>
            <input type="hidden" name="setId" id="modalSetId" />
            <div style="display: flex; flex-direction: column; gap: 15px; margin-top: 20px;">
                <select name="collectionId">
                    <option value="">-- Оберіть папку --</option>
                    @if (ViewBag.UserCollections != null)
                    {
                        foreach (var col in ViewBag.UserCollections as IEnumerable<CollectionDTO>)
                        {
                            <option value="@col.Id">@col.Name</option>
                        }
                    }
                </select>

                <input type="text" name="newCollectionName" placeholder="Або впишіть нову назву..." />

                <div style="display: flex; gap: 10px; justify-content: flex-end;">
                    <button type="button" onclick="closeCollectModal()" style="background:none; border:none; color:#818375; cursor:pointer;">Скасувати</button>
                    <button type="submit" class="btn-search" style="width: auto; height: auto; padding: 10px 20px;">Зберегти</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="modal-overlay" id="reportModal">
    <div class="modal" style="border: 1px solid #ff6464;">
        <form asp-controller="Main" asp-action="CreateReport" method="post">
            <h2 style="color: #ff6464; margin: 0; font-size: 1.2rem;">Повідомити про порушення</h2>
            <input type="hidden" name="ReportedSetId" id="repSetId" />
            <input type="hidden" name="ReportedUserId" id="repUserId" />
            <div style="display: flex; flex-direction: column; gap: 15px; margin-top: 20px;">
                <select name="Reason" required>
                    <option value="0">Спам</option>
                    <option value="1">Неприйнятний контент</option>
                    <option value="4">Інше</option>
                </select>
                <div style="display: flex; gap: 10px; justify-content: flex-end;">
                    <button type="button" onclick="closeReportModal()" style="background:none; border:none; color:#818375; cursor:pointer;">Скасувати</button>
                    <button type="submit" class="btn-search" style="width: auto; height: auto; padding: 10px 20px; background: #ff6464; color: white;">Надіслати</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function handleCardClick(e, url) { if (!e.target.closest('.card-menu-btn') && !e.target.closest('.dropdown')) window.location.href = url; }
        function toggleMenu(e) {
            e.stopPropagation();
            const d = e.currentTarget.nextElementSibling;
            document.querySelectorAll('.dropdown').forEach(x => { if(x!==d) x.style.display='none'; });
            d.style.display = d.style.display === 'flex' ? 'none' : 'flex';
        }
        function openCollectModal(e, id) { e.stopPropagation(); document.getElementById('modalSetId').value = id; document.getElementById('collectModal').style.display = 'flex'; document.querySelectorAll('.dropdown').forEach(d => d.style.display = 'none');}
        function openReportModal(e, id, uid) { e.stopPropagation(); document.getElementById('repSetId').value = id; document.getElementById('repUserId').value = uid; document.getElementById('reportModal').style.display = 'flex'; document.querySelectorAll('.dropdown').forEach(d => d.style.display = 'none');}
        function closeCollectModal() { document.getElementById('collectModal').style.display = 'none'; }
        function closeReportModal() { document.getElementById('reportModal').style.display = 'none'; }
        window.onclick = (e) => {
            if (!e.target.matches('.card-menu-btn')) document.querySelectorAll('.dropdown').forEach(d => d.style.display = 'none');
            if (e.target.classList.contains('modal-overlay')) e.target.style.display = 'none';
        };
    </script>
}