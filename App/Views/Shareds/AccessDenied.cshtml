@{
    Layout = "_Layout";
    ViewData["Title"] = "403 - Доступ обмежено";
}

<style>
    .error-outer {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        color: white;
        font-family: 'Arial Black', sans-serif;
    }

    .cards-container {
        display: flex;
        gap: 20px;
        margin-bottom: 40px;
    }

    .card-stripe {
        background-color: #f5f5f5;
        width: 120px;
        height: 300px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 4px;
        box-shadow: 0 20px 0px -5px rgba(230, 57, 70, 0.4);
        transition: transform 0.3s;
    }

        .card-stripe:hover {
            transform: translateY(-5px);
        }

    .card-number {
        font-size: 100px;
        color: #000;
        margin: 0;
        line-height: 1;
    }

    .error-msg {
        text-align: center;
        max-width: 600px;
        padding: 0 20px;
    }

        .error-msg h2 {
            font-size: 1.8rem;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .error-msg p {
            font-family: 'Segoe UI', sans-serif;
            line-height: 1.6;
            color: #ccc;
            font-size: 1.1rem;
        }

    .btn-main {
        display: inline-block;
        margin-top: 30px;
        padding: 12px 40px;
        background-color: #e63946; 
        color: #fff;
        text-decoration: none;
        font-weight: bold;
        text-transform: uppercase;
        border-radius: 2px;
        transition: 0.3s;
        border: 2px solid #e63946;
    }

        .btn-main:hover {
            background-color: transparent;
            color: #e63946;
        }
</style>

<div class="error-outer">
    <div class="cards-container">
        <div class="card-stripe">
            <h1 class="card-number">4</h1>
        </div>
        <div class="card-stripe">
            <h1 class="card-number">0</h1>
        </div>
        <div class="card-stripe">
            <h1 class="card-number">3</h1>
        </div>
    </div>

    <div class="error-msg">
        <h2>Доступ обмежено</h2>
        <p>
            У вас немає прав на редагування або зміну цієї колоди карток.
            Ця дія доступна лише власнику набору або адміністратору.
        </p>

        <a href="/" class="btn-main">Повернутися на головну</a>
    </div>
</div>