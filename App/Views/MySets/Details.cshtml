@model Core.Models.Set

@{
    ViewData["Title"] = Model.Name;
}

<style>
    .set-header {
        margin-bottom: 30px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .set-info h2 {
        margin: 0;
        color: var(--accent-color);
        font-size: 2rem;
    }

    .set-info p {
        margin: 5px 0;
        opacity: 0.7;
    }

    /* Дизайн карток Питання-Відповідь */
    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
    }

    .flashcard-item {
        background: var(--btn-bg);
        border: 1px solid var(--btn-border);
        border-radius: 12px;
        padding: 25px;
        position: relative;
        transition: 0.3s ease;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

        .flashcard-item:hover {
            border-color: var(--accent-color);
            background: var(--btn-hover);
        }

    .card-term {
        font-weight: bold;
        font-size: 1.2rem;
        color: var(--accent-color);
        word-wrap: break-word;
    }

    .card-divider {
        height: 1px;
        background: rgba(240, 255, 255, 0.1);
        border: none;
    }

    .card-definition {
        font-size: 1rem;
        opacity: 0.8;
        line-height: 1.5;
    }

    /* Кнопки керування на картці */
    .card-controls {
        position: absolute;
        top: 10px;
        right: 10px;
        display: flex;
        gap: 5px;
    }

    .control-btn {
        background: none;
        border: none;
        color: var(--text-color);
        cursor: pointer;
        opacity: 0.4;
        font-size: 1rem;
        padding: 5px;
        transition: 0.2s;
    }

        .control-btn:hover {
            opacity: 1;
            color: var(--accent-color);
        }

    .btn-delete:hover {
        color: #ff8080;
    }

    /* Кнопка додавання */
    .add-btn-container {
        margin-top: 20px;
    }
</style>

<div class="set-header">
    <div class="set-info">
        <a asp-action="Index" style="color: var(--accent-color); text-decoration: none; font-size: 0.9rem;">← Назад до моїх сетів</a>
        <h2>@Model.Name</h2>
        <p>@Model.Description</p>
    </div>
    <button class="nav-btn" style="width: auto; padding: 10px 25px;" onclick="openCardModal()">+ Додати картку</button>
</div>

<div class="cards-grid">
    @foreach (var card in Model.Flashcards)
    {
        <div class="flashcard-item">
            <div class="card-controls">
                @* Передаємо дані в JS для редагування *@
                <button class="control-btn" onclick="editCard(@card.Id, '@card.Term', '@card.Definition')">✎</button>
                <button class="control-btn btn-delete" onclick="deleteCard(@card.Id)">✖</button>
            </div>
            <div class="card-term">@card.Term</div>
            <hr class="card-divider">
            <div class="card-definition">@card.Definition</div>
        </div>
    }
</div>

<!-- МОДАЛЬНЕ ВІКНО ДЛЯ КАРТОК (Створення/Редагування) -->
<div class="modal-overlay" id="cardModal">
    <div class="modal">
        <form asp-action="SaveCard" method="post">
            <h2 id="modalTitle" style="margin-top:0; color: var(--accent-color);">Нова картка</h2>

            <input type="hidden" name="Id" id="modalCardId" value="0">
            <input type="hidden" name="SetId" value="@Model.Id">

            <div style="margin-bottom: 15px;">
                <label style="display:block; margin-bottom:5px; font-size:0.8rem; opacity:0.6;">Термін (Питання)</label>
                <input type="text" name="Term" id="modalTerm" required style="width:100%; box-sizing:border-box;">
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display:block; margin-bottom:5px; font-size:0.8rem; opacity:0.6;">Визначення (Відповідь)</label>
                <textarea name="Definition" id="modalDefinition" required
                          style="width:100%; height:100px; background:var(--bg-color); border:1px solid #818375; color:white; border-radius:6px; padding:10px; outline:none; resize:none; font-family:inherit;"></textarea>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" onclick="closeCardModal()" style="background:none; border:none; color:#818375; cursor:pointer;">Скасувати</button>
                <button type="submit" style="background:#6B8789; color:white; border:none; padding:10px 20px; border-radius:5px; cursor:pointer; font-weight:bold;">Зберегти</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const modal = document.getElementById('cardModal');

        function openCardModal() {
            document.getElementById('modalTitle').innerText = "Нова картка";
            document.getElementById('modalCardId').value = "0";
            document.getElementById('modalTerm').value = "";
            document.getElementById('modalDefinition').value = "";
            modal.style.display = 'flex';
        }

        function editCard(id, term, definition) {
            document.getElementById('modalTitle').innerText = "Редагувати картку";
            document.getElementById('modalCardId').value = id;
            document.getElementById('modalTerm').value = term;
            document.getElementById('modalDefinition').value = definition;
            modal.style.display = 'flex';
        }

        function closeCardModal() {
            modal.style.display = 'none';
        }

        function deleteCard(id) {
            if (confirm("Видалити цю картку?")) {
                // Тут логіка відправки на сервер через Fetch або просто посилання
                // location.href = '/Sets/DeleteCard/' + id;
                console.log("Видаляємо картку: " + id);
            }
        }

        // Закриття модалки при кліку на фон
        window.onclick = (event) => {
            if (event.target == modal) closeCardModal();
        }
    </script>
}