@using Core.DTOs
@model IEnumerable<SetDTO>

@{
    ViewData["Title"] = "Мої сети";
}

<style>
    /* --- ДИЗАЙН СІТКИ ТА КАРТОК --- */
    .sets-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
        margin-top: 20px;
    }

    .set-card {
        background-color: var(--btn-bg);
        border: 1px solid var(--btn-border);
        border-radius: 12px;
        padding: 25px;
        min-height: 150px; 
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        position: relative;
        cursor: pointer;
        transition: all 0.3s ease;
        z-index: 1;
    }

        .set-card:hover {
            border-color: var(--accent-color);
            background-color: var(--btn-hover);
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
        }

    .create-card {
        border: 2px dashed rgba(240, 255, 255, 0.3);
        text-align: center;
        justify-content: center;
        background: transparent;
    }

    /* --- МЕНЮ ТРЬОХ КРАПОК --- */
    .card-menu-btn {
        position: absolute;
        top: 15px;
        right: 15px;
        cursor: pointer;
        font-size: 1.5rem;
        line-height: 1;
        padding: 5px;
        z-index: 10;
        opacity: 0.5;
        transition: 0.3s;
    }

        .card-menu-btn:hover {
            opacity: 1;
            color: var(--accent-color);
        }

    .dropdown {
        position: absolute;
        top: 45px;
        right: 15px;
        background: #2C3440;
        border: 1px solid #818375;
        border-radius: 8px;
        display: none;
        flex-direction: column;
        z-index: 100;
        box-shadow: 0 8px 25px rgba(0,0,0,0.6);
        overflow: hidden;
    }

        .dropdown button, .dropdown a {
            background: none;
            border: none;
            color: white;
            padding: 12px 20px;
            text-decoration: none;
            font-size: 0.9rem;
            text-align: left;
            cursor: pointer;
            width: 100%;
        }

            .dropdown button:hover, .dropdown a:hover {
                background-color: #6B8789;
            }

    /* --- ПАНЕЛЬ ПОШУКУ --- */
    .search-bar {
        display: flex;
        gap: 15px;
        margin-bottom: 30px;
        background: rgba(255, 255, 255, 0.03);
        padding: 15px;
        border-radius: 12px;
        border: 1px solid var(--btn-border);
    }

        .search-bar input {
            flex-grow: 1;
            background: #141B25;
            border: 1px solid #818375;
            color: white;
            padding: 12px 15px;
            border-radius: 8px;
            outline: none;
            font-family: inherit;
        }

            .search-bar input:focus {
                border-color: var(--accent-color);
            }

    .btn-search {
        background: var(--accent-color);
        color: #141B25;
        border: none;
        padding: 0 25px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
        transition: 0.3s;
    }

        .btn-search:hover {
            background: #fff;
            transform: translateY(-2px);
        }

    /* --- НИЖНЯ ЧАСТИНА КАРТКИ (ДАТИ ТА КІЛЬКІСТЬ) --- */
    .card-footer {
        margin-top: auto;
        padding-top: 15px;
        border-top: 1px solid rgba(240, 255, 255, 0.05);
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .date-info {
        font-size: 0.7rem;
        opacity: 0.4;
        display: flex;
        justify-content: space-between;
    }

    .sets-count-badge {
        background: rgba(240, 255, 255, 0.1);
        color: var(--accent-color);
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: bold;
        width: fit-content;
        margin-bottom: 5px;
    }

    /* --- МОДАЛЬНЕ ВІКНО --- */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.8);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal {
        background: #1C2531;
        border: 1px solid var(--accent-color);
        padding: 30px;
        border-radius: 15px;
        width: 420px;
        max-width: 90%;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
</style>

<div class="content-area">
    <h2 style="margin-bottom: 20px;">Ваші навчальні сети</h2>

    <!-- ФОРМА ПОШУКУ -->
    <form asp-controller="MySets" asp-action="Index" method="get" class="search-bar">
        <input type="text" name="searchText"
               placeholder="Пошук по назві ваших сетів..."
               value="@ViewData["CurrentFilter"]" />
        <button type="submit" class="btn-search">Шукати</button>
        @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
        {
            <a asp-action="Index" style="color: var(--accent-color); text-decoration: none; align-self: center; margin-left: 10px;">Скинути</a>
        }
    </form>

    <div class="sets-grid">
        @* Картка створення *@
        <div class="set-card create-card" onclick="openCreateModal()">
            <div style="font-size: 3rem; color: var(--accent-color); line-height: 1;">+</div>
            <div style="margin-top: 10px; font-weight: 500;">Створити новий сет</div>
        </div>

        @foreach (var set in Model)
        {
            <div class="set-card" onclick="handleCardClick(event, '@Url.Action("Index", "Details", new { id = set.Id })')">
                <div class="card-menu-btn" onclick="toggleMenu(event)">⋮</div>

                <div class="dropdown" onclick="event.stopPropagation()">
                    <button type="button" onclick="openEditModal(event, '@set.Id', '@set.Name', '@set.Description', '@set.IsPublic'.toLowerCase())">Редагувати</button>
                    <a asp-controller="MySets" asp-action="Delete" asp-route-id="@set.Id"
                       onclick="event.stopPropagation(); return confirm('Видалити цей сет?')">Видалити</a>
                </div>

                <h3 style="margin: 0 0 8px 0; color: var(--accent-color);">@set.Name</h3>
                <p style="opacity: 0.7; font-size: 0.9rem; margin: 0; flex-grow: 1;">@set.Description</p>

                @* ФУТЕР КАРТКИ *@
                <div class="card-footer">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span class="sets-count-badge">@set.FlashcardsCount карток</span>
                        <span style="font-size: 0.75rem; opacity: 0.6;">@(set.IsPublic ? "🌐 Публічний" : "🔒 Приватний")</span>
                    </div>

                    <div class="date-info">
                        <span>Створено:</span>
                        <span>@set.CreatedAt.ToString("dd.MM.yyyy")</span>
                    </div>
                    <div class="date-info">
                        <span>Оновлено:</span>
                        <span style="color: var(--accent-color); opacity: 0.8;">@set.LastUpdatedAt.ToString("HH:mm") сьогодні</span>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any() && !string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
    {
        <div style="text-align: center; padding: 40px; opacity: 0.5;">
            Нічого не знайдено за запитом "@ViewData["CurrentFilter"]"
        </div>
    }
</div>

@* Універсальна модалка *@
<div class="modal-overlay" id="setModal">
    <div class="modal">
        <form id="setForm" method="post">
            <h2 id="modalTitle">Сет</h2>
            <input type="hidden" name="Id" id="setIdField" value="">
            <div style="display: flex; flex-direction: column; gap: 5px;">
                <label style="font-size: 0.8rem; opacity: 0.6;">Назва сету</label>
                <input type="text" name="Name" id="setNameField" required placeholder="Наприклад: Англійська B2"
                       style="background: #141B25; border: 1px solid #818375; color: white; padding: 12px; border-radius: 8px; outline: none; width: 100%; box-sizing: border-box;">
            </div>
            <div style="display: flex; flex-direction: column; gap: 5px;">
                <label style="font-size: 0.8rem; opacity: 0.6;">Опис</label>
                <input type="text" name="Description" id="setDescField" placeholder="Короткий опис"
                       style="background: #141B25; border: 1px solid #818375; color: white; padding: 12px; border-radius: 8px; outline: none; width: 100%; box-sizing: border-box;">
            </div>
            <div class="toggle-row">
                <span>Зробити публічним</span>
                <label class="switch">
                    <input type="checkbox" name="IsPublic" id="setPublicField" value="true">
                    <span class="slider"></span>
                </label>
            </div>
            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 15px;">
                <button type="button" onclick="closeModal()" style="background:none; border:none; color:#818375; cursor:pointer;">Скасувати</button>
                <button type="submit" style="background:#6B8789; color:white; border:none; padding:10px 25px; border-radius:6px; cursor:pointer; font-weight:bold;">Зберегти</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const modal = document.getElementById('setModal');
        const form = document.getElementById('setForm');

        function openCreateModal() {
            document.getElementById('modalTitle').innerText = "Новий навчальний сет";
            form.action = "@Url.Action("Create", "MySets")";
            document.getElementById('setIdField').value = "";
            document.getElementById('setNameField').value = "";
            document.getElementById('setDescField').value = "";
            document.getElementById('setPublicField').checked = true;
            modal.style.display = 'flex';
        }

        function openEditModal(event, id, name, desc, isPublic) {
            event.stopPropagation();
            document.getElementById('modalTitle').innerText = "Редагувати сет";
            form.action = "@Url.Action("Edit", "MySets")";
            document.getElementById('setIdField').value = id;
            document.getElementById('setNameField').value = name;
            document.getElementById('setDescField').value = desc;
            document.getElementById('setPublicField').checked = (isPublic === 'true');
            modal.style.display = 'flex';
        }

        function closeModal() { modal.style.display = 'none'; }

        function handleCardClick(event, url) {
            if (event.target.closest('.card-menu-btn') || event.target.closest('.dropdown')) {
                return;
            }
            window.location.href = url;
        }

        function toggleMenu(event) {
            event.stopPropagation();
            const btn = event.currentTarget;
            const dropdown = btn.nextElementSibling;
            document.querySelectorAll('.dropdown').forEach(d => {
                if (d !== dropdown) d.style.display = 'none';
            });
            dropdown.style.display = (dropdown.style.display === 'flex') ? 'none' : 'flex';
        }

        window.onclick = (e) => {
            if (!e.target.matches('.card-menu-btn')) {
                document.querySelectorAll('.dropdown').forEach(d => d.style.display = 'none');
            }
            if (e.target === modal) closeModal();
        };
    </script>
}