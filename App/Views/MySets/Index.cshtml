@using Core.DTOs
@model IEnumerable<SetDTO>

@{
    ViewData["Title"] = "Мої сети";
}

<div class="content-area">
    <h2>Ваші навчальні сети</h2>
    <div class="sets-grid">

        
        <div class="set-card create-card" onclick="openModal()">
            <div style="font-size: 2.5rem; color: var(--accent-color);">+</div>
            <div>Створити сет</div>
        </div>

       
        @foreach (var set in Model)
        {
            <div class="set-card" onclick="location.href='@Url.Action("Details", "Sets", new { id = set.Id })'">

                <!-- Меню трьох крапок -->
                <div class="card-menu-btn" onclick="toggleMenu(event)">⋮</div>
                <div class="dropdown">
                    @* Посилання на C# екшени *@
                    <a asp-action="Edit" asp-route-id="@set.Id">Редагувати</a>
                    <a asp-action="Delete" asp-route-id="@set.Id" class="text-danger">Видалити</a>
                </div>

                <h3>@set.Name</h3>
                <p style="opacity: 0.7; font-size: 0.9rem;">@set.Description</p>
                <p style="font-size: 0.8rem; margin-top: 5px;">@set.FlashcardsCount карток</p>

                <div style="font-size: 0.7rem; margin-top: 10px; opacity: 0.5">
                    @if (set.IsPublic)
                    {
                        <span>🌐 Публічний</span>
                    }
                    else
                    {
                        <span>🔒 Приватний</span>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- МОДАЛКА (для створення) -->
<div class="modal-overlay" id="modalOverlay">
    <div class="modal">
        <form asp-action="Create" method="post">
            <h2 style="margin: 0 0 15px 0; color: var(--accent-color);">Новий сет</h2>

            <input type="text" name="Name" placeholder="Назва сету" required
                   style="width: 100%; margin-bottom: 10px;">

            <input type="text" name="Description" placeholder="Опис"
                   style="width: 100%; margin-bottom: 10px;">

            <div class="toggle-row">
                <span>Зробити публічним</span>
                <label class="switch">
                    @* checked за замовчуванням *@
                    <input type="checkbox" name="IsPublic" value="true" checked>
                    <span class="slider"></span>
                </label>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px;">
                <button type="button" onclick="closeModal()" style="background:none; border:none; color:#818375; cursor:pointer;">Скасувати</button>
                <button type="submit" style="background:#6B8789; color:white; border:none; padding:10px 20px; border-radius:5px; cursor:pointer; font-weight:bold;">Зберегти</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openModal() { document.getElementById('modalOverlay').style.display = 'flex'; }
        function closeModal() { document.getElementById('modalOverlay').style.display = 'none'; }

        function toggleMenu(event) {
            event.stopPropagation(); // щоб не спрацював перехід на Details
            const dropdown = event.target.nextElementSibling;
            document.querySelectorAll('.dropdown').forEach(d => { if(d !== dropdown) d.style.display = 'none'; });
            dropdown.style.display = dropdown.style.display === 'flex' ? 'none' : 'flex';
        }

        window.onclick = () => document.querySelectorAll('.dropdown').forEach(d => d.style.display = 'none');
    </script>
}