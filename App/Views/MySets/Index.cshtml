@using Core.DTOs
@model IEnumerable<SetDTO>

@{
    ViewData["Title"] = "Мої сети";
}

<style>
    .filter-container {
        display: flex;
        gap: 15px;
        margin-bottom: 30px;
        background: rgba(255, 255, 255, 0.03);
        padding: 15px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        align-items: center;
    }

    .filter-form {
        display: flex;
        flex-grow: 1;
        gap: 12px;
    }

        .filter-form input, .sort-select {
            flex-grow: 1;
            background: #141B25 !important;
            border: 1px solid #818375 !important;
            color: white !important;
            padding: 10px 15px !important;
            border-radius: 8px !important;
            outline: none;
            height: 45px;
        }

    .btn-search {
        background: #f4a261 !important;
        color: #141B25 !important;
        border: none !important;
        padding: 0 25px !important;
        border-radius: 8px !important;
        cursor: pointer;
        font-weight: bold;
        height: 45px;
    }

    .sets-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
        margin-top: 20px;
    }

    .set-card {
        background-color: var(--btn-bg);
        border: 1px solid var(--btn-border);
        border-radius: 12px;
        padding: 25px;
        min-height: 170px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        position: relative;
        cursor: pointer;
        transition: 0.3s ease;
    }

        .set-card:hover {
            border-color: var(--accent-color);
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
        }

    .create-card {
        border: 2px dashed rgba(240, 255, 255, 0.2);
        text-align: center;
        justify-content: center;
        background: transparent;
    }

    .card-footer {
        margin-top: auto;
        padding-top: 10px;
        border-top: 1px solid rgba(240, 255, 255, 0.05);
    }

    .sets-count-badge {
        background: rgba(240, 255, 255, 0.1);
        color: var(--accent-color);
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: bold;
    }

    .card-menu-btn {
        position: absolute;
        top: 15px;
        right: 15px;
        cursor: pointer;
        font-size: 1.5rem;
        opacity: 0.5;
        z-index: 10;
        padding: 5px;
    }

    .dropdown {
        position: absolute;
        top: 45px;
        right: 15px;
        background: #2C3440;
        border: 1px solid #818375;
        border-radius: 8px;
        display: none;
        flex-direction: column;
        z-index: 100;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }

        .dropdown button, .dropdown form button {
            background: none;
            border: none;
            color: white;
            padding: 10px 20px;
            font-size: 0.9rem;
            cursor: pointer;
            text-align: left;
            width: 100%;
            display: block;
        }

            .dropdown button:hover, .dropdown form button:hover {
                background-color: #6B8789;
            }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.85);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal {
        background: #1C2531;
        border: 1px solid var(--accent-color);
        padding: 20px;
        border-radius: 15px;
        width: 460px;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

        .modal label {
            font-size: 0.75rem;
            opacity: 0.6;
            margin-top: 5px;
            color: white;
        }

        .modal input, .modal select, .modal textarea {
            background: #141B25;
            border: 1px solid #818375;
            color: white;
            padding: 10px 12px;
            border-radius: 8px;
            outline: none;
            box-sizing: border-box;
            font-family: inherit;
            width: 100%;
        }

    .stepper {
        display: flex;
        align-items: center;
        background: #141B25;
        border: 1px solid #818375;
        border-radius: 8px;
        overflow: hidden;
        width: 100%;
    }

        .stepper button {
            background: none;
            border: none;
            color: var(--accent-color);
            width: 40px;
            height: 42px;
            cursor: pointer;
            font-size: 1.2rem;
        }

        .stepper input {
            width: 100% !important;
            border: none !important;
            text-align: center !important;
            padding: 0 !important;
            background: none !important;
            font-weight: bold;
        }

    .ai-preview-container {
        background: rgba(0,0,0,0.2);
        border: 1px solid #444;
        border-radius: 8px;
        padding: 8px;
        max-height: 120px;
        overflow-y: auto;
        display: none;
        margin-top: 5px;
    }

    .btn-ai {
        background: #f4a261;
        color: #141B25;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .modal-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid #333;
        padding-top: 15px;
        margin-top: 10px;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 20px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #444;
        transition: .4s;
        border-radius: 20px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 14px;
            width: 14px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #6B8789;
    }

        input:checked + .slider:before {
            transform: translateX(20px);
        }

    .spinner-mini {
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,0.2);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<div class="content-area">
    <h2>Ваші навчальні сети</h2>

    <div class="filter-container">
        <form asp-controller="MySets" asp-action="Index" method="get" class="filter-form">
            <input type="text" name="searchText" placeholder="Пошук..." value="@ViewData["CurrentFilter"]" />
            <select name="categoryId" class="sort-select" onchange="this.form.submit()">
                <option value="">Усі категорії</option>
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in (IEnumerable<CategoryDTO>)ViewBag.Categories)
                    {
                        <!option value="@cat.Id" @(ViewData["CurrentCategory"]?.ToString() == cat.Id.ToString() ? "selected" : "")>@cat.Name</!option>
                    }
                }
            </select>
            <button type="submit" class="btn-search">Шукати</button>
        </form>
    </div>

    <div class="sets-grid">
        <div class="set-card create-card" onclick="openCreateModal()">
            <div style="font-size: 3rem; color: var(--accent-color);">+</div>
            <div style="font-weight: 500;">Створити новий сет</div>
        </div>

        @foreach (var set in Model)
        {
            <div class="set-card" onclick="handleCardClick(event, '@Url.Action("Index", "Details", new { id = set.Id })')">
                <div class="card-menu-btn" onclick="toggleMenu(event)">⋮</div>
                <div class="dropdown" onclick="event.stopPropagation()">
                    <button type="button" onclick="openEditModal(event, '@set.Id', '@set.Name', '@set.Description', '@set.IsPublic'.toLowerCase(), '@((int)set.Type)')">Редагувати</button>

                    <form asp-action="Delete" method="post" onsubmit="return confirm('Видалити цей сет?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@set.Id" />
                        <button type="submit" style="color: #ff8080;">Видалити</button>
                    </form>
                </div>
                <h3 style="margin: 0 0 8px 0; color: var(--accent-color);">@set.Name</h3>
                <p style="opacity: 0.7; font-size: 0.9rem; margin: 0; flex-grow: 1;">@set.Description</p>
                <div class="card-footer">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span class="sets-count-badge">@set.FlashcardsCount карток</span>
                        @if (set.FlashcardsCount > 5)
                        {
                            <span style="font-size: 0.7rem; color: #f4a261; font-weight: bold;">✨ ШІ</span>
                        }
                    </div>
                    <div style="font-size: 0.65rem; opacity: 0.4; display: flex; justify-content: space-between; margin-top: 5px;">
                        <span>@((int)set.Type == 0 ? "Мова" : "Предмет")</span>
                        <span>@set.CreatedAt.ToString("dd.MM.yyyy")</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* МОДАЛКА *@
<div class="modal-overlay" id="setModal">
    <div class="modal">
        <form id="setForm" method="post" action="">
            @Html.AntiForgeryToken()
            <h2 id="modalTitle" style="margin: 0; font-size: 1.2rem;">Новий сет</h2>
            <input type="hidden" name="Id" id="setIdField">

            <div style="display: flex; gap: 10px; align-items: flex-end;">
                <div style="flex: 2; display: flex; flex-direction: column;">
                    <label>Тип навчання</label>
                    <select name="Type" id="setTypeField" onchange="toggleLanguageSelection()">
                        <option value="0">Мова (Language)</option>
                        <option value="1">Предмет (Subject)</option>
                    </select>
                </div>
                <div style="flex: 1; display: flex; flex-direction: column;">
                    <label>К-сть карток</label>
                    <div class="stepper">
                        <button type="button" onclick="stepCount(-1)">−</button>
                        <input type="number" id="aiCount" value="10" min="1" max="30" readonly>
                        <button type="button" onclick="stepCount(1)">+</button>
                    </div>
                </div>
            </div>

            <div id="languageSelectionRow" style="display: none; align-items: center; gap: 8px;">
                <div style="flex: 1;"><label>Вивчаю</label><select id="learnLangList" name="LearnLanguage"></select></div>
                <div style="margin-top: 22px; color: var(--accent-color);">→</div>
                <div style="flex: 1;"><label>На яку</label><select id="nativeLangList" name="NativeLanguage"></select></div>
            </div>

            <label>Назва сету</label>
            <input type="text" name="Name" id="setNameField" required />

            <label>Опис (Промпт для ШІ)</label>
            <textarea name="Description" id="setDescField" rows="2" style="resize: none;"></textarea>

            <div id="aiPreviewArea" class="ai-preview-container"><div id="aiCardsList"></div><input type="hidden" name="GeneratedCardsJson" id="generatedCardsJson" /></div>

            <div style="display: flex; justify-content: flex-end; align-items: center; gap: 8px; margin: 8px 0;">
                <span style="font-size: 0.75rem; opacity: 0.7;">Зробити публічним</span>
                <label class="switch"><input type="checkbox" name="IsPublic" id="setPublicField" checked value="true"><span class="slider"></span></label>
            </div>

            <div class="modal-footer">
                <button type="button" onclick="closeModal()" style="background: none; border: none; color: #818375; cursor: pointer; font-weight: bold;">Скасувати</button>
                <div style="display: flex; gap: 8px;">
                    <button type="button" id="btnAiGen" class="btn-ai" onclick="generateWithAI()">✨ ШІ</button>
                    <button type="submit" style="background: #6B8789; color: white; border: none; padding: 10px 20px; border-radius: 8px; font-weight: bold; cursor: pointer;">Зберегти</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const modal = document.getElementById('setModal');
        const setForm = document.getElementById('setForm');
        let tempCards = [];

        function stepCount(val) {
            const input = document.getElementById('aiCount');
            let res = parseInt(input.value) + val;
            if (res >= 1 && res <= 30) input.value = res;
        }

        function openCreateModal() {
            document.getElementById('modalTitle').innerText = "Новий сет";
            setForm.action = "/MySets/Create";
            setForm.reset();
            document.getElementById('aiPreviewArea').style.display = 'none';
            toggleLanguageSelection();
            modal.style.display = 'flex';
        }

        function openEditModal(e, id, name, desc, isPublic, type) {
            e.stopPropagation();
            document.getElementById('modalTitle').innerText = "Редагувати сет";
            setForm.action = "/MySets/Edit";
            document.getElementById('setIdField').value = id;
            document.getElementById('setNameField').value = name;
            document.getElementById('setDescField').value = desc;
            document.getElementById('setPublicField').checked = (isPublic === 'true');
            document.getElementById('setTypeField').value = type;
            document.getElementById('aiPreviewArea').style.display = 'none';
            toggleLanguageSelection();
            modal.style.display = 'flex';
            closeAllDropdowns();
        }

        async function generateWithAI() {
            const prompt = document.getElementById('setDescField').value;
            const count = document.getElementById('aiCount').value;
            const btn = document.getElementById('btnAiGen');
            if (!prompt) { alert("Вкажіть опис!"); return; }
            btn.disabled = true; btn.innerHTML = '<span class="spinner-mini"></span>...';
            try {
                const response = await fetch(`/api/sets/generate?prompt=${encodeURIComponent(prompt)}&count=${count}`);
                tempCards = await response.json();
                const listDiv = document.getElementById('aiCardsList');
                listDiv.innerHTML = '';
                tempCards.forEach((c, i) => {
                    listDiv.innerHTML += `<div style="display:flex; justify-content:space-between; font-size:0.75rem; padding:4px; border-bottom:1px solid #333;"><span><b>${c.term}</b> - ${c.definition}</span><span onclick="removeAiCard(${i})" style="color:#ff8080; cursor:pointer;">✕</span></div>`;
                });
                document.getElementById('aiPreviewArea').style.display = 'block';
                document.getElementById('generatedCardsJson').value = JSON.stringify(tempCards);
            } catch (e) { alert("Помилка ШІ."); }
            finally { btn.disabled = false; btn.innerHTML = "✨ ШІ"; }
        }

        function removeAiCard(i) {
            tempCards.splice(i, 1);
            document.getElementById('generatedCardsJson').value = JSON.stringify(tempCards);
            const listDiv = document.getElementById('aiCardsList');
            if(listDiv.children[i]) listDiv.children[i].style.display = 'none';
        }

        function toggleLanguageSelection() { document.getElementById('languageSelectionRow').style.display = document.getElementById('setTypeField').value === "0" ? 'flex' : 'none'; }
        function closeModal() { modal.style.display = 'none'; }
        function toggleMenu(e) { e.stopPropagation(); closeAllDropdowns(); const d = e.currentTarget.nextElementSibling; d.style.display = 'flex'; }
        function closeAllDropdowns() { document.querySelectorAll('.dropdown').forEach(d => d.style.display = 'none'); }
        function handleCardClick(e, url) { if (!e.target.closest('.card-menu-btn') && !e.target.closest('.dropdown')) window.location.href = url; }
        window.onclick = (e) => { if (!e.target.matches('.card-menu-btn')) closeAllDropdowns(); if (e.target === modal) closeModal(); };

        const languages = [ { code: "uk", name: "Українська" }, { code: "en", name: "Англійська" }, { code: "de", name: "Німецька" } ];
        document.addEventListener("DOMContentLoaded", () => {
            const l1 = document.getElementById('learnLangList'); const l2 = document.getElementById('nativeLangList');
            languages.forEach(l => { l1.add(new Option(l.name, l.code)); l2.add(new Option(l.name, l.code)); });
            l1.value = "en"; l2.value = "uk";
        });
    </script>
}