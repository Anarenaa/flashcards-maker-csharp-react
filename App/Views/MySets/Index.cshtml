@using Core.DTOs
@using Core.Models
@model IEnumerable<SetDTO>

@{
    ViewData["Title"] = "Мої сети";
}

<style>
    .filter-container {
        display: flex;
        gap: 15px;
        margin-bottom: 30px;
        background: rgba(255, 255, 255, 0.03);
        padding: 15px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        align-items: center;
    }

    .filter-form {
        display: flex;
        flex-grow: 1;
        gap: 12px;
        align-items: center;
    }

        .filter-form input[type="text"] {
            flex: 3;
            background: #141B25 !important;
            border: 1px solid #818375 !important;
            color: white !important;
            padding: 10px 15px !important;
            border-radius: 8px !important;
            outline: none;
            height: 45px;
        }

    .sort-select, .btn-search {
        flex: 1;
        min-width: 160px;
        max-width: 180px;
        height: 45px;
        background: #141B25 !important;
        border: 1px solid #818375 !important;
        color: white !important;
        border-radius: 8px !important;
        outline: none;
        cursor: pointer;
    }

    .btn-search {
        background: #f4a261 !important;
        color: #141B25 !important;
        border: none !important;
        font-weight: bold;
    }

    .sets-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
        margin-top: 20px;
    }

    .set-card {
        background-color: var(--btn-bg);
        border: 1px solid var(--btn-border);
        border-radius: 12px;
        padding: 25px;
        min-height: 190px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        position: relative;
        cursor: pointer;
        transition: 0.3s ease;
    }

        .set-card:hover {
            border-color: var(--accent-color);
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
        }

    .card-footer {
        margin-top: auto;
        padding-top: 10px;
        border-top: 1px solid rgba(240, 255, 255, 0.05);
    }

    .sets-count-badge {
        background: rgba(240, 255, 255, 0.1);
        color: var(--accent-color);
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: bold;
        width: fit-content;
    }

    .date-info {
        font-size: 0.65rem;
        opacity: 0.4;
        display: flex;
        justify-content: space-between;
        margin-top: 8px;
        color: white;
    }

    .card-menu-btn {
        position: absolute;
        top: 15px;
        right: 15px;
        cursor: pointer;
        font-size: 1.5rem;
        opacity: 0.5;
        z-index: 20;
        padding: 5px;
    }

    .dropdown {
        position: absolute;
        top: 45px;
        right: 15px;
        background: #2C3440;
        border: 1px solid #818375;
        border-radius: 8px;
        display: none;
        flex-direction: column;
        z-index: 100;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }

        .dropdown button, .dropdown form button {
            background: none;
            border: none;
            color: white;
            padding: 10px 20px;
            font-size: 0.9rem;
            cursor: pointer;
            text-align: left;
            width: 100%;
            display: block;
        }

            .dropdown button:hover, .dropdown form button:hover {
                background-color: #6B8789;
            }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.85);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal {
        background: #1C2531;
        border: 1px solid var(--accent-color);
        padding: 20px;
        border-radius: 15px;
        width: 460px;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .field-block {
        display: flex;
        flex-direction: column;
        width: 100%;
        margin-bottom: 2px;
    }

        .field-block label {
            font-size: 0.75rem;
            opacity: 0.6;
            margin-bottom: 2px;
            color: white;
        }

    .modal input, .modal select, .modal textarea {
        background: #141B25;
        border: 1px solid #818375;
        color: white !important;
        padding: 10px;
        border-radius: 8px;
        outline: none;
        box-sizing: border-box;
        font-family: inherit;
        width: 100%;
    }

    .stepper {
        display: flex;
        align-items: center;
        background: #141B25;
        border: 1px solid #818375;
        border-radius: 8px;
        overflow: hidden;
        height: 42px;
    }

        .stepper button {
            background: none;
            border: none;
            color: var(--accent-color);
            width: 40px;
            height: 100%;
            cursor: pointer;
            font-size: 1.2rem;
        }

        .stepper input {
            width: 50px !important;
            border: none !important;
            text-align: center !important;
            padding: 0 !important;
            background: none !important;
            font-weight: bold;
            color: white !important;
        }

    input::-webkit-outer-spin-button, input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .ai-preview-container {
        background: rgba(0,0,0,0.2);
        border: 1px solid #444;
        border-radius: 8px;
        padding: 8px;
        max-height: 120px;
        overflow-y: auto;
        display: none;
        margin-bottom: 5px;
    }

    .modal-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid #333;
        padding-top: 15px;
        margin-top: 10px;
    }

    .btn-ai {
        background: #f4a261;
        color: #141B25 !important;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .spinner-mini {
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,0.2);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 20px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #444;
        transition: .4s;
        border-radius: 20px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 14px;
            width: 14px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #6B8789;
    }

        input:checked + .slider:before {
            transform: translateX(20px);
        }
</style>

<div class="content-area">
    <h2>Ваші навчальні сети</h2>

    <div class="filter-container">
        <form asp-controller="MySets" asp-action="Index" method="get" class="filter-form">
            <input type="text" name="searchText" placeholder="Пошук ваших сетів..." value="@ViewData["CurrentFilter"]" />

            <select name="categoryId" class="sort-select" onchange="this.form.submit()">
                <option value="">Усі категорії</option>
                @if (ViewBag.Categories != null)
                {
                    @foreach (var cat in ViewBag.Categories)
                    {
                        <option value="@cat.Id" selected="@(ViewData["CurrentCategory"]?.ToString() == cat.Id.ToString())">@cat.Name</option>
                    }
                }
            </select>

            <select name="sortOrder" class="sort-select" onchange="this.form.submit()">
                <!option value="newest" @(ViewData["CurrentSort"]?.ToString() == "newest" ? "selected" : "")>Спочатку нові</!option>
                <!option value="oldest" @(ViewData["CurrentSort"]?.ToString() == "oldest" ? "selected" : "")>Спочатку старі</!option>
            </select>

            <button type="submit" class="btn-search">Шукати</button>
        </form>
    </div>

    <div class="sets-grid">
        <div class="set-card create-card" onclick="openCreateModal()">
            <div style="font-size: 3rem; color: var(--accent-color);">+</div>
            <div style="font-weight: 500;">Створити новий сет</div>
        </div>

        @foreach (var set in Model)
        {
            <div class="set-card" onclick="handleCardClick(event, '@Url.Action("Index", "Details", new { id = set.Id })')">
                <div class="card-menu-btn" onclick="toggleMenu(event)">⋮</div>
                <div class="dropdown" onclick="event.stopPropagation()">
                    <button type="button" onclick="openEditModal(event, @set.Id, '@set.Name', '@set.Description', '@set.IsPublic'.toLowerCase(), '@((int)set.Type)')">Редагувати</button>
                    <form asp-action="Delete" method="post" onsubmit="return confirm('Видалити цей сет?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@set.Id" />
                        <button type="submit" style="color: #ff8080;">Видалити</button>
                    </form>
                </div>
                <h3 style="margin: 0; color: var(--accent-color);">@set.Name</h3>
                <p style="opacity: 0.7; font-size: 0.85rem; margin: 5px 0; flex-grow: 1;">@set.Description</p>
                <div class="card-footer">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span class="sets-count-badge">@set.FlashcardsCount карток</span>
                        @if (set.IsGenerated)
                        {
                            <span style="font-size: 0.7rem; color: #f4a261; font-weight: bold;">✨ ШІ</span>
                        }
                    </div>
                    <div class="date-info">
                        <span>Створено: @set.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                        <span>@((int)set.Type == 0 ? "Мова" : "Предмет")</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal-overlay" id="setModal">
    <div class="modal">
        <form id="setForm" onsubmit="return false;">
            @Html.AntiForgeryToken()
            <h2 id="modalTitle" style="margin: 0 0 5px 0; font-size: 1.2rem;">Новий сет</h2>
            <input type="hidden" id="setIdField">

            <div style="display: flex; gap: 10px; width: 100%;">
                <div class="field-block" style="flex: 2;">
                    <label>Тип навчання</label>
                    <select id="setTypeField" onchange="toggleLangs()">
                        <option value="1">Предмет (Subject)</option>
                        <option value="0">Мова (Language)</option>
                    </select>
                </div>
                <div class="field-block" style="flex: 1;">
                    <label>Кількість</label>
                    <div class="stepper">
                        <button type="button" onclick="step(-1)">−</button>
                        <input type="number" id="aiCount" value="5" readonly>
                        <button type="button" onclick="step(1)">+</button>
                    </div>
                </div>
            </div>

            <div id="languageRow" style="display: none; gap: 10px; margin-bottom: 5px;">
                <div class="field-block" style="flex: 1;"><label>Вивчаю</label><select id="learnLangList"><option value="uk">uk</option><option value="en">en</option></select></div>
                <div style="margin-top: 15px; color: var(--accent-color);">→</div>
                <div class="field-block" style="flex: 1;"><label>На яку</label><select id="nativeLangList"><option value="en">en</option><option value="uk">uk</option></select></div>
            </div>

            <div class="field-block"><label>Назва сету</label><input type="text" id="setNameField" required placeholder="Назва..." /></div>
            <div class="field-block"><label>Опис (Тема для ШІ)</label><textarea id="setDescField" rows="2" placeholder="Опишіть тему..."></textarea></div>

            <div class="field-block">
                <label>Зображення (опційно)</label>
                <input type="file" id="fileInput" accept="image/*" style="font-size: 0.7rem; padding: 5px;">
            </div>

            <div id="aiPreview" class="ai-preview-container"><div id="aiCardsList"></div></div>

            <div style="display: flex; justify-content: flex-end; align-items: center; gap: 8px; margin: 5px 0;">
                <span style="font-size: 0.8rem; opacity: 0.7;">Зробити публічним</span>
                <label class="switch"><input type="checkbox" id="setPublicField" checked><span class="slider"></span></label>
            </div>

            <div class="modal-footer">
                <button type="button" onclick="closeModal()" style="background: none; border: none; color: #818375; cursor: pointer; font-weight: bold;">Скасувати</button>
                <div style="display: flex; gap: 8px;">
                    <button type="button" id="btnAi" class="btn-ai" onclick="generateAI()">✨ ШІ</button>
                    <button type="button" onclick="saveSet()" style="background: #6B8789; color: white; border: none; padding: 10px 20px; border-radius: 8px; font-weight: bold; cursor: pointer;">Зберегти</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const modal = document.getElementById('setModal');
        let tempGeneratedCards = [];

        function step(v) { let i = document.getElementById('aiCount'); let n = parseInt(i.value) + v; if (n >= 1 && n <= 30) i.value = n; }
        function closeModal() { modal.style.display = 'none'; }
        function toggleLangs() { document.getElementById('languageRow').style.display = document.getElementById('setTypeField').value === "0" ? 'flex' : 'none'; }

        function openCreateModal() {
            document.getElementById('setForm').reset();
            document.getElementById('setIdField').value = "";
            document.getElementById('aiPreview').style.display = 'none';
            tempGeneratedCards = []; toggleLangs(); modal.style.display = 'flex';
        }

        function openEditModal(e, id, name, desc, isPublic, type) {
            e.stopPropagation(); document.getElementById('modalTitle').innerText = "Редагувати сет";
            document.getElementById('setIdField').value = id;
            document.getElementById('setNameField').value = name;
            document.getElementById('setDescField').value = desc;
            document.getElementById('setPublicField').checked = (isPublic === 'true');
            document.getElementById('setTypeField').value = type;
            document.getElementById('aiPreview').style.display = 'none';
            toggleLangs(); modal.style.display = 'flex';
        }

        async function generateAI() {
            const promptValue = document.getElementById('setDescField').value;
            const btn = document.getElementById('btnAi');
            const fileInput = document.getElementById('fileInput');

            if (!promptValue) return alert("Вкажіть тему для ШІ!");

            btn.disabled = true; btn.innerHTML = '<span class="spinner-mini"></span>';

            const formData = new FormData();
            formData.append("Name", document.getElementById('setNameField').value);
            formData.append("Description", promptValue);
            formData.append("Prompt", promptValue);
            formData.append("Type", document.getElementById('setTypeField').value);
            formData.append("FromLang", document.getElementById('learnLangList').value);
            formData.append("ToLang", document.getElementById('nativeLangList').value);
            formData.append("Count", document.getElementById('aiCount').value);

            if (fileInput.files[0]) {
                formData.append("ImageFile", fileInput.files[0]);
            }

            try {
                const response = await fetch('/api/generate-cards', { method: 'POST', body: formData });
                if (!response.ok) throw new Error(await response.text());

                tempGeneratedCards = await response.json();
                renderPreview();
            } catch (e) { alert("Помилка ШІ: " + e.message); }
            finally { btn.disabled = false; btn.innerHTML = "✨ ШІ"; }
        }

        function renderPreview() {
            const list = document.getElementById('aiCardsList'); list.innerHTML = '';
            tempGeneratedCards.forEach((c, i) => {
                list.innerHTML += `<div style="display:flex; justify-content:space-between; font-size:0.75rem; padding:4px; border-bottom:1px solid rgba(255,255,255,0.1);">
                    <span><b>${c.term}</b> - ${c.definition}</span>
                    <span onclick="tempGeneratedCards.splice(${i}, 1); renderPreview();" style="color:#ff8080; cursor:pointer;">✕</span>
                </div>`;
            });
            document.getElementById('aiPreview').style.display = 'block';
        }

              async function saveSet() {

            const name = document.getElementById('setNameField').value;

            if (!name)
                return alert("Введіть назву сету!");

            const token = document.querySelector(
                'input[name="__RequestVerificationToken"]'
            )?.value;

            const formData = new FormData();

            formData.append("Name", name);

            formData.append(
                "Description",
                document.getElementById('setDescField').value
            );

            formData.append(
                "Type",
                document.getElementById('setTypeField').value
            );

            formData.append(
                "IsPublic",
                document.getElementById('setPublicField').checked
            );

            formData.append(
                "GeneratedCardsJson",
                JSON.stringify(tempGeneratedCards)
            );

            try {

                const response = await fetch('/MySets/Create', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                if (response.redirected) {
                    window.location.href = response.url;
                }
                else {
                    const err = await response.text();
                    alert("Помилка: " + err);
                }
            }
            catch (e) {
                console.log(e);
                alert("Сервер недоступний.");
            }
        }
        function toggleMenu(e) { e.stopPropagation(); document.querySelectorAll('.dropdown').forEach(d => d.style.display = 'none'); e.currentTarget.nextElementSibling.style.display = 'flex'; }
        function handleCardClick(e, url) { if (!e.target.closest('.card-menu-btn') && !e.target.closest('.dropdown') && !e.target.closest('form')) window.location.href = url; }
        window.onclick = (e) => { if (!e.target.matches('.card-menu-btn')) document.querySelectorAll('.dropdown').forEach(d => d.style.display = 'none'); if (e.target === modal) closeModal(); };
    </script>
}