@using Core.DTOs
@model LoginDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Вхід - Flashcards Maker</title>
    <style>
        body {
            background: linear-gradient(#141B25, #2C1335);
            height: 100vh;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: system-ui, sans-serif;
            color: #DEE4C7;
        }

        .auth-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(240, 255, 255, 0.1);
            padding: 40px;
            border-radius: 25px;
            width: 100%;
            max-width: 380px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }

        h2 {
            color: #F0FFFF;
            text-align: center;
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.85rem;
            opacity: 0.7;
        }

        .password-container {
            position: relative;
            display: flex;
            align-items: center;
        }

        input {
            width: 100%;
            background: #141B25;
            border: 1px solid #818375;
            color: white;
            padding: 12px;
            border-radius: 10px;
            outline: none;
            box-sizing: border-box;
            transition: 0.3s;
        }

            input:focus {
                border-color: #F0FFFF;
            }

        .toggle-password {
            position: absolute;
            right: 12px;
            cursor: pointer;
            opacity: 0.5;
            transition: 0.3s;
            display: flex;
            align-items: center;
        }

            .toggle-password:hover {
                opacity: 1;
                color: #F0FFFF;
            }

        .btn-auth {
            width: 100%;
            background: #6B8789;
            color: white;
            border: none;
            padding: 14px;
            border-radius: 10px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 15px;
            transition: 0.3s;
        }

            .btn-auth:hover {
                background: #F0FFFF;
                color: #141B25;
                transform: translateY(-2px);
            }

        /* СТИЛІ РОЗДІЛЬНИКА */
        .separator {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 25px 0;
            opacity: 0.4;
            font-size: 0.8rem;
        }

            .separator::before, .separator::after {
                content: '';
                flex: 1;
                border-bottom: 1px solid rgba(255,255,255,0.2);
            }

            .separator:not(:empty)::before {
                margin-right: .5em;
            }

            .separator:not(:empty)::after {
                margin-left: .5em;
            }

        /* СТИЛЬ КНОПКИ GOOGLE */
        .btn-google {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            background: white;
            color: #141B25;
            border: none;
            padding: 12px;
            border-radius: 10px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            text-decoration: none;
            font-size: 0.9rem;
        }

            .btn-google:hover {
                background: #e0e0e0;
                transform: translateY(-2px);
            }

        .auth-footer {
            text-align: center;
            margin-top: 20px;
            font-size: 0.85rem;
            opacity: 0.6;
        }

            .auth-footer a {
                color: #F0FFFF;
                text-decoration: none;
                font-weight: bold;
            }

        .validation-summary {
            color: #ff8080;
            font-size: 0.8rem;
            margin-bottom: 15px;
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="auth-card">
        <h2>Вхід</h2>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label>Логін або Email</label>
                <input asp-for="UserNameOrEmail" placeholder="Введіть логін або пошту" required />
            </div>

            <div class="form-group">
                <label>Пароль</label>
                <div class="password-container">
                    <input asp-for="Password" type="password" id="pass_main" placeholder="••••••••" required />
                    <span class="toggle-password" onclick="togglePass('pass_main', this)">
                        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </span>
                </div>
            </div>

            <button type="submit" class="btn-auth">Увійти</button>
        </form>

        <div class="separator">або за допомогою</div>

        <a asp-action="GoogleLogin" class="btn-google">
            <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" width="18" height="18">
            Продовжити з Google
        </a>

        <div class="auth-footer">
            Немає акаунту? <a asp-action="Register">Створити</a>
        </div>
    </div>

    <script>
        function togglePass(inputId, icon) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                icon.style.opacity = "1";
            } else {
                input.type = "password";
                icon.style.opacity = "0.5";
            }
        }
    </script>
</body>
</html>