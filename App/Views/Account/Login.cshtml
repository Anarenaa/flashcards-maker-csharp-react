@using Core.DTOs
@model LoginDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Вхід - Flashcards Maker</title>
    <style>
        body {
            background: linear-gradient(#141B25, #2C1335);
            height: 100vh;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: system-ui, sans-serif;
            color: #DEE4C7;
        }

        .auth-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(240, 255, 255, 0.1);
            padding: 40px;
            border-radius: 25px;
            width: 100%;
            max-width: 380px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }

        h2 {
            color: #F0FFFF;
            text-align: center;
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.85rem;
            opacity: 0.7;
        }

        input {
            width: 100%;
            background: #141B25;
            border: 1px solid #818375;
            color: white;
            padding: 12px;
            border-radius: 10px;
            outline: none;
            box-sizing: border-box;
            transition: 0.3s;
        }

            input:focus {
                border-color: #F0FFFF;
                box-shadow: 0 0 10px rgba(240, 255, 255, 0.2);
            }

        .btn-auth {
            width: 100%;
            background: #6B8789;
            color: white;
            border: none;
            padding: 14px;
            border-radius: 10px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 15px;
            transition: 0.3s;
        }

            .btn-auth:hover {
                background: #F0FFFF;
                color: #141B25;
                transform: translateY(-2px);
            }

        .validation-summary {
            color: #ff8080;
            font-size: 0.8rem;
            margin-bottom: 15px;
            text-align: center;
        }

        .auth-footer {
            text-align: center;
            margin-top: 20px;
            font-size: 0.85rem;
            opacity: 0.6;
        }

            .auth-footer a {
                color: #F0FFFF;
                text-decoration: none;
                font-weight: bold;
            }
    </style>
</head>
<body>
    <div class="auth-card">
        <h2>Вхід</h2>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label>Логін або Email</label>
                @* ВІДПОВІДАЄ: UserNameOrEmail у DTO *@
                <input asp-for="UserNameOrEmail" placeholder="Введіть логін або пошту" />
            </div>

            <div class="form-group">
                <label>Пароль</label>
                <input asp-for="Password" type="password" placeholder="••••••••" />
            </div>

            <button type="submit" class="btn-auth">Увійти</button>
        </form>
        <div class="auth-footer">
            Немає акаунту? <a asp-action="Register">Створити</a>
        </div>
    </div>
</body>
</html>