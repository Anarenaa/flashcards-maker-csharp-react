@using Core.DTOs
@model RegisterDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Реєстрація - Flashcards Maker</title>
    <style>
        body {
            background: linear-gradient(#141B25, #2C1335);
            height: 100vh;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: system-ui, sans-serif;
            color: #DEE4C7;
        }

        .auth-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(240, 255, 255, 0.1);
            padding: 40px;
            border-radius: 25px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }

        h2 {
            color: #F0FFFF;
            text-align: center;
            margin-bottom: 25px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-size: 0.8rem;
            opacity: 0.7;
        }

        .password-container {
            position: relative;
            display: flex;
            align-items: center;
        }

        input {
            width: 100%;
            background: #141B25;
            border: 1px solid #818375;
            color: white;
            padding: 11px;
            padding-right: 40px;
            border-radius: 10px;
            outline: none;
            box-sizing: border-box;
            transition: 0.3s;
        }

            input:focus {
                border-color: #F0FFFF;
            }

        .toggle-password {
            position: absolute;
            right: 12px;
            cursor: pointer;
            opacity: 0.5;
            transition: 0.3s;
            display: flex;
            align-items: center;
            user-select: none;
        }

            .toggle-password:hover {
                opacity: 1;
                color: #F0FFFF;
            }

        .btn-auth {
            width: 100%;
            background: #6B8789;
            color: white;
            border: none;
            padding: 13px;
            border-radius: 10px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
            transition: 0.3s;
        }

            .btn-auth:hover {
                background: #F0FFFF;
                color: #141B25;
                transform: translateY(-2px);
            }

        /* ЧЕРВОНИЙ ТЕКСТ ПОМИЛОК ПІД ПОЛЯМИ */
        .text-danger {
            color: #ff8080;
            font-size: 0.75rem;
            margin-top: 5px;
            display: block;
            list-style: none;
            padding: 0;
        }

        .auth-footer {
            text-align: center;
            margin-top: 20px;
            font-size: 0.85rem;
            opacity: 0.6;
        }

            .auth-footer a {
                color: #F0FFFF;
                text-decoration: none;
                font-weight: bold;
            }
    </style>
</head>
<body>
    <div class="auth-card">
        <h2>Реєстрація</h2>
        <form asp-action="Register" method="post">
            @* Прибрали Summary зверху, щоб помилки були тільки під кнопками *@

            <div class="form-group">
                <label>Логін (UserName)</label>
                <input asp-for="UserName" placeholder="Вигадайте нікнейм" required />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" type="email" placeholder="example@mail.com" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Пароль</label>
                <div class="password-container">
                    <input asp-for="Password" type="password" id="pass_main" placeholder="Мін. 6 символів" required />
                    <span class="toggle-password" onclick="togglePass('pass_main', this)">
                        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </span>
                </div>
                @* ПОМИЛКА ДЛЯ ПАРОЛЯ *@
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Підтвердження пароля</label>
                <div class="password-container">
                    <input type="password" name="confirm" id="pass_confirm" placeholder="Повторіть пароль" required />
                    <span class="toggle-password" onclick="togglePass('pass_confirm', this)">
                        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </span>
                </div>
                @* ПОМИЛКА ДЛЯ ПІДТВЕРДЖЕННЯ (виводиться з ModelState вручну) *@
                <span class="text-danger">@Html.ValidationMessage("confirm")</span>
                @* Якщо в контролері помилка додана через string.Empty, вона виведеться тут: *@
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>

            <div class="separator" style="display: flex; align-items: center; text-align: center; margin: 20px 0; opacity: 0.4; font-size: 0.8rem;">
                <span style="flex:1; border-bottom:1px solid rgba(255,255,255,0.2); margin-right:.5em;"></span>
                або
                <span style="flex:1; border-bottom:1px solid rgba(255,255,255,0.2); margin-left:.5em;"></span>
            </div>

            <a asp-action="GoogleLogin" style="display:flex; align-items:center; justify-content:center; gap:10px; background:white; color:#141B25; padding:12px; border-radius:10px; text-decoration:none; font-weight:bold; font-size:0.9rem; transition:0.3s; margin-bottom: 10px;">
                <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" width="18" height="18">
                через Google
            </a>

            <button type="submit" class="btn-auth">Зареєструватися</button>
        </form>
        <div class="auth-footer">
            Вже маєте акаунт? <a asp-action="Login">Увійти</a>
        </div>
    </div>

    <script>
        function togglePass(inputId, icon) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                icon.style.opacity = "1";
            } else {
                input.type = "password";
                icon.style.opacity = "0.5";
            }
        }
    </script>
</body>
</html>