@{
    ViewData["Title"] = "Лист надіслано";
    // Відключаємо загальний шаблон, щоб прибрати меню та кнопки
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        :root {
            --bg-color: #141B25;
            --accent-color: #F0FFFF;
            --btn-color: #6B8789;
            --text-color: #DEE4C7;
        }

        body {
            background: linear-gradient(#141B25, #2C1335);
            margin: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: system-ui, sans-serif;
            color: var(--text-color);
            overflow: hidden;
        }

        .status-card {
            background-color: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(15px); 
            border: 1px solid rgba(240, 255, 255, 0.1);
            border-radius: 25px;
            padding: 50px 40px;
            max-width: 450px;
            width: 90%;
            text-align: center;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            animation: fadeIn 0.8s ease-out;
        }

        .icon-box {
            width: 90px;
            height: 90px;
            background: rgba(240, 255, 255, 0.07);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 30px;
            color: var(--accent-color);
            box-shadow: 0 0 25px rgba(240, 255, 255, 0.1);
        }

        h2 {
            color: var(--accent-color);
            margin-top: 0;
            margin-bottom: 20px;
            font-size: 2rem;
            letter-spacing: 1px;
        }

        p {
            opacity: 0.8;
            line-height: 1.6;
            margin-bottom: 35px;
            font-size: 1.05rem;
        }

        .btn-azure {
            display: inline-block;
            background: var(--btn-color);
            color: white;
            text-decoration: none;
            padding: 14px 35px;
            border-radius: 12px;
            font-weight: bold;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

            .btn-azure:hover {
                background: var(--accent-color);
                color: #141B25;
                transform: translateY(-3px);
                box-shadow: 0 8px 25px rgba(240, 255, 255, 0.3);
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: scale(0.9);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }
    </style>
</head>
<body>

    <div class="status-card">
        <div class="icon-box">
            <svg width="45" height="45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
        </div>

        <h2>Готово!</h2>

        <p>
            Ми надіслали інструкції для відновлення пароля на вашу пошту.<br>
            Будь ласка, перевірте скриньку.
        </p>

        <a href="/Account/Login" class="btn-azure">
            Повернутися до входу
        </a>
    </div>

</body>
</html>