@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Flashcards Maker";
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        :root {
            --bg-color: #141B25;      /* Глибокий темний */
            --accent-purple: #2C1335; /* Твій фіолетовий */
            --accent-color: #6B8789;  /* Колір 1 */
            --square-color-2: #818375; /* Колір 2 */
            --text-color: #DEE4C7;
        }

        body {
            background-color: var(--bg-color);
            margin: 0;
            color: var(--text-color);
            font-family: system-ui, -apple-system, sans-serif;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        /* ПЕРШИЙ ЕКРАН */
        .hero-viewport {
            height: 100vh;
            width: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            background: radial-gradient(circle at center, var(--accent-purple) 0%, var(--bg-color) 70%);
        }

        .top-right-nav {
            position: absolute;
            top: 20px;
            right: 20px;
            display: flex;
            gap: 10px;
            z-index: 100;
        }

        .btn {
            background-color: rgba(129, 131, 117, 0.2);
            border: 1px solid #818375;
            color: #DEE4C7;
            padding: 10px 22px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            text-decoration: none;
            transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-block;
        }

        .btn:hover {
            background-color: var(--accent-color);
            transform: translateY(-3px);
            color: white;
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
        }

        .hero-content {
            z-index: 50;
            text-align: center;
        }

        .hero-content h1 {
            font-size: clamp(3rem, 10vw, 5rem);
            margin: 0;
            text-shadow: 0 5px 30px rgba(0,0,0,0.7);
            font-weight: 900;
        }

        .hero-content p {
            font-size: 1.4rem;
            opacity: 0.9;
            margin-top: 15px;
            font-weight: 300;
        }

        /* КВАДРАТИ, ЩО ЛІТАЮТЬ ВСЮДИ */
        .squares-wrapper {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 10;
        }

        .square {
            width: 35vh;
            height: 18vh;
            position: absolute;
            left: -40vh;
            top: 50%;
            animation: waveMove 12s linear infinite;
            filter: blur(2px);
        }

        .square:nth-child(odd) { background-color: var(--accent-color); }
        .square:nth-child(even) { background-color: var(--square-color-2); }

        @for (int i = 1; i <= 15; i++) {
            <text>
            .square:nth-child(@i) { 
                opacity: @(0.15 + (i % 4) * 0.1); 
                animation-delay: @(i * -1.5)s; 
                height: @(12 + i)vh;
            }
            </text>
        }

        @@keyframes waveMove {
            0% { left: -40vh; top: 80%; transform: rotate(0deg); }
            25% { top: 30%; transform: rotate(10deg); }
            50% { top: 60%; transform: rotate(-10deg); }
            75% { top: 20%; transform: rotate(5deg); }
            100% { left: 110vw; top: 70%; transform: rotate(0deg); }
        }

        /* КОНТЕНТНИЙ БЛОК */
        .features-container {
            position: relative;
            z-index: 60;
            max-width: 1100px;
            margin: 0 auto;
            padding: 80px 20px;
        }

        .feature-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 60px;
            margin-bottom: 150px;
            opacity: 0;
            transform: translateY(50px);
            transition: 1.2s cubic-bezier(0.17, 0.67, 0.83, 0.67);
        }

        .feature-card.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .feature-card:nth-child(even) { flex-direction: row-reverse; }

        .feature-info { flex: 1; }
        .feature-info h2 {
            font-size: 2.5rem;
            color: var(--accent-color);
            margin-bottom: 20px;
            text-shadow: 0 2px 10px rgba(0,0,0,0.3);
        }
        .feature-info p {
            font-size: 1.2rem;
            line-height: 1.7;
            opacity: 0.8;
        }

        .feature-img-wrapper {
            flex: 1;
            text-align: center;
        }

        .feature-img-wrapper img {
            max-width: 100%;
            border-radius: 30px;
            filter: drop-shadow(0 20px 40px rgba(0,0,0,0.6));
            transition: 0.5s;
            border: 1px solid rgba(255,255,255,0.05);
        }

        .feature-img-wrapper img:hover {
            transform: scale(1.05) rotate(1deg);
            filter: drop-shadow(0 30px 60px rgba(107, 135, 137, 0.3));
        }

        footer {
            position: relative;
            z-index: 60;
            text-align: center;
            padding: 60px;
            background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);
            opacity: 0.6;
        }

        .scroll-down {
            margin-top: 40px;
            animation: bounce 2s infinite;
        }
        @@keyframes bounce {
            0%, 20%, 50%, 80%, 100% {transform: translateY(0);}
            40% {transform: translateY(-10px);}
            60% {transform: translateY(-5px);}
        }
    </style>
</head>
<body>

    <!-- КВАДРАТИ (ЗАФІКСОВАНІ) -->
    <div class="squares-wrapper">
        @for (int i = 0; i < 15; i++) { <div class="square"></div> }
    </div>

    <section class="hero-viewport">
        <nav class="top-right-nav">
            <a asp-controller="Account" asp-action="Register" class="btn">Реєстрація</a>
            <a asp-controller="Account" asp-action="Login" class="btn">Увійти</a>
        </nav>

        <div class="hero-content">
            <h1>Flashcards Maker</h1>
            <p>Твій ідеальний простір для навчання</p>
            <div class="scroll-down">
                <a href="#features" class="btn" style="background: var(--accent-color); color: white; border: none; border-radius: 50px;">Погортати вниз ↓</a>
            </div>
        </div>
    </section>

    <section id="features" class="features-container">
        
        <div class="feature-card">
            <div class="feature-info">
                <h2>Вчися з натхненням</h2>
                <p>Наш зручний конструктор дозволяє змінювати теми у налаштуваннях із запропонованих або ж створювати власні. Також ви можете залишити Ваш профіль приватним або ж зробити його публічним.</p>
            </div>
            <div class="feature-img-wrapper">
                <img src="/images/boy-laptop.png" alt="Створення" onerror="this.src='https://placehold.co/500x400/141B25/6B8789?text=Малюнок+1'"/>
            </div>
        </div>

        <div class="feature-card">
            <div class="feature-info">
                <h2>Глибоке занурення</h2>
                <p>За допомогою нашої програми чи сайту Ви можете глибоко зануритися у матеріал та опанувати нові знання. Ви маєте змогу створити сети із власних знань або ж переглядати чужі, після чого ви можете добавити їх у колекції.</p>
            </div>
            <div class="feature-img-wrapper">
                <img src="/images/girl-tablet.png" alt="Навчання" onerror="this.src='https://placehold.co/500x400/141B25/6B8789?text=Малюнок+2'"/>
            </div>
        </div>

        <div class="feature-card">
            <div class="feature-info">
                <h2>Завжди під рукою</h2>
                <p>Твої знання завжди у твоїй кишені. Вчися в метро, у черзі чи на прогулянці — додаток ідеально працює на смартфонах, планшетах та на інших пристроях за допомогою нашої адаптації.</p>
            </div>
            <div class="feature-img-wrapper">
                <img src="/images/girl-phone.png" alt="Мобільність" onerror="this.src='https://placehold.co/500x400/141B25/6B8789?text=Малюнок+3'"/>
            </div>
        </div>

    </section>

    <footer>
        <p>&copy; 2026 Flashcards Maker. Створено для твого успіху.</p>
    </footer>

    <script>
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { threshold: 0.15 });

        document.querySelectorAll('.feature-card').forEach(card => observer.observe(card));
    </script>
</body>
</html>