@{
    ViewData["Title"] = "Flashcards Maker";
    // Якщо ви хочете, щоб сторінка виглядала точно як ваш оригінал (без стандартного меню ASP.NET)
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        body {
            background: linear-gradient(#141B25,#2C1335);
            margin: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #DEE4C7;
            font-family: system-ui;
            overflow: hidden;
        }

        /* Контейнер для кнопок */
        .top-right-nav {
            position: absolute;
            top: 20px;
            right: 20px;
            display: flex;
            gap: 10px;
            z-index: 30;
        }

        .btn {
            background-color: rgba(129, 131, 117, 0.2);
            border: 1px solid #818375;
            color: #DEE4C7;
            padding: 8px 16px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
            text-decoration: none;
            display: inline-block;
            transition: background 0.3s, transform 0.2s;
        }

        .btn:hover {
            background-color: #6B8789;
            transform: translateY(-2px);
            color: white;
        }

        h1, p {
            z-index: 20;
            position: relative;
            text-align: center;
            text-shadow: 0 2px 10px rgba(0,0,0,0.8);
            pointer-events: none;
        }

        /* Квадрати */
        .square {
            width: 30vh;
            height: 15vh;
            position: absolute;
            left: -35vh;
            top: 70%;
            animation: waveMove 10s linear infinite;
        }

        .square:nth-child(1)  { background-color: #6B8789; opacity: 1;  animation-delay: 0s; }
        .square:nth-child(2)  { background-color: #818375; opacity: 0.5; animation-delay: -1.1s; }
        .square:nth-child(3)  { background-color: #6B8789; opacity: 0.6; animation-delay: -2.2s; }
        .square:nth-child(4)  { background-color: #818375; opacity: 0.3; animation-delay: -3.3s; }
        .square:nth-child(5)  { background-color: #6B8789; opacity: 1;   animation-delay: -4.4s; }
        .square:nth-child(6)  { background-color: #818375; opacity: 0.3; animation-delay: -5.5s; }
        .square:nth-child(7)  { background-color: #6B8789; opacity: 0.4; animation-delay: -6.6s; }
        .square:nth-child(8)  { background-color: #818375; opacity: 0.7; animation-delay: -7.7s; }
        .square:nth-child(9)  { background-color: #6B8789; opacity: 1;   animation-delay: -8.8s; }
        .square:nth-child(10) { background-color: #818375; opacity: 0.5; animation-delay: -9.9s; }
        .square:nth-child(11) { background-color: #6B8789; opacity: 0.3; animation-delay: -11.0s; }
        .square:nth-child(12) { background-color: #818375; opacity: 1;   animation-delay: -12.1s; }

        @@keyframes waveMove {
            0% { left: -35vh; top: 65%; }
            50% { top: 35%; }
            100% { left: 110vw; top: 65%; }
        }
    </style>
</head>
<body>

    <nav class="top-right-nav">
        @* Використовуємо Tag Helpers для переходів між сторінками *@
        <a asp-area="" asp-controller="Account" asp-action="Register" class="btn">Реєстрація</a>
        <a asp-controller="Main" asp-action="Index" class="btn">Увійти</a>
    </nav>

    <main>
        <h1>Flashcards Maker</h1>
        <p>Флеш картки для вивчення предметів</p>

        <!-- Квадрати -->
        @for (int i = 0; i < 12; i++)
        {
            <div class="square"></div>
        }
    </main>

</body>
</html>