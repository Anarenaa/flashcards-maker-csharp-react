@using Core.DTOs
@model SetDetailDTO

@{
    ViewData["Title"] = "Перегляд карток - " + Model.Name;
    bool isOwner = ViewBag.IsOwner ?? false;

    // Перевіряємо, чи прийшли ми з колекції
    var collectionId = Context.Request.Query["collectionId"];
    bool fromCollection = !string.IsNullOrEmpty(collectionId);
}

<style>
    /* --- ОСНОВНІ СТИЛІ --- */
    .back-link {
        color: var(--accent-color);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        opacity: 0.7;
        text-decoration: none;
        transition: 0.3s;
        font-size: 0.9rem;
        /* Стилізація кнопки під посилання */
        background: none;
        border: none;
        padding: 0;
        font-family: inherit;
    }

        .back-link:hover {
            opacity: 1;
            transform: translateX(-5px);
        }

    .header-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 30px;
        gap: 20px;
    }

    /* --- КОНТЕЙНЕР ДЛЯ КНОПКИ ПРАКТИКИ --- */
    .practice-sticky-container {
        position: fixed;
        top: 30px;
        right: 40px;
        z-index: 100;
    }

    /* --- КНОПКА ПРАКТИКИ (СТИЛЬ ЯК У САЙДБАРІ) --- */
    .btn-practice {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        background-color: var(--btn-bg) !important;
        border: 1px solid var(--btn-border) !important;
        color: white !important;
        padding: 12px 25px;
        border-radius: 10px;
        text-decoration: none !important;
        font-weight: 500;
        font-size: 0.95rem;
        transition: 0.3s ease;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

        .btn-practice:hover {
            border-color: var(--accent-color) !important;
            background-color: rgba(255, 255, 255, 0.05) !important;
            transform: translateY(-2px);
        }

        .btn-practice svg {
            color: var(--accent-color);
        }

    /* --- КАТЕГОРІЇ --- */
    .categories-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 12px;
        padding: 0;
        list-style: none;
    }

    .category-badge {
        display: inline-flex;
        align-items: center;
        background: rgba(119, 158, 203, 0.2);
        border: 1px solid #779ECB;
        color: #DEE4C7;
        padding: 6px 12px;
        border-radius: 12px;
        font-size: 0.85rem;
        transition: 0.3s;
        gap: 8px;
    }

    .remove-cat-btn {
        background: none;
        border: none;
        color: #ff8080;
        cursor: pointer;
        font-weight: bold;
        font-size: 1.1rem;
        line-height: 1;
        padding: 0;
    }

    /* --- СІТКА КАРТОК --- */
    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
    }

    .flashcard-item {
        background-color: var(--btn-bg);
        border: 1px solid var(--btn-border);
        border-radius: 15px;
        padding: 25px;
        min-height: 160px;
        display: flex;
        flex-direction: column;
        position: relative;
        transition: all 0.3s ease;
    }

        .flashcard-item:hover {
            border-color: var(--accent-color);
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
        }

    .card-term {
        font-weight: bold;
        color: var(--accent-color);
        font-size: 1.15rem;
        margin-bottom: 12px;
        word-wrap: break-word;
        padding-right: 25px;
    }

    .card-divider {
        height: 1px;
        background: rgba(240, 255, 255, 0.1);
        border: none;
        margin: 10px 0;
    }

    .card-definition {
        opacity: 0.8;
        font-size: 1rem;
        line-height: 1.4;
        word-wrap: break-word;
    }

    .card-update-info {
        margin-top: auto;
        padding-top: 10px;
        text-align: right;
        border-top: 1px solid rgba(240, 255, 255, 0.05);
        font-size: 0.65rem;
        opacity: 0.3;
    }

    .btn-main {
        background: #6B8789;
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
        transition: 0.3s;
    }

    .dots {
        position: absolute;
        top: 15px;
        right: 15px;
        cursor: pointer;
        font-size: 1.5rem;
        opacity: 0.5;
        z-index: 10;
        padding: 5px;
    }

    .dropdown {
        position: absolute;
        top: 45px;
        right: 15px;
        background: #2C3440;
        border: 1px solid #818375;
        border-radius: 8px;
        display: none;
        flex-direction: column;
        z-index: 100;
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        overflow: hidden;
        min-width: 150px;
    }

        .dropdown button {
            background: none;
            border: none;
            color: white;
            padding: 10px 20px;
            text-align: left;
            cursor: pointer;
            width: 100%;
            font-size: 0.9rem;
        }

            .dropdown button:hover {
                background-color: #6B8789;
            }
</style>

<div class="content-area">
    @* КНОПКА НАЗАД З РОЗУМНОЮ ЛОГІКОЮ *@
    <button onclick="history.back()" class="back-link">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        @if (fromCollection)
        {
            <text>Назад до колекції</text>
        }
        else if (isOwner)
        {
            <text>Назад до моїх сетів</text>
        }
        else
        {
            <text>Назад до головної</text>
        }
    </button>

    <!-- ПЛАВАЮЧА КНОПКА ПРАКТИКИ -->
    <div class="practice-sticky-container">
        <a asp-controller="Test" asp-action="Map" asp-route-setId="@Model.Id" class="btn-practice">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z" /></svg>
            Практикувати
        </a>
    </div>

    <div class="header-row">
        <div>
            <h2 style="color: var(--accent-color); margin: 0; font-size: 1.8rem;">@Model.Name</h2>
            <p style="opacity: 0.6; margin: 5px 0 0 0;">@Model.Description</p>

            <ul class="categories-list">
                @foreach (var cat in Model.Categories)
                {
                    <li class="category-badge">
                        @cat.Name
                        @if (isOwner)
                        {
                            <div style="display:flex; gap:5px;">
                                <form asp-controller="Details" asp-action="RemoveCategory" method="post" style="display:inline;">
                                    <input type="hidden" name="setId" value="@Model.Id" />
                                    <input type="hidden" name="categoryId" value="@cat.Id" />
                                    <button type="submit" class="remove-cat-btn" title="Прибрати">×</button>
                                </form>
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>

        <div style="display: flex; gap: 10px;">
            @if (isOwner)
            {
                <button class="btn-main" onclick="openCreateCardModal()">+ Картка</button>
                <button class="btn-main" onclick="openCategoryModal()">+ Категорія</button>
            }
        </div>
    </div>

    <div class="cards-grid">
        @foreach (var card in Model.Flashcards)
        {
            <div class="flashcard-item">
                @if (isOwner)
                {
                    <div class="dots" onclick="toggleMenu(event)">⋮</div>
                    <div class="dropdown">
                        <button type="button" onclick="openEditCardModal('@card.Id', '@card.Term', '@card.Definition')">Редагувати</button>
                        <form asp-controller="Details" asp-action="DeleteCard" method="post" onsubmit="return confirm('Видалити картку?')">
                            <input type="hidden" name="cardId" value="@card.Id" />
                            <input type="hidden" name="setId" value="@Model.Id" />
                            <button type="submit" style="color: #ff8080;">Видалити</button>
                        </form>
                    </div>
                }
                <div class="card-term">@card.Term</div>
                <hr class="card-divider">
                <div class="card-definition">@card.Definition</div>

                <div class="card-update-info">
                    @if (Model.LastUpdatedAt.Date == DateTime.Today)
                    {
                        <text>Оновлено: @Model.LastUpdatedAt.ToLocalTime().ToString("HH:mm") сьогодні</text>
                    }
                    else
                    {
                        <text>Оновлено: @Model.LastUpdatedAt.ToLocalTime().ToString("dd.MM.yyyy")</text>
                    }
                </div>
            </div>
        }
    </div>
</div>