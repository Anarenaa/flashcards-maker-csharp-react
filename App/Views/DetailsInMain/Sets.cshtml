@using Core.DTOs
@model IEnumerable<SetDTO>

@{
    ViewData["Title"] = "Всі навчальні сети";
}

<style>
  
    .search-container {
        display: flex;
        gap: 15px;
        margin-bottom: 30px;
        background: rgba(255, 255, 255, 0.03);
        padding: 15px;
        border-radius: 12px;
        border: 1px solid var(--btn-border);
        align-items: center;
    }

    .search-bar-form {
        display: flex;
        flex-grow: 1;
        gap: 10px;
    }

        .search-bar-form input {
            flex-grow: 1;
            background: #141B25;
            border: 1px solid #818375;
            color: white;
            padding: 12px 15px;
            border-radius: 8px;
            outline: none;
        }

    .sort-select {
        background: #141B25;
        border: 1px solid #818375;
        color: white;
        padding: 0 15px;
        border-radius: 8px;
        cursor: pointer;
        min-width: 170px;
    }

    .btn-search {
        background: #6B8789 !important;
        color: white !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        font-weight: bold;
        padding: 0 25px;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
        height: 45px;
    }

    .sets-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
        margin-top: 20px;
    }

    .set-card {
        background-color: var(--btn-bg);
        border: 1px solid var(--btn-border);
        border-radius: 12px;
        padding: 25px;
        min-height: 200px;
        display: flex;
        flex-direction: column;
        position: relative;
        cursor: pointer;
        transition: 0.3s ease;
    }

        .set-card:hover {
            border-color: var(--accent-color);
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
        }

    .author-badge {
        font-size: 0.75rem;
        opacity: 0.5;
        margin-bottom: 8px;
        color: white;
    }

    .btn-practice-card {
        background: linear-gradient(135deg, #6e8efb, #a777e3);
        color: white !important;
        border: none;
        padding: 10px 15px;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 800;
        cursor: pointer;
        transition: 0.3s;
        text-align: center;
        width: 100%;
        margin-top: 15px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        box-shadow: 0 4px 15px rgba(110, 142, 251, 0.2);
    }

        .btn-practice-card:hover {
            transform: translateY(-2px);
            filter: brightness(1.1);
            box-shadow: 0 6px 20px rgba(110, 142, 251, 0.4);
        }

    .card-footer {
        margin-top: auto;
        padding-top: 10px;
        border-top: 1px solid rgba(240, 255, 255, 0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sets-count-badge {
        background: rgba(240, 255, 255, 0.1);
        color: var(--accent-color);
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: bold;
    }

    .date-info {
        font-size: 0.65rem;
        opacity: 0.4;
        color: white;
    }
</style>

<div class="content-area">
    <h2 style="margin-bottom: 20px;">Всі навчальні сети</h2>

    <div class="search-container">
        <form asp-controller="Explore" asp-action="Index" method="get" class="search-bar-form">
            <input type="text" name="searchText" placeholder="Шукати серед усіх сетів..." value="@ViewData["CurrentFilter"]" />

            <select name="categoryId" class="sort-select" onchange="this.form.submit()">
                <option value="">Усі категорії</option>
                @if (ViewBag.Categories != null)
                {
                    @foreach (var cat in ViewBag.Categories)
                    {
                        <option value="@cat.Id" selected="@(ViewData["CurrentCategory"]?.ToString() == cat.Id.ToString())">@cat.Name</option>
                    }
                }
            </select>

            <button type="submit" class="btn-search">Шукати</button>
        </form>
    </div>

    <div class="sets-grid">
        @foreach (var set in Model)
        {
            <div class="set-card" onclick="window.location.href='@Url.Action("Index", "Details", new { id = set.Id })'">

                <div class="author-badge">Автор: @set.UserName</div>

                <h3 style="margin: 0; color: var(--accent-color);">@set.Name</h3>
                <p style="opacity: 0.7; font-size: 0.85rem; margin: 5px 0; flex-grow: 1;">@set.Description</p>

                <button class="btn-practice-card" onclick="event.stopPropagation(); window.location.href='@Url.Action("Map", "Test", new { id = set.Id })'">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z" /></svg>
                    Практикувати
                </button>

                <div class="card-footer">
                    <span class="sets-count-badge">@set.FlashcardsCount карток</span>
                    <span class="date-info">Оновлено: @set.LastUpdatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                </div>
            </div>
        }
    </div>
</div>