@using Core.DTOs
@model CollectionDetailDTO

@{
    ViewData["Title"] = "Колекція: " + Model.Name;
}

<style>
    .header-section {
        margin-bottom: 30px;
    }

    .back-link {
        color: var(--accent-color);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        opacity: 0.7;
        transition: 0.3s;
        margin-bottom: 15px;
    }

        .back-link:hover {
            opacity: 1;
            transform: translateX(-5px);
        }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
    }

    .set-card {
        background: var(--btn-bg);
        border: 1px solid var(--btn-border);
        border-radius: 15px;
        padding: 25px;
        position: relative;
        cursor: pointer;
        transition: 0.3s;
        display: flex;
        flex-direction: column;
        min-height: 160px;
    }

        .set-card:hover {
            border-color: var(--accent-color);
            background: var(--btn-hover);
            transform: translateY(-5px);
        }

    /* МЕНЮ КРАПОК */
    .dots {
        position: absolute;
        top: 15px;
        right: 15px;
        font-size: 1.5rem;
        opacity: 0.5;
        cursor: pointer;
        padding: 5px;
        z-index: 10;
        line-height: 1;
    }

        .dots:hover {
            opacity: 1;
            color: var(--accent-color);
        }

    .dropdown {
        position: absolute;
        top: 45px;
        right: 15px;
        background: #2C3440;
        border: 1px solid #818375;
        border-radius: 8px;
        display: none;
        flex-direction: column;
        z-index: 100;
        box-shadow: 0 8px 16px rgba(0,0,0,0.5);
        overflow: hidden;
    }

        .dropdown button {
            background: none;
            border: none;
            color: white;
            padding: 12px 20px;
            text-align: left;
            cursor: pointer;
            width: 100%;
            font-size: 0.9rem;
        }

            .dropdown button:hover {
                background-color: #6B8789;
            }
</style>

<div class="content-area">
    <div class="header-section">
        <a asp-action="Index" class="back-link">← Назад до колекцій</a>
        <h2 style="color: var(--accent-color); margin: 0;">@Model.Name</h2>
        <p style="opacity: 0.6; margin: 5px 0 0 0;">@Model.Description</p>
    </div>

    <div class="grid">
        @foreach (var set in Model.Sets)
        {
            <div class="set-card" onclick="handleCardClick(event, '@Url.Action("Details", "MySets", new { id = set.Id })')">

                @* МЕНЮ ⋮ *@
                <div class="dots" onclick="toggleMenu(event)">⋮</div>
                <div class="dropdown">
                    @* ФОРМА ВИДАЛЕННЯ З КОЛЕКЦІЇ *@
                    <form asp-action="RemoveSet" method="post" onsubmit="return confirm('Прибрати цей сет із папки?')">
                        <input type="hidden" name="setId" value="@set.Id" />
                        <input type="hidden" name="collectionId" value="@Model.Id" />
                        <button type="submit" style="color: #ff8080;">Прибрати з папки</button>
                    </form>
                </div>

                <h3 style="margin: 0 0 10px 0;">@set.Name</h3>
                <p style="opacity: 0.7; font-size: 0.9rem; margin: 0; flex-grow: 1;">@set.Description</p>

                <div style="font-size: 0.75rem; margin-top: 15px; opacity: 0.5; display: flex; justify-content: space-between;">
                    <span>@set.FlashcardsCount карток</span>
                    <span>@(set.IsPublic ? "🌐 Публічний" : "🔒 Приватний")</span>
                </div>
            </div>
        }

        @if (!Model.Sets.Any())
        {
            <div style="grid-column: 1 / -1; text-align: center; padding: 60px; opacity: 0.4;">
                Ця папка поки що порожня. Додайте сети зі сторінки "Мої сети" або "Головна".
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function handleCardClick(event, url) {
            if (event.target.closest('.dots') || event.target.closest('.dropdown')) return;
            window.location.href = url;
        }

        function toggleMenu(e) {
            e.stopPropagation();
            const btn = e.currentTarget;
            const dropdown = btn.nextElementSibling;
            document.querySelectorAll('.dropdown').forEach(d => { if (d !== dropdown) d.style.display = 'none'; });
            dropdown.style.display = (dropdown.style.display === 'flex') ? 'none' : 'flex';
        }

        window.onclick = (e) => {
            if (!e.target.matches('.dots')) document.querySelectorAll('.dropdown').forEach(d => d.style.display = 'none');
        }
    </script>
}