@using Core.DTOs
@model CollectionDetailDTO

@{
    ViewData["Title"] = "Колекція: " + Model.Name;
}

<style>
    .header-section {
        margin-bottom: 30px;
    }

    .back-link {
        color: var(--accent-color);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        opacity: 0.7;
        transition: 0.3s;
        margin-bottom: 15px;
    }

        .back-link:hover {
            opacity: 1;
            transform: translateX(-5px);
        }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
    }

    .set-card {
        background: var(--btn-bg);
        border: 1px solid var(--btn-border);
        border-radius: 15px;
        padding: 25px;
        position: relative;
        cursor: pointer;
        transition: 0.3s;
        display: flex;
        flex-direction: column;
        min-height: 200px;
    }

        .set-card:hover {
            border-color: var(--accent-color);
            transform: translateY(-5px);
        }

    .mastery-container {
        margin: 15px 0;
    }

    .mastery-info {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        margin-bottom: 6px;
        font-weight: 600;
    }

    .mastery-bar-bg {
        width: 100%;
        height: 6px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .mastery-bar-fill {
        height: 100%;
        background: var(--accent-color);
        border-radius: 10px;
        transition: width 0.8s ease;
        box-shadow: 0 0 10px var(--accent-color);
    }

    .dots {
        position: absolute;
        top: 15px;
        right: 15px;
        font-size: 1.5rem;
        opacity: 0.5;
        cursor: pointer;
        padding: 5px;
        z-index: 10;
        line-height: 1;
    }

    .dropdown {
        position: absolute;
        top: 45px;
        right: 15px;
        background: #2C3440;
        border: 1px solid #818375;
        border-radius: 8px;
        display: none;
        flex-direction: column;
        z-index: 100;
        box-shadow: 0 8px 16px rgba(0,0,0,0.5);
        overflow: hidden;
    }

        .dropdown button {
            background: none;
            border: none;
            color: white;
            padding: 12px 20px;
            text-align: left;
            cursor: pointer;
            width: 100%;
            font-size: 0.9rem;
        }

            .dropdown button:hover {
                background-color: #6B8789;
            }
</style>

<div class="content-area">
    <div class="header-section">
        <a asp-action="Index" class="back-link">← Назад до колекцій</a>
        <h2 style="color: var(--accent-color); margin: 0;">@Model.Name</h2>
        <p style="opacity: 0.6; margin: 5px 0 0 0;">@Model.Description</p>
    </div>

    <div class="grid">
        @foreach (var set in Model.Sets)
        {
            var isSetOwner = set.UserName == User.Identity.Name;
            var actionName = (isSetOwner || User.IsInRole("Admin")) ? "Index" : "Sets";
            var controllerName = (isSetOwner || User.IsInRole("Admin")) ? "Details" : "DetailsInMain";

            double masteryPercent = Math.Round(set.OverallProgress * 100);

            <div class="set-card" onclick="handleCardClick(event, '@Url.Action(actionName, controllerName, new { id = set.Id, collectionId = Model.Id })')">

                <div class="dots" onclick="toggleMenu(event)">⋮</div>
                <div class="dropdown">
                    <form asp-action="RemoveSet" method="post" onsubmit="return confirm('Прибрати цей сет із папки?')">
                        <input type="hidden" name="setId" value="@set.Id" />
                        <input type="hidden" name="collectionId" value="@Model.Id" />
                        <button type="submit" style="color: #ff8080;" onclick="event.stopPropagation()">Прибрати з папки</button>
                    </form>
                </div>

                <h3 style="margin: 0 0 10px 0; color: var(--accent-color);">@set.Name</h3>
                <p style="opacity: 0.7; font-size: 0.9rem; margin: 0; flex-grow: 1;">@set.Description</p>

                <div class="mastery-container">
                    <div class="mastery-info">
                        <span style="opacity: 0.5;">Майстерність</span>
                        <span style="color: var(--accent-color);">@masteryPercent%</span>
                    </div>
                    <div class="mastery-bar-bg">
                        <div class="mastery-bar-fill" style="width: @masteryPercent%;"></div>
                    </div>
                </div>

                <div style="font-size: 0.75rem; margin-top: 5px; opacity: 0.5; display: flex; justify-content: space-between;">
                    <span>@set.FlashcardsCount карток</span>
                    <span>@(set.IsPublic ? "🌐 Публічний" : "🔒 Приватний")</span>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function handleCardClick(event, url) {
            if (event.target.closest('.dots') || event.target.closest('.dropdown')) return;
            window.location.href = url;
        }

        function toggleMenu(e) {
            e.stopPropagation();
            const dropdown = e.currentTarget.nextElementSibling;
            document.querySelectorAll('.dropdown').forEach(d => { if (d !== dropdown) d.style.display = 'none'; });
            dropdown.style.display = (dropdown.style.display === 'flex') ? 'none' : 'flex';
        }

        window.onclick = (e) => {
            if (!e.target.matches('.dots')) document.querySelectorAll('.dropdown').forEach(d => d.style.display = 'none');
        }
    </script>
}