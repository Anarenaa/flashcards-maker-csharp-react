@using Core.DTOs
@model IEnumerable<CollectionDTO>

@{
    ViewData["Title"] = "Мої колекції";
}

<style>
    /* --- СІТКА ТА КАРТКИ --- */
    .folder-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
        margin-top: 20px;
    }

    .folder-card {
        background-color: var(--btn-bg);
        border: 1px solid var(--btn-border);
        border-radius: 15px;
        padding: 25px;
        position: relative;
        cursor: pointer;
        transition: 0.3s ease;
        display: flex;
        flex-direction: column;
        min-height: 150px; 
    }

        .folder-card:hover {
            border-color: var(--accent-color);
            background-color: var(--btn-hover);
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
        }

    .folder-icon {
        color: var(--accent-color);
        margin-bottom: 10px;
    }

    /* --- МЕНЮ ТРЬОХ КРАПОК --- */
    .dots {
        position: absolute;
        top: 15px;
        right: 15px;
        font-size: 1.5rem;
        opacity: 0.5;
        cursor: pointer;
        padding: 5px;
        z-index: 10;
        line-height: 1;
    }

        .dots:hover {
            opacity: 1;
            color: var(--accent-color);
        }

    .dropdown {
        position: absolute;
        top: 45px;
        right: 15px;
        background: #2C3440;
        border: 1px solid #818375;
        border-radius: 8px;
        display: none;
        flex-direction: column;
        z-index: 100;
        box-shadow: 0 8px 16px rgba(0,0,0,0.5);
        overflow: hidden;
    }

        .dropdown button {
            background: none;
            border: none;
            color: white;
            padding: 12px 20px;
            text-align: left;
            cursor: pointer;
            width: 100%;
            font-size: 0.9rem;
        }

            .dropdown button:hover {
                background-color: #6B8789;
            }

    /* --- МОДАЛЬНЕ ВІКНО --- */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.85);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 2000;
    }

    .modal {
        background: #1C2531;
        border: 1px solid var(--accent-color);
        padding: 30px;
        border-radius: 15px;
        width: 420px;
        max-width: 90%;
        display: flex;
        flex-direction: column;
        gap: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

        .modal input {
            background: #141B25;
            border: 1px solid #818375;
            color: white;
            padding: 12px;
            border-radius: 8px;
            outline: none;
            font-family: inherit;
            width: 100%;
            box-sizing: border-box;
        }

            .modal input:focus {
                border-color: var(--accent-color);
            }

    /* --- ФУТЕР КАРТКИ --- */
    .folder-footer {
        margin-top: auto;
        padding-top: 15px;
        border-top: 1px solid rgba(240, 255, 255, 0.05);
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .date-info {
        font-size: 0.7rem;
        opacity: 0.4;
        display: flex;
        justify-content: space-between;
    }
    .sets-count-badge {
        background: rgba(240, 255, 255, 0.1);
        color: var(--accent-color);
        padding: 4px 10px;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: bold;
        width: fit-content; 
        margin-bottom: 4px;
    }
</style>

<div class="content-area">
    <h2 style="color: var(--accent-color); margin-bottom: 20px;">Мої колекції</h2>

    <div class="folder-grid">
        @* Картка створення *@
        <div class="folder-card" style="border-style: dashed; text-align: center; justify-content: center;" onclick="openCreateModal()">
            <div style="font-size: 3rem; color: var(--accent-color); line-height: 1;">+</div>
            <div style="margin-top: 10px; font-weight: bold;">Нова колекція</div>
        </div>

        @foreach (var item in Model)
        {
            <div class="folder-card" onclick="handleFolderClick(event, '@Url.Action("Details", "Collections", new { id = item.Id })')">

                @* Кнопка меню ⋮ *@
                <div class="dots" onclick="toggleMenu(event)">⋮</div>
                <div class="dropdown">
                    <form asp-action="Delete" method="post" onsubmit="return confirm('Видалити цю колекцію?')">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" style="color: #ff8080;">Видалити</button>
                    </form>
                </div>
                <div class="folder-icon">
                    <svg width="36" height="36" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
                    </svg>
                </div>
                <h3 style="margin: 0; color: var(--accent-color);">@item.Name</h3>
                <p style="opacity: 0.6; font-size: 0.85rem; flex-grow: 1; margin: 5px 0 0 0;">@item.Description</p>
                @* ФУТЕР З КІЛЬКІСТЮ ТА ДАТАМИ *@
                <div class="folder-footer">
                    @* ПЕРЕНЕСЕНИЙ БЕЙДЖ *@
                    <span class="sets-count-badge">@item.SetsCount @GetSetWord(item.SetsCount)</span>

                    <div class="date-info">
                        <span>Створено:</span>
                        <span>@item.CreatedAt.ToString("dd.MM.yyyy")</span>
                    </div>
                    <div class="date-info">
                        <span>Оновлено:</span>
                        <span style="color: var(--accent-color); opacity: 0.8;">@item.LastUpdatedAt.ToString("HH:mm") сьогодні</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@* Модалка створення *@
<div class="modal-overlay" id="createModal">
    <div class="modal">
        <h2 style="margin: 0; color: var(--accent-color);">Створити нову колекцію</h2>
        <form asp-controller="Collections" asp-action="Create" method="post">
            <div style="display: flex; flex-direction: column; gap: 15px; margin-top: 20px;">
                <input type="text" name="Name" placeholder="Назва папки (напр. ІТ терміни)" required />
                <input type="text" name="Description" placeholder="Опис колекції" />

                <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 10px;">
                    <button type="button" onclick="closeModal()" style="background:none; border:none; color:#818375; cursor:pointer;">Скасувати</button>
                    <button type="submit" class="btn-main" style="background:#6B8789; color:white; border:none; padding:10px 20px; border-radius:8px; font-weight:bold; cursor:pointer;">Зберегти</button>
                </div>
            </div>
        </form>
    </div>
</div>
@functions {
    public string GetSetWord(int count)
    {
        int lastDigit = count % 10;
        int lastTwoDigits = count % 100;
        if (lastTwoDigits >= 11 && lastTwoDigits <= 14) return "сетів";
        if (lastDigit == 1) return "сет";
        if (lastDigit >= 2 && lastDigit <= 4) return "сети";
        return "сетів";
    }
}
@section Scripts {
    <script>
        const modal = document.getElementById('createModal');

        function openCreateModal() {
            modal.style.display = 'flex';
        }
        function closeModal() {
            modal.style.display = 'none';
        }

        function handleFolderClick(event, url) {
            if (event.target.closest('.dots') || event.target.closest('.dropdown')) {
                return;
            }
            window.location.href = url;
        }
        function toggleMenu(e) {
            e.stopPropagation();
            const btn = e.currentTarget;
            const dropdown = btn.nextElementSibling;

            document.querySelectorAll('.dropdown').forEach(d => {
                if (d !== dropdown) d.style.display = 'none';
            });

            dropdown.style.display = (dropdown.style.display === 'flex') ? 'none' : 'flex';
        }
        window.onclick = (e) => {
            if (!e.target.matches('.dots')) {
                document.querySelectorAll('.dropdown').forEach(d => d.style.display = 'none');
            }
            if (e.target === modal) {
                closeModal();
            }
        }
    </script>
}