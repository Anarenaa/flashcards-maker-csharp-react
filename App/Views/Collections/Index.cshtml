<!-- Поле Питання -->
<div class="input-group">
    <label style="font-size: 0.8rem; opacity: 0.6; color: var(--accent-color); display: block; margin-bottom: 5px;">Питання (Термін)</label>
    <input type="text" id="newCardTerm" placeholder="Наприклад: сніговик" oninput="toggleHintActive()"
           style="background: #141B25; border: 1px solid #818375; color: white; padding: 12px; border-radius: 8px; width: 100%; box-sizing: border-box; outline: none;" />
</div>

<!-- Поле Відповідь з вбудованою кнопкою-лампочкою -->
<div class="input-group" style="margin-top: 15px;">
    <label style="font-size: 0.8rem; opacity: 0.6; color: var(--accent-color); display: block; margin-bottom: 5px;">Відповідь (Значення)</label>
    <div style="position: relative; width: 100%;">
        <textarea id="newCardDef" rows="4" placeholder="Ваша відповідь..."
                  style="padding: 12px; padding-right: 45px; width: 100%; border-radius: 8px; background: #141B25; color: white; border: 1px solid #818375; box-sizing: border-box; outline: none; resize: none; font-family: inherit;"></textarea>

        <!-- Кнопка лампочки (Підказка) -->
        <button type="button" id="hintBtn" onclick="getHintFromAI()" disabled
                style="position: absolute; right: 10px; bottom: 10px; width: 32px; height: 32px; border-radius: 50%; border: none; background: #f4a261; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.3s; padding: 0; z-index: 5;">
            <span id="hintIcon">💡</span>
            <div id="hintLoader" class="spinner-mini" style="display: none;"></div>
        </button>
    </div>
    <!-- Повідомлення про помилку -->
    <div id="hintError" style="display: none; color: #ff8080; font-size: 0.7rem; margin-top: 5px;">
        ⚠️ Не вдалося отримати підказку. Перевірте з'єднання.
    </div>
</div>

<!-- Стилі для спіннера та стану кнопки -->
<style>
    #hintBtn:disabled {
        background: #2c3440 !important;
        opacity: 0.4;
        cursor: not-allowed;
    }

    .spinner-mini {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(0, 0, 0, 0.1);
        border-top: 2px solid #000;
        border-radius: 50%;
        animation: spin-hint 0.8s linear infinite;
    }

  
        transform: rotate(360deg);
    }

    }
</style>

<script>
    // 1. Кнопка активна тільки якщо поле Питання не порожнє
    function toggleHintActive() {
        const termInput = document.getElementById('newCardTerm');
        const btn = document.getElementById('hintBtn');
        const term = termInput.value.trim();

        btn.disabled = (term.length === 0);
    }

    // 2. Логіка отримання підказки через ШІ (HintService)
    async function getHintFromAI() {
        const term = document.getElementById('newCardTerm').value.trim();
        const btn = document.getElementById('hintBtn');
        const loader = document.getElementById('hintLoader');
        const icon = document.getElementById('hintIcon');
        const error = document.getElementById('hintError');
        const defArea = document.getElementById('newCardDef');

        if (!term) return;

        // СТАН ПРОГРУЗКИ (Loading)
        btn.disabled = true;
        icon.style.display = 'none';
        loader.style.display = 'block';
        error.style.display = 'none';

        try {
            // Виклик API (передаємоsetId, щоб сервіс знав тип сету та мови)
            const response = await fetch(`/api/SetsApi/GetHint?term=${encodeURIComponent(term)}&setId=@Model.Id`);

            if (!response.ok) throw new Error("Hint service unavailable");

            const hint = await response.text();

            // Вставляємо результат у поле Відповідь
            defArea.value = hint;

        } catch (e) {
            // СТАН ПОМИЛКИ
            error.style.display = 'block';
            console.error("Hint error:", e);
        } finally {
            // ПОВЕРНЕННЯ В НОРМУ
            btn.disabled = false;
            icon.style.display = 'block';
            loader.style.display = 'none';
            toggleHintActive();
        }
    }
</script>