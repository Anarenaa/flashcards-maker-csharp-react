@using Core.DTOs
@using Core.DTOs.Practice 
@model PrivateUserDTO

@{
    ViewData["Title"] = "Мій профіль";
    var progress = ViewBag.UserProgress as UserProgressDTO;
}

<style>
    .profile-container {
        max-width: 1000px;
        margin: 0 auto;
        position: relative;
    }

    .profile-header {
        display: flex;
        align-items: center;
        background: var(--btn-bg);
        border: 1px solid var(--btn-border);
        padding: 40px;
        border-radius: 20px;
        margin-bottom: 40px;
        position: relative;
        gap: 40px;
    }

    .avatar-wrapper {
        position: relative;
        cursor: pointer;
        transition: 0.3s;
    }

    .profile-avatar {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 4px solid var(--accent-color);
    }

        .profile-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .avatar-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: 0.3s;
        color: white;
        font-size: 0.8rem;
        font-weight: bold;
    }

    .avatar-wrapper:hover .avatar-overlay {
        opacity: 1;
    }

    .profile-main-info {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .info-row {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .label-small {
        font-size: 0.9rem;
        opacity: 0.6;
        min-width: 90px;
    }

    .info-value-clickable {
        font-size: 1.5rem;
        font-weight: bold;
        color: #fff;
        cursor: pointer;
        border-bottom: 1px dashed transparent;
        transition: 0.2s;
    }

        .info-value-clickable:hover {
            border-bottom-color: var(--accent-color);
            color: var(--accent-color);
        }

    .inline-input {
        background: transparent;
        border: none;
        border-bottom: 2px solid var(--accent-color);
        color: white;
        font-size: 1.5rem;
        font-weight: bold;
        width: 250px;
        outline: none;
        display: none;
    }

    .floating-save-btn {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: var(--accent-color);
        color: #141B25;
        padding: 15px 30px;
        border-radius: 30px;
        border: none;
        font-weight: bold;
        cursor: pointer;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        display: none;
        z-index: 100;
        transition: 0.3s ease;
    }

        .floating-save-btn:hover {
            transform: scale(1.05);
            background: white;
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    .stat-card {
        background: var(--btn-bg);
        border: 1px solid var(--btn-border);
        padding: 30px 20px;
        border-radius: 15px;
        text-align: center;
        transition: 0.3s;
    }

        .stat-card:hover {
            border-color: var(--accent-color);
            transform: translateY(-5px);
        }

    .stat-number {
        font-size: 1.8rem;
        font-weight: bold;
        color: var(--accent-color);
    }

    @@media (max-width: 850px) {
        .stats-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="content-area">
    <div class="profile-container">

        @if (TempData["Error"] != null)
        {
            <div style="background: rgba(255,100,100,0.1); border: 1px solid #ff8080; color: #ff8080; padding: 15px; border-radius: 10px; margin-bottom: 20px;">
                @TempData["Error"]
            </div>
        }

        <form id="profileForm" asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="profile-header">
              
                <div class="avatar-wrapper" onclick="document.getElementById('avatarFileInput').click()">
                    <div class="profile-avatar">
                        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                        {
                            <img src="@Model.AvatarUrl" id="avatarPreview" alt="Avatar" />
                        }
                        else
                        {
                            <div id="avatarPlaceholder" style="font-size: 4rem; color: #333;">👤</div>
                        }
                    </div>
                    <div class="avatar-overlay">ЗМІНИТИ</div>
                    <input type="file" id="avatarFileInput" name="avatarFile" hidden accept="image/*" onchange="handleImageChange(this)" />
                </div>

                <div class="profile-main-info">
                    <div class="info-row">
                        <span class="label-small">Нікнейм:</span>
                        <span id="userNameText" class="info-value-clickable" onclick="enableNameEdit()">@Model.UserName</span>
                        <input type="text" id="userNameInput" name="userName" class="inline-input" value="@Model.UserName" oninput="toggleSaveBtn(true)" />
                    </div>
                    <div class="info-row">
                        <span class="label-small">Email:</span>
                        <span class="info-value" style="font-size: 1.1rem; opacity: 0.8;">@Model.Email</span>
                    </div>
                    <div class="info-row">
                        <span class="label-small">Реєстрація:</span>
                        <span class="info-value" style="font-size: 1rem; opacity: 0.6;">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                    </div>
                </div>
            </div>

            <button type="submit" id="saveChangesBtn" class="floating-save-btn">Зберегти зміни</button>
        </form>

        <div class="stats-grid">
            <div class="stat-card">
                <span class="label-small">Кількість ваших сетів</span>
                <div class="stat-number">@Model.SetsCount</div>
            </div>
            <div class="stat-card">
                <span class="label-small">Кількість ваших колекцій</span>
                <div class="stat-number">@Model.CollectionsCount</div>
            </div>
            <div class="stat-card">
                <span class="label-small">Кількість ваших карток</span>
                <div class="stat-number">@Model.FlashcardsCount</div>
            </div>

            <div class="stat-card">
                <span class="label-small">Кількість пройдених тестів</span>
                <div class="stat-number">@(progress?.TotalPracticeSessions ?? 0)</div>
            </div>

            <div class="stat-card" style="grid-column: span 2;">
                <span class="label-small">Вивчено карток</span>
                <div class="stat-number">@(progress?.MasteredCards ?? 0)</div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        const nameText = document.getElementById('userNameText');
        const nameInput = document.getElementById('userNameInput');
        const saveBtn = document.getElementById('saveChangesBtn');

        function enableNameEdit() {
            nameText.style.display = 'none';
            nameInput.style.display = 'inline-block';
            nameInput.focus();
        }

        function handleImageChange(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById('avatarPreview');
                    const placeholder = document.getElementById('avatarPlaceholder');

                    if (preview) {
                        preview.src = e.target.result;
                    } else if (placeholder) {
                        placeholder.innerHTML = `<img src="${e.target.result}" style="width:100%;height:100%;object-fit:cover;">`;
                    }
                };
                reader.readAsDataURL(input.files[0]);
                toggleSaveBtn(true);
            }
        }

        function toggleSaveBtn(show) {
            if (show) saveBtn.style.display = 'block';
        }

        document.querySelectorAll('.stat-card').forEach((card, index) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            setTimeout(() => {
                card.style.transition = '0.5s ease';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, index * 100);
        });
    </script>
}