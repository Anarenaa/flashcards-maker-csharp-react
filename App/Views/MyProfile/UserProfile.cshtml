@using Core.DTOs
@model PublicUserDTO

@{
    ViewData["Title"] = "Профіль автора " + Model.UserName;
    // Отримуємо статус приватності з контролера
    bool isPrivate = ViewBag.IsPrivate ?? false;
}

<style>
    .profile-header {
        display: flex;
        align-items: center;
        background: var(--btn-bg);
        border: 1px solid var(--btn-border);
        padding: 40px;
        border-radius: 20px;
        gap: 40px;
        margin-bottom: 30px;
    }

    .profile-avatar {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: white;
        overflow: hidden;
        border: 4px solid var(--accent-color);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .profile-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .info-label {
        font-size: 0.9rem;
        opacity: 0.6;
        min-width: 100px;
        display: inline-block;
    }

    .info-text {
        font-size: 1.2rem;
        font-weight: bold;
        color: #fff;
    }

    /* СІТКА СТАТИСТИКИ */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: var(--btn-bg);
        border: 1px solid var(--btn-border);
        padding: 30px 20px;
        border-radius: 15px;
        text-align: center;
        transition: 0.3s;
    }

        .stat-card:hover {
            border-color: var(--accent-color);
            transform: translateY(-5px);
        }

    .stat-title {
        display: block;
        font-size: 0.85rem;
        opacity: 0.6;
        margin-bottom: 10px;
    }

    .stat-number {
        font-size: 1.8rem;
        font-weight: bold;
        color: var(--accent-color);
    }

    /* Стиль для приватного профілю */
    .private-lock-container {
        text-align: center;
        padding: 80px 20px;
        background: var(--btn-bg);
        border: 1px dashed var(--btn-border);
        border-radius: 20px;
        margin-top: 20px;
    }

    .lock-icon {
        font-size: 4rem;
        margin-bottom: 20px;
        display: block;
        opacity: 0.4;
    }
</style>

<div class="content-area">
    <a asp-controller="Main" asp-action="Index" class="back-link" style="color:var(--accent-color); text-decoration:none; opacity:0.7; font-size:0.9rem;">← Назад до пошуку</a>

    <div class="profile-header" style="margin-top: 20px;">
        <div class="profile-avatar">
            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
            {
                <img src="@Model.AvatarUrl" alt="Avatar" />
            }
            else
            {
                <span style="font-size: 4rem; color: #333;">👤</span>
            }
        </div>

        <div style="flex-grow: 1; display: flex; flex-direction: column; gap: 15px;">
            <div>
                <span class="info-label">нік нейм:</span>
                <span class="info-text">@Model.UserName</span>
            </div>
            <div>
                <span class="info-label">Email:</span>
                <span class="info-text" style="font-weight: 400; opacity: 0.9;">@Model.Email</span>
            </div>
            <div>
                <span class="info-label">реєстрація:</span>
                <span class="info-text" style="font-weight: 400; opacity: 0.7;">@Model.CreatedAt.ToString("dd.MM.yyyy")</span>
            </div>
        </div>
    </div>

    @if (isPrivate)
    {
        @* ВІДОБРАЖЕННЯ ДЛЯ ПРИВАТНОГО ПРОФІЛЮ *@
        <div class="private-lock-container">
            <span class="lock-icon">🔒</span>
            <h2 style="margin: 0; opacity: 0.8; color: var(--accent-color);">Цей профіль приватний</h2>
            <p style="opacity: 0.6; margin-top: 10px;">Користувач приховав свою статистику та навчальні сети.</p>
        </div>
    }
    else
    {
        @* ВІДОБРАЖЕННЯ ДЛЯ ПУБЛІЧНОГО ПРОФІЛЮ *@
        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-title">кількість сетів автора</span>
                <div class="stat-number">@Model.SetsCount</div>
            </div>

            <div class="stat-card">
                <span class="stat-title">кількість колекцій</span>
                <div class="stat-number">@(Model.CollectionsCount ?? 0)</div>
            </div>

            <div class="stat-card">
                <span class="stat-title">кількість карток</span>
                <div class="stat-number">@Model.FlashcardsCount</div>
            </div>
        </div>

        <h3 style="color: var(--accent-color); margin-bottom: 20px;">Відкриті сети цього користувача:</h3>
        <div class="grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
            @if (Model.Sets != null && Model.Sets.Any())
            {
                foreach (var set in Model.Sets)
                {
                    <div class="set-card" onclick="location.href='@Url.Action("Sets", "DetailsInMain", new { id = set.Id })'"
                         style="background: var(--btn-bg); border: 1px solid var(--btn-border); border-radius: 12px; padding: 20px; cursor: pointer; transition: 0.3s;">
                        <h4 style="margin: 0; color: var(--accent-color);">@set.Name</h4>
                        <p style="opacity: 0.7; font-size: 0.8rem; margin: 10px 0;">@set.Description</p>
                        <div style="font-size: 0.7rem; opacity: 0.5;">@set.FlashcardsCount карток</div>
                    </div>
                }
            }
            else
            {
                <p style="opacity: 0.5; grid-column: span 3; text-align: center;">У цього автора поки немає публічних сетів.</p>
            }
        </div>
    }
</div>